#define NET_BUFF_DESC_SIZE  (2*@biw)

/@ extern predicate valid_virt @/
/@ extern predicate valid_net_queue @/
/@ extern field net_tail: Int @/
/@ extern field net_head: Int @/
/@ extern field n_enqueue_dequeue: Int @/
/@ extern field net_signal: Int @/
/@ extern field rx_free: Ref @/
/@ extern field rx_active: Ref @/
/@ extern field tx_free: Ref @/
/@ extern field tx_active: Ref @/

#define unchanged(x) (x == old(x))
#define unfolding_queue(x) unfolding valid_virt() in unfolding valid_net_queue(gv.x, QUEUE_CAPACITY)
#define queue_unchanged(x) (unchanged(unfolding_queue(x) in gv.x.net_tail) && unchanged(unfolding_queue(x) in gv.x.net_head) && unchanged(unfolding_queue(x) in gv.x.n_enqueue_dequeue) && unchanged(unfolding_queue(x) in gv.x.net_signal))
#define queues_unchanged() (queue_unchanged(rx_free) && queue_unchanged(rx_active) && queue_unchanged(tx_free) && queue_unchanged(tx_active))

inline fun net_queue_empty(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/
  /@ ensures queues_unchanged() @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == unfolding_queue(rx_free) in (gv.rx_free.net_tail == gv.rx_free.net_head) ? 1 : 0 @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == unfolding_queue(rx_active) in (gv.rx_active.net_tail == gv.rx_active.net_head) ? 1 : 0 @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == unfolding_queue(tx_free) in (gv.tx_free.net_tail == gv.tx_free.net_head) ? 1 : 0 @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == unfolding_queue(tx_active) in (gv.tx_active.net_tail == gv.tx_active.net_head) ? 1 : 0 @/

  /@ unfold valid_virt() @/

  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  /@ fold valid_virt() @/

  return tail == head;
}

inline fun net_queue_full(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires bounded16(capacity) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/
  /@ ensures unchanged(unfolding valid_virt() in unfolding valid_net_queue(gv.rx_free, QUEUE_CAPACITY) in gv.rx_free.net_tail) @/
  /@ ensures queues_unchanged() @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == ((unfolding_queue(rx_free) in (gv.rx_free.net_tail - gv.rx_free.net_head) % (MAX_INT16 + 1)) == capacity ? 1 : 0) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == ((unfolding_queue(rx_active) in (gv.rx_active.net_tail - gv.rx_active.net_head) % (MAX_INT16 + 1)) == capacity ? 1 : 0) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == ((unfolding_queue(tx_free) in (gv.tx_free.net_tail - gv.tx_free.net_head) % (MAX_INT16 + 1)) == capacity ? 1 : 0) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == ((unfolding_queue(tx_active) in (gv.tx_active.net_tail - gv.tx_active.net_head) % (MAX_INT16 + 1)) == capacity ? 1 : 0) @/

  /@ unfold valid_virt() @/
  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;
  /@ unfold valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
  /@ fold valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
  /@ fold valid_virt() @/

  if (tail >= head) {
    return (tail - head) == capacity;
  }
  return (head - tail) == MAX_INT16 + 1 - capacity;
}

inline fun net_enqueue(1 queue_ptr, 1 io_addr, 1 len, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/

  /@ unfold valid_virt() @/

  /* capacity must be a power of 2 */
  var tail = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;

  var mod_tail = tail & (capacity - 1);
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_tail * NET_BUFF_DESC_SIZE;
  !stw buff_addr + QUEUE_IO_OFF, io_addr;
  !stw buff_addr + QUEUE_LEN_OFF, len;

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  tail = (tail + 1) & MAX_INT16;
  !st16 queue_ptr + TAIL_OFFSET, tail;

  /@ fold valid_virt() @/

  return 0;
}

inline fun {1,1} net_dequeue(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/

  /@ unfold valid_virt() @/

  /* capacity must be a power of 2 */
  var head = 0;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  var mod_head = head & (capacity - 1);
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_head * NET_BUFF_DESC_SIZE;
  var io_addr = 0;
  var len = 0;
  !ldw io_addr, buff_addr + QUEUE_IO_OFF;
  !ldw len, buff_addr + QUEUE_LEN_OFF;

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  head = (head + 1) & MAX_INT16;
  !st16 queue_ptr + HEAD_OFFSET, head;

  /@ fold valid_virt() @/

  return <io_addr, len>;
}

inline fun net_request_signal(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/

  /@ unfold valid_virt() @/
  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 0;
  /@ fold valid_virt() @/

  return 0;
}

inline fun net_cancel_signal(1 queue_ptr)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/

  /@ unfold valid_virt() @/
  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 1;
  /@ fold valid_virt() @/

  return 0;
}

inline fun net_require_signal(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/

  /@ unfold valid_virt() @/
  var signalled = 0;
  !ld32 signalled, queue_ptr + CONSUMER_SIGNALLED_OFFSET;
  /@ fold valid_virt() @/
  return !signalled;
}
