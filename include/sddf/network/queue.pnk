#define NET_BUFF_DESC_SIZE  (2*@biw)

/@ extern predicate valid_virt @/
/@ extern predicate valid_net_queue @/
/@ extern field net_tail: Int @/
/@ extern field net_head: Int @/
/@ extern field net_signal: Bool @/
/@ extern field rx_free: Ref @/
/@ extern field rx_active: Ref @/
/@ extern field tx_free: Ref @/
/@ extern field tx_active: Ref @/

#define unchanged(x) (x == old(x))
#define unfolding_queue(x) unfolding valid_net_queue(gv.x, QUEUE_CAPACITY)
#define queue_unchanged(x) (unchanged(unfolding_queue(x) in gv.x.net_tail) && unchanged(unfolding_queue(x) in gv.x.net_head)  && unchanged(unfolding_queue(x) in gv.x.net_signal))
#define queues_unchanged() (queue_unchanged(rx_free) && queue_unchanged(rx_active) && queue_unchanged(tx_free) && queue_unchanged(tx_active))

inline fun net_queue_empty(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free) && valid_net_queue(gv.rx_free, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active) && valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free) && valid_net_queue(gv.rx_free, QUEUE_CAPACITY) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) && queue_unchanged(rx_active) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) && queue_unchanged(tx_free) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active) && valid_net_queue(gv.tx_active, QUEUE_CAPACITY) && queue_unchanged(tx_active) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == unfolding_queue(rx_free) in (gv.rx_free.net_tail == gv.rx_free.net_head) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == unfolding_queue(rx_active) in (gv.rx_active.net_tail == gv.rx_active.net_head) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == unfolding_queue(tx_free) in (gv.tx_free.net_tail == gv.tx_free.net_head) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == unfolding_queue(tx_active) in (gv.tx_active.net_tail == gv.tx_active.net_head) @/

  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;
  return tail == head;
}

inline fun net_queue_full(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires bounded16(capacity) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free) && valid_net_queue(gv.rx_free, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active) && valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free) && valid_net_queue(gv.rx_free, QUEUE_CAPACITY) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) && queue_unchanged(rx_active) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) && queue_unchanged(tx_free) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active) && valid_net_queue(gv.tx_active, QUEUE_CAPACITY) && queue_unchanged(tx_active) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == ((unfolding_queue(rx_free) in (gv.rx_free.net_tail - gv.rx_free.net_head) % (MAX_INT16 + 1)) == capacity) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == ((unfolding_queue(rx_active) in (gv.rx_active.net_tail - gv.rx_active.net_head) % (MAX_INT16 + 1)) == capacity) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == ((unfolding_queue(tx_free) in (gv.tx_free.net_tail - gv.tx_free.net_head) % (MAX_INT16 + 1)) == capacity) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == ((unfolding_queue(tx_active) in (gv.tx_active.net_tail - gv.tx_active.net_head) % (MAX_INT16 + 1)) == capacity) @/

  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  if (tail >= head) {
    return (tail - head) == capacity;
  }
  return (head - tail) == MAX_INT16 + 1 - capacity;
}

inline fun net_enqueue(1 queue_ptr, 1 io_addr, 1 len, 1 capacity)
{
  /@ requires bounded32(io_addr) @/
  /@ requires bounded16(len) @/
  /@ requires queue_ptr == TX_FREE_BASE || queue_ptr == RX_ACTIVE_BASE @/
  /@ requires capacity == 256 @/
  /@ requires bounded64(queue_ptr + BUFFERS_OFFSET + capacity * NET_BUFF_DESC_SIZE) @/ // field access
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> unfolding_queue(rx_active) in (gv.rx_active.net_tail - gv.rx_active.net_head) % (MAX_INT16 + 1) != capacity @/
  /@ requires queue_ptr == TX_FREE_BASE ==> unfolding_queue(tx_free) in (gv.tx_free.net_tail - gv.tx_free.net_head) % (MAX_INT16 + 1) != capacity @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active) && valid_net_queue(gv.rx_active, QUEUE_CAPACITY) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free) && valid_net_queue(gv.tx_free, QUEUE_CAPACITY) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> unchanged(unfolding_queue(rx_active) in gv.rx_active.net_head) && unchanged(unfolding_queue(rx_active) in gv.rx_active.net_signal) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> unchanged(unfolding_queue(tx_free) in gv.tx_free.net_head) && unchanged(unfolding_queue(tx_free) in gv.tx_free.net_signal) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> (unfolding_queue(rx_active) in gv.rx_active.net_tail) == ((old(unfolding_queue(rx_active) in gv.rx_active.net_tail) + 1) % (MAX_INT16 + 1)) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> (unfolding_queue(tx_free) in gv.tx_free.net_tail) == ((old(unfolding_queue(tx_free) in gv.tx_free.net_tail) + 1) % (MAX_INT16 + 1)) @/

  /* capacity must be a power of 2 */
  var tail = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;

  var mod_tail = tail & (capacity - 1);
  // TODO: find a way to model the below?
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_tail * NET_BUFF_DESC_SIZE;
  !st32 buff_addr + QUEUE_IO_OFF, io_addr;
  !st16 buff_addr + QUEUE_LEN_OFF, len;

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  tail = wrap_int16(tail + 1);
  !st16 queue_ptr + TAIL_OFFSET, tail;

  return 0;
}

inline fun {1,1} net_dequeue(1 queue_ptr, 1 capacity)
{
  /@ requires queue_ptr == TX_ACTIVE_BASE || queue_ptr == RX_FREE_BASE @/
  /@ requires capacity == 256 @/
  /@ requires bounded64(queue_ptr + BUFFERS_OFFSET + capacity * NET_BUFF_DESC_SIZE) @/ // field access
  /@ requires valid_virt() @/
  // non-empty queue
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> unfolding_queue(tx_active) in gv.tx_active.net_tail != gv.tx_active.net_head @/
  /@ requires queue_ptr == RX_FREE_BASE ==> unfolding_queue(rx_free) in gv.rx_free.net_tail != gv.rx_free.net_head @/
  /@ ensures bounded32(retval.0) @/
  /@ ensures bounded16(retval.1) @/
  /@ ensures valid_virt() @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> unchanged(unfolding_queue(tx_active) in gv.tx_active.net_tail) && unchanged(unfolding_queue(tx_active) in gv.tx_active.net_signal) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> unchanged(unfolding_queue(rx_free) in gv.rx_free.net_tail) && unchanged(unfolding_queue(rx_free) in gv.rx_free.net_signal) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> queue_unchanged(rx_free) && queue_unchanged(rx_active) && queue_unchanged(tx_free) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> queue_unchanged(rx_active) && queue_unchanged(tx_free) && queue_unchanged(tx_active) @/

  /@ unfold valid_virt() @/

  /* capacity must be a power of 2 */
  var head = 0;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  var mod_head = head & (capacity - 1);
  // TODO: find a way to model the below?
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_head * NET_BUFF_DESC_SIZE;
  var io_addr = 0;
  var len = 0;
  !ld32 io_addr, buff_addr + QUEUE_IO_OFF;
  !ld16 len, buff_addr + QUEUE_LEN_OFF;

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  head = wrap_int16(head + 1);
  /* head == head % (MAX_INT16 + 1) */
  !st16 queue_ptr + HEAD_OFFSET, head;

  /@ fold valid_virt() @/

  return <io_addr, len>;
}

inline fun net_request_signal(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> unfolding_queue(tx_free) in gv.tx_free.net_signal == false @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> unfolding_queue(tx_active) in gv.tx_active.net_signal == false @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> unfolding_queue(rx_free) in gv.rx_free.net_signal == false @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> unfolding_queue(rx_active) in gv.rx_active.net_signal == false @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> unchanged(unfolding_queue(tx_free) in gv.tx_free.net_head) && unchanged(unfolding_queue(tx_free) in gv.tx_free.net_tail) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> unchanged(unfolding_queue(tx_active) in gv.tx_active.net_head) && unchanged(unfolding_queue(tx_active) in gv.tx_active.net_tail) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> unchanged(unfolding_queue(rx_active) in gv.rx_active.net_head) && unchanged(unfolding_queue(rx_active) in gv.rx_active.net_tail) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> unchanged(unfolding_queue(rx_free) in gv.rx_free.net_head) && unchanged(unfolding_queue(rx_free) in gv.rx_free.net_tail) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> queue_unchanged(tx_active) && queue_unchanged(rx_free) && queue_unchanged(rx_active) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> queue_unchanged(tx_free) && queue_unchanged(rx_active) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> queue_unchanged(tx_free) && queue_unchanged(tx_active) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> queue_unchanged(tx_active) && queue_unchanged(tx_free) && queue_unchanged(rx_active) @/

  /@ unfold valid_virt() @/
  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 0;
  /@ fold valid_virt() @/

  return 0;
}

inline fun net_cancel_signal(1 queue_ptr)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> unfolding_queue(tx_free) in gv.tx_free.net_signal == true @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> unfolding_queue(tx_active) in gv.tx_active.net_signal == true @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> unfolding_queue(rx_free) in gv.rx_free.net_signal == true @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> unfolding_queue(rx_active) in gv.rx_active.net_signal == true @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> unchanged(unfolding_queue(tx_free) in gv.tx_free.net_head) && unchanged(unfolding_queue(tx_free) in gv.tx_free.net_tail) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> unchanged(unfolding_queue(tx_active) in gv.tx_active.net_head) && unchanged(unfolding_queue(tx_active) in gv.tx_active.net_tail) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> unchanged(unfolding_queue(rx_active) in gv.rx_active.net_head) && unchanged(unfolding_queue(rx_active) in gv.rx_active.net_tail) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> unchanged(unfolding_queue(rx_free) in gv.rx_free.net_head) && unchanged(unfolding_queue(rx_free) in gv.rx_free.net_tail) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> queue_unchanged(tx_active) && queue_unchanged(rx_free) && queue_unchanged(rx_active) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> queue_unchanged(tx_free) && queue_unchanged(rx_active) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> queue_unchanged(tx_free) && queue_unchanged(tx_active) && queue_unchanged(rx_free) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> queue_unchanged(tx_active) && queue_unchanged(tx_free) && queue_unchanged(rx_active) @/

  /@ unfold valid_virt() @/
  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 1;
  /@ fold valid_virt() @/

  return 0;
}

inline fun net_require_signal(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires valid_virt() @/
  /@ ensures valid_virt() @/
  /@ ensures queues_unchanged() @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == unfolding_queue(rx_free) in (gv.rx_free.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == unfolding_queue(rx_active) in (gv.rx_active.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == unfolding_queue(tx_active) in (gv.tx_active.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == unfolding_queue(tx_free) in (gv.tx_free.net_signal ? 0 : 1) @/

  /@ unfold valid_virt() @/
  var signalled = 0;
  !ld32 signalled, queue_ptr + CONSUMER_SIGNALLED_OFFSET;
  /@ fold valid_virt() @/
  return !signalled;
}
