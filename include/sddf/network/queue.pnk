/@ extern predicate valid_virt @/
/@ extern predicate valid_net_queue @/
/@ extern field net_tail: Int @/
/@ extern field net_head: Int @/
/@ extern field net_signal: Bool @/
/@ extern field rx_free: Ref @/
/@ extern field rx_active: Ref @/
/@ extern field tx_free: Ref @/
/@ extern field tx_active: Ref @/

#define unchanged(x) (x == old(x))
#define unfolding_queue(x) unfolding valid_net_queue(gv.x, QUEUE_CAPACITY)
#define queue_unchanged(x) (unchanged(unfolding_queue(x) in gv.x.net_tail) && unchanged(unfolding_queue(x) in gv.x.net_head) && unchanged(unfolding_queue(x) in gv.x.net_signal))
#define queues_unchanged() (queue_unchanged(rx_free) && queue_unchanged(rx_active) && queue_unchanged(tx_free) && queue_unchanged(tx_active))

inline fun net_queue_empty(1 queue_ptr)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_tail, 1/2) && acc(gv.rx_free.net_head, 1/2) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail, 1/2) && acc(gv.rx_active.net_head, 1/2) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail, 1/2) && acc(gv.tx_free.net_head, 1/2) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_tail, 1/2) && acc(gv.tx_active.net_head, 1/2) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> 0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> 0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 @/
  /@ requires queue_ptr == TX_FREE_BASE ==> 0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> 0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_tail, 1/2) && acc(gv.rx_free.net_head, 1/2) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail, 1/2) && acc(gv.rx_active.net_head, 1/2) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail, 1/2) && acc(gv.tx_free.net_head, 1/2) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_tail, 1/2) && acc(gv.tx_active.net_head, 1/2) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == (gv.rx_free.net_tail == gv.rx_free.net_head) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == (gv.rx_active.net_tail == gv.rx_active.net_head) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == (gv.tx_free.net_tail == gv.tx_free.net_head) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == (gv.tx_active.net_tail == gv.tx_active.net_head) @/

  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;
  return tail == head;
}

inline fun net_queue_full(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires bounded16(capacity) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_tail, 1/2) && acc(gv.rx_free.net_head, 1/2) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail, 1/2) && acc(gv.rx_active.net_head, 1/2) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail, 1/2) && acc(gv.tx_free.net_head, 1/2) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_tail, 1/2) && acc(gv.tx_active.net_head, 1/2) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> 0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> 0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 @/
  /@ requires queue_ptr == TX_FREE_BASE ==> 0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> 0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_tail, 1/2) && acc(gv.rx_free.net_head, 1/2) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail, 1/2) && acc(gv.rx_active.net_head, 1/2) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail, 1/2) && acc(gv.tx_free.net_head, 1/2) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_tail, 1/2) && acc(gv.tx_active.net_head, 1/2) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == (gv.rx_free.net_tail - gv.rx_free.net_head == capacity) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == (gv.rx_active.net_tail - gv.rx_active.net_head == capacity) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == (gv.tx_free.net_tail - gv.tx_free.net_head == capacity) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == (gv.tx_active.net_tail - gv.tx_active.net_head == capacity) @/

  var tail = 0;
  var head = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  if (tail >= head) {
    return (tail - head) == capacity;
  }
  return (head - tail) == MAX_INT16 + 1 - capacity;
}

inline fun mod_capacity(1 x, 1 capacity)
{
  /@ requires capacity == QUEUE_CAPACITY @/
  /@ ensures retval == x % capacity @/
  /@ ensures retval < capacity @/
  return x & (capacity - 1);
}

inline fun net_enqueue(1 queue_ptr, 1 io_addr, 1 len, 1 capacity)
{
  /@ requires bounded32(io_addr) @/
  /@ requires bounded16(len) @/
  /@ requires capacity == QUEUE_CAPACITY @/
  /@ requires queue_ptr == TX_FREE_BASE || queue_ptr == RX_ACTIVE_BASE @/
  /@ requires bounded64(queue_ptr + BUFFERS_OFFSET + capacity * NDESC_LEN) @/ // array access
  /@ requires queue_ptr == RX_ACTIVE_BASE ==>
       acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail) && acc(gv.rx_active.net_head, 1/2) &&
       acc(gv.rx_active.net_descr, 1/2) && acc(gv.rx_active.net_added) &&
       acc(slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_addr) &&
       acc(slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_len) @/
  /@ requires queue_ptr == TX_FREE_BASE ==>
       acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail) && acc(gv.tx_free.net_head, 1/2) &&
       acc(gv.tx_free.net_descr, 1/2) && acc(gv.tx_free.net_added) &&
       acc(slotq(gv.tx_free.net_descr, gv.tx_free.net_tail).ndescr_addr) &&
       acc(slotq(gv.tx_free.net_descr, gv.tx_free.net_tail).ndescr_len) @/
  // non-full queue
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> gv.rx_active.net_tail - gv.rx_active.net_head != capacity @/
  /@ requires queue_ptr == TX_FREE_BASE ==> gv.tx_free.net_tail - gv.tx_free.net_head != capacity @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==>
       acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_tail) && acc(gv.rx_active.net_head, 1/2) &&
       acc(gv.rx_active.net_descr, 1/2) && acc(gv.rx_active.net_added) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==>
       acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_tail) && acc(gv.tx_free.net_head, 1/2) &&
       acc(gv.tx_free.net_descr, 1/2) && acc(gv.tx_free.net_added) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> gv.rx_active.net_tail == old(gv.rx_active.net_tail) + 1 @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> gv.tx_free.net_tail == old(gv.tx_free.net_tail) + 1 @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> union_elem_seq(gv.rx_active.net_added, old(gv.rx_active.net_added), element2_seq(io_addr, len)) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> union_elem_seq(gv.tx_free.net_added, old(gv.tx_free.net_added), element2_seq(io_addr, len)) @/

  /* capacity must be a power of 2 */
  var tail = 0;
  !ld16 tail, queue_ptr + TAIL_OFFSET;

  var mod_tail = mod_capacity(tail, capacity);
  /@ assert queue_ptr == RX_ACTIVE_BASE ==> gv.rx_active.net_tail % QUEUE_CAPACITY == mod_tail @/
  /@ assert queue_ptr == TX_FREE_BASE ==> gv.tx_free.net_tail % QUEUE_CAPACITY == mod_tail @/
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_tail * NDESC_LEN;
  /@ assert queue_ptr == RX_ACTIVE_BASE ==> acc(slot(gv.rx_active.net_descr, gv.rx_active.net_tail % QUEUE_CAPACITY).ndescr_addr) &&
              acc(slot(gv.rx_active.net_descr, gv.rx_active.net_tail % QUEUE_CAPACITY).ndescr_len) @/
  /@ assert queue_ptr == TX_FREE_BASE ==> acc(slot(gv.tx_free.net_descr, gv.tx_free.net_tail % QUEUE_CAPACITY).ndescr_addr) &&
              acc(slot(gv.tx_free.net_descr, gv.tx_free.net_tail % QUEUE_CAPACITY).ndescr_len) @/
  !st32 buff_addr + NDESC_ADDR_OFF, io_addr;
  !st16 buff_addr + NDESC_LEN_OFF, len;

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  tail = wrap_int16(tail + 1);
  !st16 queue_ptr + TAIL_OFFSET, tail;

  return 0;
}

inline fun {1,1} net_dequeue(1 queue_ptr, 1 capacity)
{
  /@ requires capacity == QUEUE_CAPACITY @/
  /@ requires bounded64(queue_ptr + BUFFERS_OFFSET + capacity * NDESC_LEN) @/ // array access
  /@ requires queue_ptr == TX_ACTIVE_BASE || queue_ptr == RX_FREE_BASE @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==>
       acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 1/2) &&
       acc(gv.tx_active.net_descr, 1/2) && acc(gv.tx_active.net_removed) &&
       acc(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr, 1/2) &&
       acc(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len, 1/2) &&
       valid_net_addr(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr) &&
       valid_net_len(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len) @/
  /@ requires queue_ptr == RX_FREE_BASE ==>
       acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 1/2) &&
       acc(gv.rx_free.net_descr, 1/2) && acc(gv.rx_free.net_removed_addr) &&
       acc(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr, 1/2) &&
       acc(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_len, 1/2) &&
       valid_net_addr(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr) &&
       valid_net_len(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_len) @/
  // non-empty queue
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> gv.tx_active.net_tail != gv.tx_active.net_head @/
  /@ requires queue_ptr == RX_FREE_BASE ==> gv.rx_free.net_tail != gv.rx_free.net_head @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> valid_net_head(gv.tx_active.net_head % (MAX_INT16 + 1)) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> valid_net_head(gv.rx_free.net_head % (MAX_INT16 + 1)) @/
  // the retval contains the data in the buffer
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==>
       acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 1/2) &&
       acc(gv.tx_active.net_descr, 1/2) && acc(gv.tx_active.net_removed) &&
       retval.0 == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr) &&
       retval.1 == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==>
       acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 1/2) &&
       acc(gv.rx_free.net_descr, 1/2) && acc(gv.rx_free.net_removed_addr) &&
       retval.0 == old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr) &&
       retval.1 == old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_len) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> valid_net_head(gv.tx_active.net_head % (MAX_INT16 + 1)) &&
       gv.tx_active.net_head == old(gv.tx_active.net_head) + 1 @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> valid_net_head(gv.rx_free.net_head % (MAX_INT16 + 1)) &&
       gv.rx_free.net_head == old(gv.rx_free.net_head) + 1 @/
  /@ ensures queue_ptr == RX_FREE_BASE ==>
       union_elem(gv.rx_free.net_removed_addr, old(gv.rx_free.net_removed_addr),
         old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr)) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==>
       union_elem_seq(gv.tx_active.net_removed, old(gv.tx_active.net_removed),
         element2_seq(old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr),
           old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len))) @/
  /@ ensures bounded32(retval.0) @/
  /@ ensures bounded16(retval.1) @/

  /* capacity must be a power of 2 */
  var head = 0;
  !ld16 head, queue_ptr + HEAD_OFFSET;

  var mod_head = mod_capacity(head, capacity);
  /@ assert queue_ptr == RX_FREE_BASE ==> gv.rx_free.net_head % QUEUE_CAPACITY == mod_head @/
  /@ assert queue_ptr == TX_ACTIVE_BASE ==> gv.tx_active.net_head % QUEUE_CAPACITY == mod_head @/
  var buff_addr = queue_ptr + BUFFERS_OFFSET + mod_head * NDESC_LEN;
  var io_addr = 0;
  var len = 0;
  /@ assert queue_ptr == RX_FREE_BASE ==> acc(slot(gv.rx_free.net_descr, gv.rx_free.net_head % QUEUE_CAPACITY).ndescr_addr, 1/2) &&
              acc(slot(gv.rx_free.net_descr, gv.rx_free.net_head % QUEUE_CAPACITY).ndescr_len, 1/2) @/
  /@ assert queue_ptr == TX_ACTIVE_BASE ==> acc(slot(gv.tx_active.net_descr, gv.tx_active.net_head % QUEUE_CAPACITY).ndescr_addr, 1/2) &&
              acc(slot(gv.tx_active.net_descr, gv.tx_active.net_head % QUEUE_CAPACITY).ndescr_len, 1/2) @/
  !ld32 io_addr, buff_addr + NDESC_ADDR_OFF;
  !ld16 len, buff_addr + NDESC_LEN_OFF;
  /@ assert queue_ptr == TX_ACTIVE_BASE ==> io_addr == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr) @/
  /@ assert queue_ptr == TX_ACTIVE_BASE ==> len == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len) @/
  /@ assert queue_ptr == RX_FREE_BASE ==> io_addr == old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr) @/
  /@ assert queue_ptr == RX_FREE_BASE ==> len == old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_len) @/

#ifdef CONFIG_ENABLE_SMP_SUPPORT
  THREAD_MEMORY_RELEASE()
#endif

  head = wrap_int16(head + 1);
  !st16 queue_ptr + HEAD_OFFSET, head;

  return <io_addr, len>;
}

inline fun net_request_signal(1 queue_ptr)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal) && gv.tx_free.net_signal == false @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal) && gv.tx_active.net_signal == false @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal) && gv.rx_free.net_signal == false @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal) && gv.rx_active.net_signal == false @/

  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 0;

  return 0;
}

inline fun net_cancel_signal(1 queue_ptr)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal) && gv.tx_free.net_signal == true @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal) && gv.tx_active.net_signal == true @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal) && gv.rx_free.net_signal == true @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal) && gv.rx_active.net_signal == true @/

  !st32 queue_ptr + CONSUMER_SIGNALLED_OFFSET, 1;

  return 0;
}

inline fun net_require_signal(1 queue_ptr, 1 capacity)
{
  /@ requires VALID_QUEUE_PTR(queue_ptr) @/
  /@ requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal, 1/2) @/
  /@ requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal, 1/2) @/
  /@ requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal, 1/2) @/
  /@ requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal, 1/2) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/2) && acc(gv.tx_free.net_signal, 1/2) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/2) && acc(gv.tx_active.net_signal, 1/2) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/2) && acc(gv.rx_free.net_signal, 1/2) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/2) && acc(gv.rx_active.net_signal, 1/2) @/
  /@ ensures queue_ptr == TX_FREE_BASE ==> retval == (gv.tx_free.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == TX_ACTIVE_BASE ==> retval == (gv.tx_active.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == RX_FREE_BASE ==> retval == (gv.rx_free.net_signal ? 0 : 1) @/
  /@ ensures queue_ptr == RX_ACTIVE_BASE ==> retval == (gv.rx_active.net_signal ? 0 : 1) @/

  var signalled = 0;
  !ld32 signalled, queue_ptr + CONSUMER_SIGNALLED_OFFSET;
  return !signalled;
}
