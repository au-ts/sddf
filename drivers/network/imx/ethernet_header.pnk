#define IRQ_CH                  pnk_mem(1)
#define RX_CH                   pnk_mem(2)
#define TX_CH                   pnk_mem(3)

#define NET_RX_FREE             pnk_mem(4)
#define NET_RX_ACTIVE           pnk_mem(5)
#define NET_RX_CAPACITY         pnk_mem(6)
#define NET_TX_FREE             pnk_mem(7)
#define NET_TX_ACTIVE           pnk_mem(8)
#define NET_TX_CAPACITY         pnk_mem(9)

#define HW_RX_TAIL_SLOT         pnk_mem_ptr(10)
#define HW_RX_HEAD_SLOT         pnk_mem_ptr(11)
#define HW_RX_TAIL              pnk_mem(10)
#define HW_RX_HEAD              pnk_mem(11)
#define HW_RX_CAPACITY          pnk_mem(12)
#define HW_RX_DESCR             pnk_mem(13)
#define HW_RX_PTR               pnk_mem_ptr(10)

#define HW_TX_TAIL_SLOT         pnk_mem_ptr(14)
#define HW_TX_HEAD_SLOT         pnk_mem_ptr(15)
#define HW_TX_TAIL              pnk_mem(14)
#define HW_TX_HEAD              pnk_mem(15)
#define HW_TX_CAPACITY          pnk_mem(16)
#define HW_TX_DESCR             pnk_mem(17)
#define HW_TX_PTR               pnk_mem_ptr(14)

var 1 irq_ch          = IRQ_CH;
var 1 rx_ch           = RX_CH;
var 1 tx_ch           = TX_CH;

var 1 net_rx_free     = NET_RX_FREE;
var 1 net_rx_active   = NET_RX_ACTIVE;
var 1 net_rx_capacity = NET_RX_CAPACITY;
var 1 net_tx_free     = NET_TX_FREE;
var 1 net_tx_active   = NET_TX_ACTIVE;
var 1 net_tx_capacity = NET_TX_CAPACITY;

var 1 hw_rx_tail_slot = HW_RX_TAIL_SLOT;
var 1 hw_rx_head_slot = HW_RX_HEAD_SLOT;
var 1 hw_rx_tail      = HW_RX_TAIL;
var 1 hw_rx_head      = HW_RX_HEAD;
var 1 hw_rx_capacity  = HW_RX_CAPACITY;
var 1 hw_rx_descr     = HW_RX_DESCR;
var 1 hw_rx_ptr       = HW_RX_PTR;

var 1 hw_tx_tail_slot = HW_TX_TAIL_SLOT;
var 1 hw_tx_head_slot = HW_TX_HEAD_SLOT;
var 1 hw_tx_tail      = HW_TX_TAIL;
var 1 hw_tx_head      = HW_TX_HEAD;
var 1 hw_tx_capacity  = HW_TX_CAPACITY;
var 1 hw_tx_descr     = HW_TX_DESCR;
var 1 hw_tx_ptr       = HW_TX_PTR;

#define ETH_EIR_OFF              4
#define ETH_RDAR_OFF             16
#define ETH_TDAR_OFF             20

#define DESCR_LEN_OFF              0
#define DESCR_STAT_OFF             2
#define DESCR_ADDR_OFF             4
#define DESCR_LEN                  8

/* Device constants */
#define RXD_EMPTY               (1 << 15)
#define WRAP                    (1 << 13)
#define TXD_READY               (1 << 15)
#define TXD_ADDCRC              (1 << 10)
#define TXD_LAST                (1 << 11)
#define RDAR_RDAR               (1 << 24)
#define TDAR_TDAR               (1 << 24)

#define NETIRQ_RXF              (1 << 25)
#define NETIRQ_TXF              (1 << 27)
#define NETIRQ_EBERR            (1 << 22)
#define IRQ_MASK                (NETIRQ_RXF | NETIRQ_TXF | NETIRQ_EBERR)

#define ETH_REG                 pnk_mem(0)
var 1 eth_reg = ETH_REG;

/@ extern predicate valid_device @/
/@ extern predicate valid_hardware_ring_rx_addr @/
/@ extern predicate valid_hardware_ring_rx_len @/
/@ extern predicate valid_hardware_ring_tx_addr @/
/@ extern predicate valid_hardware_ring_tx_len @/
/@ extern field hardware_ring_rx_addr: Seq[Int] @/
/@ extern field hardware_ring_tx_addr: Seq[Int] @/
/@ extern field hardware_ring_rx_stat: Seq[Int] @/
/@ extern field hardware_ring_tx_stat: Seq[Int] @/
/@ extern field hardware_ring_rx_len: Seq[Int] @/
/@ extern field hardware_ring_tx_len: Seq[Int] @/

#define HW_RING_BASE         35651584
#define HW_RING_RX_ADDR_LO   HW_RING_BASE + 4
#define HW_RING_RX_ADDR_HI   HW_RING_BASE + 256 * @biw
#define HW_RING_TX_ADDR_LO   HW_RING_BASE + 256 * @biw + 4
#define HW_RING_TX_ADDR_HI   HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RX_STAT_LO   HW_RING_BASE + 3
#define HW_RING_RX_STAT_HI   HW_RING_BASE + 256 * @biw
#define HW_RING_TX_STAT_LO   HW_RING_BASE + 256 * @biw + 3
#define HW_RING_TX_STAT_HI   HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RX_LEN_LO    HW_RING_BASE
#define HW_RING_RX_LEN_HI    HW_RING_BASE + 256 * @biw
#define HW_RING_TX_LEN_LO    HW_RING_BASE + 256 * @biw
#define HW_RING_TX_LEN_HI    HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RESERVE_LO   HW_RING_BASE + 2
#define HW_RING_RESERVE_HI   HW_RING_BASE + 256 * @biw + 256 * @biw

#define HW_ETH_BASE   33554432
#define RDAR_ADDR     HW_ETH_BASE + ETH_RDAR_OFF
#define TDAR_ADDR     HW_ETH_BASE + ETH_TDAR_OFF
#define EIR_ADDR      HW_ETH_BASE + ETH_EIR_OFF

/@ shared w u32 hw_ring_rx_addr[HW_RING_RX_ADDR_LO..HW_RING_RX_ADDR_HI] @/
/@ shared w u32 hw_ring_tx_addr[HW_RING_TX_ADDR_LO..HW_RING_TX_ADDR_HI] @/
/@ shared rw u8 hw_ring_rx_stat[HW_RING_RX_STAT_LO..HW_RING_RX_STAT_HI] @/
/@ shared rw u8 hw_ring_tx_stat[HW_RING_TX_STAT_LO..HW_RING_TX_STAT_HI] @/
/@ shared r u16 hw_ring_rx_len[HW_RING_RX_LEN_LO..HW_RING_RX_LEN_HI] @/
/@ shared w u16 hw_ring_tx_len[HW_RING_TX_LEN_LO..HW_RING_TX_LEN_HI] @/
/@ shared w u8 hw_ring_reserve[HW_RING_RESERVE_LO..HW_RING_RESERVE_HI] @/

/@ shared w u32 RDAR[RDAR_ADDR] @/
/@ shared w u32 TDAR[TDAR_ADDR] @/
/@ shared rw u32 EIR[EIR_ADDR] @/

/* It does not matter what these values are. The location of these is
   externally defined somewhere in RAM, so we can choose whatever we want
   in main memory. */
#define RX_FREE_BASE 		1234567
#define RX_ACTIVE_BASE 		1244667
#define TX_FREE_BASE 		1254767
#define TX_ACTIVE_BASE 		1264867

/@ shared rw u16 rx_free_tail[RX_FREE_BASE+TAIL_OFFSET..RX_FREE_BASE+TAIL_OFFSET+2] @/
/@ shared r u16 rx_free_head[RX_FREE_BASE+HEAD_OFFSET..RX_FREE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 rx_free_consumer_signalled[RX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET..RX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared r u16 rx_active_tail[RX_ACTIVE_BASE+TAIL_OFFSET..RX_ACTIVE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 rx_active_head[RX_ACTIVE_BASE+HEAD_OFFSET..RX_ACTIVE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 rx_active_consumer_signalled[RX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET..RX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared r u16 tx_free_tail[TX_FREE_BASE+TAIL_OFFSET..TX_FREE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 tx_free_head[TX_FREE_BASE+HEAD_OFFSET..TX_FREE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 tx_free_consumer_signalled[TX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET..TX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared rw u16 tx_active_tail[TX_ACTIVE_BASE+TAIL_OFFSET..TX_ACTIVE_BASE+TAIL_OFFSET+2] @/
/@ shared r u16 tx_active_head[TX_ACTIVE_BASE+HEAD_OFFSET..TX_ACTIVE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 tx_active_consumer_signalled[TX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET..TX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/

#define VALID_QUEUE_PTR(x) ( \
	x == RX_FREE_BASE   || \
	x == RX_ACTIVE_BASE || \
	x == TX_FREE_BASE   || \
	x == TX_ACTIVE_BASE    \
)

#define boundedW(x) bounded64(x)
#define MAX_WORD    MAX_INT64

/@
  predicate valid_hw_meta() {
  	acc(gv.hw_tx_tail) && acc(gv.hw_tx_head) && acc(gv.hw_tx_capacity) && acc(gv.hw_tx_descr) &&
  	acc(gv.hw_rx_tail) && acc(gv.hw_rx_head) && acc(gv.hw_rx_capacity) && acc(gv.hw_rx_descr) &&
    bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && boundedW(gv.hw_tx_descr) && boundedW(gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN) && gv.hw_tx_capacity == QUEUE_CAPACITY &&
    bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && boundedW(gv.hw_rx_descr) && boundedW(gv.hw_rx_descr + gv.hw_rx_capacity * DESCR_LEN) && gv.hw_rx_capacity == QUEUE_CAPACITY &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < RX_FREE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < RX_ACTIVE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < TX_FREE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < TX_ACTIVE_BASE &&
    gv.hw_rx_descr + gv.hw_rx_capacity * DESCR_LEN < RX_FREE_BASE &&
    gv.hw_rx_descr + gv.hw_rx_capacity * DESCR_LEN < RX_ACTIVE_BASE &&
    gv.hw_rx_descr + gv.hw_rx_capacity * DESCR_LEN < TX_FREE_BASE &&
    gv.hw_rx_descr + gv.hw_rx_capacity * DESCR_LEN < TX_ACTIVE_BASE
  }
@/

/@
  predicate valid_virt_meta() {
    acc(gv.net_rx_free) && gv.net_rx_free == RX_FREE_BASE &&
    acc(gv.net_rx_active) && gv.net_rx_active == RX_ACTIVE_BASE &&
    acc(gv.net_tx_free) && gv.net_tx_free == TX_FREE_BASE &&
    acc(gv.net_tx_active) && gv.net_tx_active == TX_ACTIVE_BASE &&
  	acc(gv.net_tx_capacity) && gv.net_tx_capacity == QUEUE_CAPACITY &&
  	acc(gv.net_rx_capacity) && gv.net_rx_capacity == QUEUE_CAPACITY
  }
@/

// WLOG we can say the overlap is one way or another
/*/@
  predicate non_overlap() {
    acc(valid_hw_meta()) && unfolding valid_hw_meta() in
    (gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < RX_FREE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < RX_ACTIVE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < TX_FREE_BASE &&
    gv.hw_tx_descr + gv.hw_tx_capacity * DESCR_LEN < TX_ACTIVE_BASE)
  }
@/*/

/@
  predicate valid() {
  	valid_device() &&
  	valid_virt() &&
  	acc(gv.eth_reg) && gv.eth_reg == HW_ETH_BASE &&
  	valid_hw_meta() &&
    valid_virt_meta() &&
    acc(gv.hw_rx_ptr) && acc(gv.hw_tx_ptr) &&
    boundedW(gv.hw_rx_ptr) && boundedW(gv.hw_tx_ptr) &&
    acc(gv.irq_ch) && acc(gv.rx_ch) && acc(gv.tx_ch)
  }
@/
