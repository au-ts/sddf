#define IRQ_CH                  pnk_mem(1)
#define RX_CH                   pnk_mem(2)
#define TX_CH                   pnk_mem(3)

#define NET_RX_FREE             pnk_mem(4)
#define NET_RX_ACTIVE           pnk_mem(5)
#define NET_RX_CAPACITY         pnk_mem(6)
#define NET_TX_FREE             pnk_mem(7)
#define NET_TX_ACTIVE           pnk_mem(8)
#define NET_TX_CAPACITY         pnk_mem(9)

#define HW_RX_TAIL_SLOT         pnk_mem_ptr(10)
#define HW_RX_HEAD_SLOT         pnk_mem_ptr(11)
#define HW_RX_TAIL              pnk_mem(10)
#define HW_RX_HEAD              pnk_mem(11)
#define HW_RX_CAPACITY          pnk_mem(12)
#define HW_RX_DESCR             pnk_mem(13)
#define HW_RX_PTR               pnk_mem_ptr(10)

#define HW_TX_TAIL_SLOT         pnk_mem_ptr(14)
#define HW_TX_HEAD_SLOT         pnk_mem_ptr(15)
#define HW_TX_TAIL              pnk_mem(14)
#define HW_TX_HEAD              pnk_mem(15)
#define HW_TX_CAPACITY          pnk_mem(16)
#define HW_TX_DESCR             pnk_mem(17)
#define HW_TX_PTR               pnk_mem_ptr(14)

var 1 irq_ch          = IRQ_CH;
var 1 rx_ch           = RX_CH;
var 1 tx_ch           = TX_CH;

var 1 net_rx_free     = NET_RX_FREE;
var 1 net_rx_active   = NET_RX_ACTIVE;
var 1 net_rx_capacity = NET_RX_CAPACITY;
var 1 net_tx_free     = NET_TX_FREE;
var 1 net_tx_active   = NET_TX_ACTIVE;
var 1 net_tx_capacity = NET_TX_CAPACITY;

var 1 hw_rx_tail_slot = HW_RX_TAIL_SLOT;
var 1 hw_rx_head_slot = HW_RX_HEAD_SLOT;
var 1 hw_rx_tail      = HW_RX_TAIL;
var 1 hw_rx_head      = HW_RX_HEAD;
var 1 hw_rx_capacity  = HW_RX_CAPACITY;
var 1 hw_rx_descr     = HW_RX_DESCR;
var 1 hw_rx_ptr       = HW_RX_PTR;

var 1 hw_tx_tail_slot = HW_TX_TAIL_SLOT;
var 1 hw_tx_head_slot = HW_TX_HEAD_SLOT;
var 1 hw_tx_tail      = HW_TX_TAIL;
var 1 hw_tx_head      = HW_TX_HEAD;
var 1 hw_tx_capacity  = HW_TX_CAPACITY;
var 1 hw_tx_descr     = HW_TX_DESCR;
var 1 hw_tx_ptr       = HW_TX_PTR;

#define ETH_EIR_OFF              4
#define ETH_RDAR_OFF             16
#define ETH_TDAR_OFF             20

#define DESCR_LEN_OFF              0
#define DESCR_LEN_LEN              2
#define DESCR_STAT_OFF             2
#define DESCR_STAT_LEN             2
#define DESCR_ADDR_OFF             4
#define DESCR_ADDR_LEN             4
#define DESCR_LEN                  8

#define WRAP_MASK       8192

/* Device constants */
#define RXD_EMPTY               (1 << 15)
#define WRAP                    (1 << 13)
#define TXD_READY               (1 << 15)
#define TXD_ADDCRC              (1 << 10)
#define TXD_LAST                (1 << 11)
#define RDAR_RDAR               (1 << 24)
#define TDAR_TDAR               (1 << 24)

#define NETIRQ_RXF              (1 << 25)
#define NETIRQ_TXF              (1 << 27)
#define NETIRQ_EBERR            (1 << 22)
#define IRQ_MASK                (NETIRQ_RXF | NETIRQ_TXF | NETIRQ_EBERR)

#define ETH_REG                 pnk_mem(0)
var 1 eth_reg = ETH_REG;

/@ extern predicate valid_virt @/
/@ extern field net_descr: IArray @/
/@ extern field ndescr_addr: Int @/
/@ extern field ndescr_len: Int @/
/@ extern field net_removed_addr: Set[Int] @/
/@ extern field net_removed: Set[Seq[Int]] @/
/@ extern field net_added: Set[Seq[Int]] @/
/@ extern field ghost_unprocessed: Bool @/
/@ extern function net_queue_injective_produce(r: Ref): Bool @/
/@ extern function net_queue_injective_consume(r: Ref): Bool @/
/@ extern function garbage_a(): Bool @/
/@ extern function garbage_b(): Bool @/
/@ extern function garbage_a2(): Bool @/
/@ extern function garbage_b2(): Bool @/
/@ extern function garbage_c(): Bool @/
/@ extern function garbage_c2(): Bool @/

/@ extern predicate valid_hardware_ring_rx_write @/
/@ extern predicate valid_hardware_ring_rx_read @/
/@ extern predicate valid_hardware_ring_tx_write @/
/@ extern predicate valid_hardware_ring_tx_read @/
/@ extern function valid_hardware_ring_rx_mdata_write(): Bool @/
/@ extern function valid_hardware_ring_tx_mdata_write(): Bool @/
/@ extern function valid_hardware_ring_tx_mdata_read(): Bool @/
/@ extern function valid_hardware_ring_rx_mdata_read(): Bool @/
/@ extern predicate valid_net_queue_produce @/
/@ extern predicate valid_net_queue_consume @/
/@ extern field hardware_ring_tx: IArray @/
/@ extern field hardware_ring_rx: IArray @/
/@ extern field tx_await_ack: Seq[Int] @/
/@ extern field rx_await_ack: Seq[Int] @/
/@ extern field tx_handled: Set[Seq[Int]] @/
/@ extern field rx_handled: Set[Seq[Int]] @/
/@ extern field rx_processed: Set[Seq[Int]] @/
/@ extern field tx_processed: Set[Int] @/
/@ extern field hw_addr: Int @/
/@ extern field hw_stat: Int @/
/@ extern field hw_len: Int @/

/@ extern function union_elem(s: Set[Int], t: Set[Int], e: Int): Bool @/
/@ extern function union_elem_seq(s: Set[Seq[Int]], t: Set[Seq[Int]], e: Seq[Int]): Bool @/
/@ extern function empty_set(): Set[Int] @/
/@ extern function empty_set_seqint(): Set[Seq[Int]] @/
/@ extern function element_set(e: Int): Set[Int] @/
/@ extern function element_seq(e: Int): Seq[Int] @/
/@ extern function element2_seq(e1: Int, e2: Int): Seq[Int] @/
/@ extern function empty_seq(): Seq[Int] @/
/@ extern function append_elem(s: Seq[Int], t: Seq[Int], e: Int): Bool @/
/@ extern function is_RXD_EMPTY(value: Int): Bool @/
/@ extern function is_TXD_READY(value: Int): Bool @/
/@ extern function is_WRAP(value: Int): Bool @/
/@ extern function slot(arr: IArray, i: Int): Int @/
/@ extern function slotq(arr: IArray, i: Int): Int @/
/@ extern function is_valid_data_addr(value: Int): Bool @/
/@ extern function is_valid_data_len(value: Int): Bool @/
/@ extern function is_valid_rx_stat(value: Int): Bool @/
/@ extern function is_valid_tx_stat(value: Int): Bool @/
/@ extern function setminus_seqint(s: Set[Seq[Int]], t: Set[Seq[Int]]): Set[Seq[Int]] @/
/@ extern function ring_head_incr_lemma(a: Int, b: Int, i: Int): Bool @/

#define HW_RING_BASE         35651584
#define HW_ETH_BASE   33554432
#define RDAR_ADDR     HW_ETH_BASE + ETH_RDAR_OFF
#define TDAR_ADDR     HW_ETH_BASE + ETH_TDAR_OFF
#define EIR_ADDR      HW_ETH_BASE + ETH_EIR_OFF
#define HW_DESCRIPTOR_SIZE    8

#define valid_net_tail(x) bounded16(x)
#define valid_net_head(x) bounded16(x)
#define valid_net_addr(x) bounded32(x)
#define valid_net_len(x) bounded16(x)

/@ shared w u32 RDAR[RDAR_ADDR] @/
/@ shared w u32 TDAR[TDAR_ADDR] @/
/@ shared rw u32 EIR[EIR_ADDR] @/

/* It does not matter what these values are. The location of these is
   externally defined somewhere in RAM, so we can choose whatever we want
   in main memory. */
#define RX_FREE_BASE 		1234567
#define RX_ACTIVE_BASE 		1244667
#define TX_FREE_BASE 		1254767
#define TX_ACTIVE_BASE 		1264867

#define HW_RING_LEN       256*DESCR_LEN
#define HW_RING_RX_ADDR     35651584
#define HW_RING_TX_ADDR     35653632

/@ shared rw u32 hw_ring_rx_addr[HW_RING_RX_ADDR+DESCR_ADDR_OFF..HW_RING_RX_ADDR+HW_RING_LEN:DESCR_LEN] @/
/@ shared rw u32 hw_ring_tx_addr[HW_RING_TX_ADDR+DESCR_ADDR_OFF..HW_RING_TX_ADDR+HW_RING_LEN:DESCR_LEN] @/
/@ shared rw u16 hw_ring_rx_stat[HW_RING_RX_ADDR+DESCR_STAT_OFF..HW_RING_RX_ADDR+HW_RING_LEN:DESCR_LEN] @/
/@ shared rw u16 hw_ring_tx_stat[HW_RING_TX_ADDR+DESCR_STAT_OFF..HW_RING_TX_ADDR+HW_RING_LEN:DESCR_LEN] @/
/@ shared rw u16 hw_ring_rx_len[HW_RING_RX_ADDR+DESCR_LEN_OFF..HW_RING_RX_ADDR+HW_RING_LEN:DESCR_LEN] @/
/@ shared rw u16 hw_ring_tx_len[HW_RING_TX_ADDR+DESCR_LEN_OFF..HW_RING_TX_ADDR+HW_RING_LEN:DESCR_LEN] @/

#define RXD_EMPTY_MASK   32768   // 1 << 15
#define TXD_READY_MASK   32768   // 1 << 15
#define RX_STAT_MASK     1544    // (1 << 3) | (1 << 9) | (1 << 10) == 1544
#define TX_STAT_MASK     511     // bits 8-0 cleared

/@ shared r u16 rx_free_tail[RX_FREE_BASE+TAIL_OFFSET..RX_FREE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 rx_free_head[RX_FREE_BASE+HEAD_OFFSET..RX_FREE_BASE+HEAD_OFFSET+2] @/
/@ shared w u32 rx_free_consumer_signalled[RX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET..RX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared r u32 rx_free_addr[RX_FREE_BASE+BUFFERS_OFFSET+NDESC_ADDR_OFF..RX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared r u16 rx_free_len[RX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN_OFF..RX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared rw u16 rx_active_tail[RX_ACTIVE_BASE+TAIL_OFFSET..RX_ACTIVE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 rx_active_head[RX_ACTIVE_BASE+HEAD_OFFSET..RX_ACTIVE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 rx_active_consumer_signalled[RX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET..RX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared w u32 rx_active_addr[RX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_ADDR_OFF..RX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared w u16 rx_active_len[RX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN_OFF..RX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared rw u16 tx_free_tail[TX_FREE_BASE+TAIL_OFFSET..TX_FREE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 tx_free_head[TX_FREE_BASE+HEAD_OFFSET..TX_FREE_BASE+HEAD_OFFSET+2] @/
/@ shared rw u32 tx_free_consumer_signalled[TX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET..TX_FREE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared w u32 tx_free_addr[TX_FREE_BASE+BUFFERS_OFFSET+NDESC_ADDR_OFF..TX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared w u16 tx_free_len[TX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN_OFF..TX_FREE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared rw u16 tx_active_tail[TX_ACTIVE_BASE+TAIL_OFFSET..TX_ACTIVE_BASE+TAIL_OFFSET+2] @/
/@ shared rw u16 tx_active_head[TX_ACTIVE_BASE+HEAD_OFFSET..TX_ACTIVE_BASE+HEAD_OFFSET+2] @/
/@ shared w u32 tx_active_consumer_signalled[TX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET..TX_ACTIVE_BASE+CONSUMER_SIGNALLED_OFFSET+4] @/
/@ shared r u32 tx_active_addr[TX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_ADDR_OFF..TX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/
/@ shared r u16 tx_active_len[TX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN_OFF..TX_ACTIVE_BASE+BUFFERS_OFFSET+NDESC_LEN*QUEUE_CAPACITY:NDESC_LEN] @/


#define VALID_QUEUE_PTR(x) ( \
	x == RX_FREE_BASE   || \
	x == RX_ACTIVE_BASE || \
	x == TX_FREE_BASE   || \
	x == TX_ACTIVE_BASE    \
)

#define boundedW(x) bounded64(x)
#define MAX_WORD    MAX_INT64

/@
  predicate valid() {
	valid_hardware_ring_rx_mdata_write() && valid_hardware_ring_tx_mdata_write() &&
  	valid_virt() &&
  	acc(gv.eth_reg) && gv.eth_reg == HW_ETH_BASE &&
  	acc(gv.hw_tx_tail, 99/100) && acc(gv.hw_tx_head, 99/100) &&
	acc(gv.hw_tx_capacity, 99/100) && acc(gv.hw_tx_descr) &&
  	acc(gv.hw_rx_tail, 99/100) && acc(gv.hw_rx_head, 99/100) &&
	acc(gv.hw_rx_capacity, 99/100) && acc(gv.hw_rx_descr) &&
    gv.hw_tx_capacity == 256 &&
    gv.hw_rx_capacity == 256 &&
    bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && boundedW(gv.hw_tx_descr) && gv.hw_rx_descr == HW_RING_RX_ADDR && gv.hw_tx_capacity == QUEUE_CAPACITY &&
    bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && boundedW(gv.hw_rx_descr) && gv.hw_tx_descr == HW_RING_TX_ADDR && gv.hw_rx_capacity == QUEUE_CAPACITY &&
    acc(gv.net_rx_free) && gv.net_rx_free == RX_FREE_BASE &&
    acc(gv.net_rx_active) && gv.net_rx_active == RX_ACTIVE_BASE &&
    acc(gv.net_tx_free) && gv.net_tx_free == TX_FREE_BASE &&
    acc(gv.net_tx_active) && gv.net_tx_active == TX_ACTIVE_BASE &&
  	acc(gv.net_tx_capacity) && gv.net_tx_capacity == QUEUE_CAPACITY &&
  	acc(gv.net_rx_capacity) && gv.net_rx_capacity == QUEUE_CAPACITY &&
    acc(gv.hw_rx_ptr) && acc(gv.hw_tx_ptr) &&
    boundedW(gv.hw_rx_ptr) && boundedW(gv.hw_tx_ptr) &&
    acc(gv.irq_ch) && acc(gv.rx_ch) && acc(gv.tx_ch) &&
	acc(gv.tx_await_ack) && acc(gv.rx_await_ack) &&
	gv.tx_await_ack == empty_seq() && gv.rx_await_ack == empty_seq() &&
	acc(gv.rx_handled) &&
    0 <= (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) <= gv.hw_rx_capacity &&
    0 <= (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) <= gv.hw_tx_capacity
  }
@/

#define empty_ghost_state() (
	unfolding valid() in
		(unfolding valid_virt() in
			gv.rx_active.net_added == empty_set_seqint() &&
			gv.rx_free.net_added == empty_set_seqint() &&
			gv.tx_active.net_added == empty_set_seqint() &&
			gv.tx_free.net_added == empty_set_seqint() &&
			gv.rx_active.net_removed_addr == empty_set() &&
			gv.rx_free.net_removed_addr == empty_set() &&
			gv.tx_active.net_removed_addr == empty_set() &&
			gv.tx_free.net_removed_addr == empty_set() &&
			gv.rx_active.net_removed == empty_set_seqint() &&
			gv.rx_free.net_removed == empty_set_seqint() &&
			gv.tx_active.net_removed == empty_set_seqint() &&
			gv.tx_free.net_removed == empty_set_seqint()) &&
		gv.rx_handled == empty_set_seqint() &&
		gv.tx_handled == empty_set_seqint() &&
		gv.rx_await_ack == empty_set() &&
		gv.tx_await_ack == empty_set()
)
