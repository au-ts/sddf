#define IRQ_CH                  pnk_mem(1)
#define RX_CH                   pnk_mem(2)
#define TX_CH                   pnk_mem(3)

#define NET_RX_FREE             pnk_mem(4)
#define NET_RX_ACTIVE           pnk_mem(5)
#define NET_RX_CAPACITY         pnk_mem(6)
#define NET_TX_FREE             pnk_mem(7)
#define NET_TX_ACTIVE           pnk_mem(8)
#define NET_TX_CAPACITY         pnk_mem(9)

#define HW_RX_TAIL_SLOT         pnk_mem_ptr(10)
#define HW_RX_HEAD_SLOT         pnk_mem_ptr(11)
#define HW_RX_TAIL              pnk_mem(10)
#define HW_RX_HEAD              pnk_mem(11)
#define HW_RX_CAPACITY          pnk_mem(12)
#define HW_RX_DESCR             pnk_mem(13)
#define HW_RX_PTR               pnk_mem_ptr(10)

#define HW_TX_TAIL_SLOT         pnk_mem_ptr(14)
#define HW_TX_HEAD_SLOT         pnk_mem_ptr(15)
#define HW_TX_TAIL              pnk_mem(14)
#define HW_TX_HEAD              pnk_mem(15)
#define HW_TX_CAPACITY          pnk_mem(16)
#define HW_TX_DESCR             pnk_mem(17)
#define HW_TX_PTR               pnk_mem_ptr(14)

#define ETH_EIR_OFF              4
#define ETH_RDAR_OFF             16
#define ETH_TDAR_OFF             20

#define DESCR_LEN_OFF              0
#define DESCR_STAT_OFF             2
#define DESCR_ADDR_OFF             4
#define DESCR_LEN                  8

/* Device constants */
#define RXD_EMPTY               (1 << 15)
#define WRAP                    (1 << 13)
#define TXD_READY               (1 << 15)
#define TXD_ADDCRC              (1 << 10)
#define TXD_LAST                (1 << 11)
#define RDAR_RDAR               (1 << 24)
#define TDAR_TDAR               (1 << 24)

#define NETIRQ_RXF              (1 << 25)
#define NETIRQ_TXF              (1 << 27)
#define NETIRQ_EBERR            (1 << 22)
#define IRQ_MASK                (NETIRQ_RXF | NETIRQ_TXF | NETIRQ_EBERR)

#define ETH_REG                 pnk_mem(0)

/@ extern predicate valid_hardware_ring_rx_addr @/
/@ extern predicate valid_hardware_ring_rx_len @/
/@ extern predicate valid_hardware_ring_tx_addr @/
/@ extern predicate valid_hardware_ring_tx_len @/
/@ extern field hardware_ring_rx_addr: Seq[Int] @/
/@ extern field hardware_ring_tx_addr: Seq[Int] @/
/@ extern field hardware_ring_rx_stat: Seq[Int] @/
/@ extern field hardware_ring_tx_stat: Seq[Int] @/
/@ extern field hardware_ring_rx_len: Seq[Int] @/
/@ extern field hardware_ring_tx_len: Seq[Int] @/

#define HW_RING_BASE         35651584
#define HW_RING_RX_ADDR_LO   HW_RING_BASE + 4
#define HW_RING_RX_ADDR_HI   HW_RING_BASE + 256 * @biw
#define HW_RING_TX_ADDR_LO   HW_RING_BASE + 256 * @biw + 4
#define HW_RING_TX_ADDR_HI   HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RX_STAT_LO   HW_RING_BASE + 3
#define HW_RING_RX_STAT_HI   HW_RING_BASE + 256 * @biw
#define HW_RING_TX_STAT_LO   HW_RING_BASE + 256 * @biw + 3
#define HW_RING_TX_STAT_HI   HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RX_LEN_LO    HW_RING_BASE
#define HW_RING_RX_LEN_HI    HW_RING_BASE + 256 * @biw
#define HW_RING_TX_LEN_LO    HW_RING_BASE + 256 * @biw
#define HW_RING_TX_LEN_HI    HW_RING_BASE + 256 * @biw + 256 * @biw
#define HW_RING_RESERVE_LO   HW_RING_BASE + 2
#define HW_RING_RESERVE_HI   HW_RING_BASE + 256 * @biw + 256 * @biw

#define HW_ETH_BASE   33554432
#define RDAR_ADDR     HW_ETH_BASE + ETH_RDAR_OFF
#define TDAR_ADDR     HW_ETH_BASE + ETH_TDAR_OFF
#define EIR_ADDR      HW_ETH_BASE + ETH_EIR_OFF

/@ shared w u32 hw_ring_rx_addr[HW_RING_RX_ADDR_LO..HW_RING_RX_ADDR_HI] @/
/@ shared w u32 hw_ring_tx_addr[HW_RING_TX_ADDR_LO..HW_RING_TX_ADDR_HI] @/
/@ shared rw u8 hw_ring_rx_stat[HW_RING_RX_STAT_LO..HW_RING_RX_STAT_HI] @/
/@ shared rw u8 hw_ring_tx_stat[HW_RING_TX_STAT_LO..HW_RING_TX_STAT_HI] @/
/@ shared r u16 hw_ring_rx_len[HW_RING_RX_LEN_LO..HW_RING_RX_LEN_HI] @/
/@ shared w u16 hw_ring_tx_len[HW_RING_TX_LEN_LO..HW_RING_TX_LEN_HI] @/
/@ shared w u8 hw_ring_reserve[HW_RING_RESERVE_LO..HW_RING_RESERVE_HI] @/

/@ shared w u32 RDAR[RDAR_ADDR] @/
/@ shared w u32 TDAR[TDAR_ADDR] @/
/@ shared rw u32 EIR[EIR_ADDR] @/

/@ model field device @/
/@ model field virt @/

inline fun rx_hw_ring_empty() {
  return (HW_RX_HEAD == HW_RX_TAIL);
}

inline fun tx_hw_ring_empty() {
  return (HW_TX_HEAD == HW_TX_TAIL);
}

inline fun rx_hw_ring_full() {
  return (HW_RX_TAIL - HW_RX_HEAD) == HW_RX_CAPACITY;
}

inline fun tx_hw_ring_full() {
  return (HW_TX_TAIL - HW_TX_HEAD) == HW_TX_CAPACITY;
}

inline fun set_rdar()
{
  !st32 ETH_REG + ETH_RDAR_OFF, RDAR_RDAR;
  return 0;
}

inline fun set_tdar()
{
  !st32  ETH_REG + ETH_TDAR_OFF, TDAR_TDAR;
  return 0;
}

inline fun get_eir_status()
{
  var eir = 0;
  !ld32 eir, ETH_REG + ETH_EIR_OFF;
  return eir;
}

inline fun get_eir()
{
  var 1 eir_full = get_eir_status();
  return eir_full & IRQ_MASK;
}

inline fun set_eir(1 eir)
{
  !st32 ETH_REG + ETH_EIR_OFF, eir;
  return 0;
}

inline fun rx_update_ring_slot(1 ring_addr, 1 idx, 1 phys, 1 len, 1 stat)
{
  var descr = HW_RX_DESCR + idx * DESCR_LEN;        
  if (idx + 1 == HW_RX_CAPACITY) {
    stat = stat | WRAP;
  }

  !st32 descr + DESCR_ADDR_OFF, phys;
  !st16 descr + DESCR_LEN_OFF, len;
  /* Ensure all writes to the descriptor complete, before we set the flags
   * that makes hardware aware of this slot.
   */
  THREAD_MEMORY_RELEASE()
  !st16 descr + DESCR_STAT_OFF, stat;
  return 0;
}

inline fun tx_update_ring_slot(1 ring_addr, 1 idx, 1 phys, 1 len, 1 stat)
{
  var descr = HW_TX_DESCR + idx * DESCR_LEN;        
  if (idx + 1 == HW_TX_CAPACITY) {
    stat = stat | WRAP;
  }

  !st32 descr + DESCR_ADDR_OFF, phys;
  !st16 descr + DESCR_LEN_OFF, len;
  /* Ensure all writes to the descriptor complete, before we set the flags
   * that makes hardware aware of this slot.
   */
  THREAD_MEMORY_RELEASE()
  !st16 descr + DESCR_STAT_OFF, stat;
  return 0;
}

fun rx_provide()
{
  var reprocess = true;

  while (reprocess)
  {
    var 1 full = rx_hw_ring_full();
    var 1 empty = net_queue_empty(NET_RX_FREE, NET_RX_CAPACITY);
    while (!full && !empty)
    {
      var {1,1} buffer = net_dequeue(NET_RX_FREE, NET_RX_CAPACITY);

      var idx = HW_RX_TAIL & (HW_RX_CAPACITY - 1);

      var io_addr = buffer.0;
      rx_update_ring_slot(HW_RX_PTR, idx, io_addr, 0, RXD_EMPTY);

      st HW_RX_TAIL_SLOT, (HW_RX_TAIL + 1);
      set_rdar();
      full = rx_hw_ring_full();
      empty = net_queue_empty(NET_RX_FREE, NET_RX_CAPACITY);
    }

    /* Only request a notification from virtualiser if HW ring not full */
    full = rx_hw_ring_full();
    if (!full) {
      net_request_signal(NET_RX_FREE, NET_RX_CAPACITY);
    } else {
      net_cancel_signal(NET_RX_FREE);
    }
    reprocess = false;

    empty = net_queue_empty(NET_RX_FREE, NET_RX_CAPACITY);
    if ((!empty) && (!full)) {
      net_cancel_signal(NET_RX_FREE);
      reprocess = true;
    }
  }
  return 0;
}

fun rx_return()
{
  var packets_transferred = false;

  var 1 empty = rx_hw_ring_empty();
  while (!empty)
  {
    /* If buffer slot is still empty, we have processed all packets the device has filled */
    var idx = HW_RX_HEAD & (HW_RX_CAPACITY - 1);

    var dscr_addr = HW_RX_DESCR + idx * @biw;
    var stat = 0;
    !ld16 stat, dscr_addr + 2;
    if (stat & RXD_EMPTY) { break; }

    THREAD_MEMORY_ACQUIRE()

    var len = 0;
    !ld16 len, dscr_addr;
    var io_addr = 0;
    !ld32 io_addr, dscr_addr + 4;

    net_enqueue(NET_RX_ACTIVE, io_addr, len, NET_RX_CAPACITY);
    packets_transferred = true;

    st HW_RX_HEAD_SLOT, (HW_RX_HEAD + 1);

    empty = rx_hw_ring_empty();
  }

  var 1 to_signal = net_require_signal(NET_RX_ACTIVE, NET_RX_CAPACITY);
  if (packets_transferred && to_signal) {
    net_cancel_signal(NET_RX_ACTIVE);
    microkit_notify(RX_CH)
  }

  return 0;
}

fun tx_provide()
{
  var reprocess = true;

  while (reprocess)
  {
    var 1 full = tx_hw_ring_full();
    var 1 empty = net_queue_empty(NET_TX_ACTIVE, NET_TX_CAPACITY);
    while (!full && !empty)
    {
      var {1,1} buffer = net_dequeue(NET_TX_ACTIVE, NET_TX_CAPACITY);

      var idx = HW_TX_TAIL & (HW_TX_CAPACITY - 1);

      var io_addr = buffer.0;
      var len = buffer.1;
      var stat = TXD_READY | TXD_ADDCRC | TXD_LAST;
      tx_update_ring_slot(HW_TX_PTR, idx, io_addr, len, stat);

      st HW_TX_TAIL_SLOT, (HW_TX_TAIL + 1);
      set_tdar();

      full = tx_hw_ring_full();
      empty = net_queue_empty(NET_TX_ACTIVE, NET_TX_CAPACITY);
    }

    net_request_signal(NET_TX_ACTIVE, NET_TX_CAPACITY);
    reprocess = false;

    full = tx_hw_ring_full();
    empty = net_queue_empty(NET_TX_ACTIVE, NET_TX_CAPACITY);
    if ((!empty) && (!full)) {
      net_cancel_signal(NET_TX_ACTIVE);
      reprocess = true;
    }
  }
  return 0;
}

fun tx_return()
{
  var tx_free = NET_TX_FREE;
  var tx_descr = HW_TX_DESCR;
  var tx_queue_cap = NET_TX_CAPACITY;
  var tx_hw_cap = HW_TX_CAPACITY;

  var enqueued = false;

  var 1 empty = tx_hw_ring_empty();
  while (!empty)
  {
    /* Ensure that this buffer has been sent by the device */
    var idx = HW_TX_HEAD & (tx_hw_cap - 1);

    var dscr_addr = tx_descr + idx * DESCR_LEN;        
    var stat = 0;
    !ld16 stat, dscr_addr + DESCR_STAT_OFF;
    if (stat & TXD_READY) { break; }

    THREAD_MEMORY_ACQUIRE()

    var io_addr = 0;
    !ld32 io_addr, dscr_addr + DESCR_ADDR_OFF;
    net_enqueue(tx_free, io_addr, 0, tx_queue_cap);

    enqueued = true;
    st HW_TX_HEAD_SLOT, (HW_TX_HEAD + 1);

    empty = tx_hw_ring_empty();
  }

  var 1 to_signal = net_require_signal(tx_free, tx_queue_cap);
  if (enqueued && to_signal) {
    net_cancel_signal(tx_free);
    microkit_notify(TX_CH)
  }

  return 0;
}

fun main() {
  rx_provide();
  tx_provide();
  return 0;
}

fun handle_irq() {
  var 1 eir_full = get_eir_status();
  var eir = eir_full & IRQ_MASK;
  set_eir(eir);

  while (eir & IRQ_MASK)
  {
    if (eir & NETIRQ_TXF) {
      tx_return();
      tx_provide();
    }
    if (eir & NETIRQ_RXF) {
      rx_return();
      rx_provide();
    }
    eir_full = get_eir_status();
    eir = eir_full & IRQ_MASK;
    set_eir(eir);
  }
  return 0;
}

export fun notified(1 ch)
{
  if (ch == IRQ_CH) {
    handle_irq();
    /*
     * Delay calling into the kernel to ack the IRQ until the next loop
     * in the microkit event handler loop.
     */
    microkit_deferred_irq_ack(ch)
  }
  if (ch == RX_CH) {
    rx_provide();
  }
  if (ch == TX_CH) {
    tx_provide();
  }
  return 0;
}
