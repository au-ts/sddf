inline fun rx_hw_ring_empty()
{
  /@ requires acc(gv.hw_rx_head, 1/2) && acc(gv.hw_rx_tail, 1/2) @/
  /@ ensures acc(gv.hw_rx_head, 1/2) && acc(gv.hw_rx_tail, 1/2) @/
  /@ ensures retval == (gv.hw_rx_head == gv.hw_rx_tail) @/

  return (hw_rx_head == hw_rx_tail);
}

inline fun tx_hw_ring_empty()
{
  /@ requires acc(gv.hw_tx_head, 1/2) && acc(gv.hw_tx_tail, 1/2) @/
  /@ ensures acc(gv.hw_tx_head, 1/2) && acc(gv.hw_tx_tail, 1/2) @/
  /@ ensures retval == (gv.hw_tx_head == gv.hw_tx_tail) @/

  return (hw_tx_head == hw_tx_tail);
}

inline fun rx_hw_ring_full()
{
  /@ requires acc(gv.hw_rx_head, 1/2) && acc(gv.hw_rx_tail, 1/2) && acc(gv.hw_rx_capacity, 1/2) @/
  /@ requires bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && bounded16(gv.hw_rx_capacity) @/
  /@ ensures acc(gv.hw_rx_head, 1/2) && acc(gv.hw_rx_tail, 1/2) && acc(gv.hw_rx_capacity, 1/2) @/
  /@ ensures bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && bounded16(gv.hw_rx_capacity) @/
  /@ ensures retval == ((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity) @/

  if (hw_rx_tail >= hw_rx_head) {
    return (hw_rx_tail - hw_rx_head) == hw_rx_capacity;
  }
  return (hw_rx_head - hw_rx_tail) == (MAX_INT16 + 1 - hw_rx_capacity);
}

inline fun tx_hw_ring_full()
{
  /@ requires acc(gv.hw_tx_head, 1/2) && acc(gv.hw_tx_tail, 1/2) && acc(gv.hw_tx_capacity, 1/2) @/
  /@ requires bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && bounded16(gv.hw_tx_capacity) @/
  /@ ensures acc(gv.hw_tx_head, 1/2) && acc(gv.hw_tx_tail, 1/2) && acc(gv.hw_tx_capacity, 1/2) @/
  /@ ensures bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && bounded16(gv.hw_tx_capacity) @/
  /@ ensures retval == ((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity) @/

  if (hw_tx_tail >= hw_tx_head) {
    return (hw_tx_tail - hw_tx_head) == hw_tx_capacity;
  }
  return (hw_tx_head - hw_tx_tail) == (MAX_INT16 + 1 - hw_tx_capacity);
}

inline fun set_rdar()
{
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.rx_await_ack) && acc(gv.hardware_ring_rx, 2/3) && acc(gv.rx_handled) @/
  /@ requires forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j] @/
  /@ requires forall i: Int :: i in gv.rx_await_ack ==>
              acc(slot(gv.hardware_ring_rx, i).hw_addr) &&
              is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr) &&
              acc(slot(gv.hardware_ring_rx, i).hw_stat, 2/3) &&
              is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat) &&
              acc(slot(gv.hardware_ring_rx, i).hw_len) &&
              is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len) &&
              is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
              acc(slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
              !slot(gv.hardware_ring_rx, i).ghost_unprocessed @/
  /@ requires forall i: Int :: i in gv.rx_await_ack ==> forall x: Seq[Int] :: x in gv.rx_handled ==>
                |x| == 2 && x[0] != slot(gv.hardware_ring_rx, i).hw_addr @/
  /@ ensures acc(gv.eth_reg, 1/2) @/
  /@ ensures acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() &&
       acc(gv.hardware_ring_rx, 2/3) && acc(gv.rx_handled) @/
  /@ ensures forall i: Int :: i in old(gv.rx_await_ack) ==> acc(slot(gv.hardware_ring_rx, i).hw_stat, 2/3) @/
  /@ ensures forall i: Int :: i in old(gv.rx_await_ack) ==>
       element2_seq(old(slot(gv.hardware_ring_rx, i).hw_addr), old(slot(gv.hardware_ring_rx, i).hw_len)) in gv.rx_handled @/
  /@ ensures forall x: Seq[Int] :: x in old(gv.rx_handled) ==> x in gv.rx_handled @/
  /@ ensures forall x: Seq[Int] :: x in gv.rx_handled ==> x in old(gv.rx_handled) ||
               (|x| == 2 && exists i: Int :: 0 <= i && i < old(|gv.rx_await_ack|) &&
                  x == element2_seq(old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr), old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len))) @/
  /@ ensures |gv.rx_handled| == |old(gv.rx_handled)| + |old(gv.rx_await_ack)| @/

  !st32 eth_reg + ETH_RDAR_OFF, RDAR_RDAR;
  return 0;
}

inline fun set_tdar()
{
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.tx_await_ack) && acc(gv.hardware_ring_tx, 2/3) && acc(gv.tx_handled) @/
  /@ requires forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
                gv.tx_await_ack[i] != gv.tx_await_ack[j] @/
  /@ requires forall i: Int :: i in gv.tx_await_ack ==>
              acc(slot(gv.hardware_ring_tx, i).hw_addr) &&
              is_valid_data_addr(slot(gv.hardware_ring_tx, i).hw_addr) &&
              acc(slot(gv.hardware_ring_tx, i).hw_stat, 2/3) &&
              is_valid_tx_stat(slot(gv.hardware_ring_tx, i).hw_stat) &&
              acc(slot(gv.hardware_ring_tx, i).hw_len) &&
              is_valid_data_len(slot(gv.hardware_ring_tx, i).hw_len) &&
              is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) @/
  /@ requires forall i: Int :: i in gv.tx_await_ack ==> forall x: Seq[Int] :: x in gv.tx_handled ==>
                |x| == 2 && x[0] != slot(gv.hardware_ring_tx, i).hw_addr @/
  /@ ensures acc(gv.eth_reg, 1/2) @/
  /@ ensures acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() &&
       acc(gv.hardware_ring_tx, 2/3) && acc(gv.tx_handled) @/
  /@ ensures forall i: Int :: i in old(gv.tx_await_ack) ==> acc(slot(gv.hardware_ring_tx, i).hw_stat, 2/3) @/
  /@ ensures forall i: Int :: i in old(gv.tx_await_ack) ==> element2_seq(
       old(slot(gv.hardware_ring_tx, i).hw_addr), old(slot(gv.hardware_ring_tx, i).hw_len)) in gv.tx_handled @/
  /@ ensures forall x: Seq[Int] :: x in old(gv.tx_handled) ==> x in gv.tx_handled @/
  /@ ensures forall x: Seq[Int] :: x in gv.tx_handled ==> x in old(gv.tx_handled) ||
               (|x| == 2 && exists i: Int :: 0 <= i && i < old(|gv.tx_await_ack|) &&
                  x == element2_seq(old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr),
                    old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len))) @/
  /@ ensures |gv.tx_handled| == |old(gv.tx_handled)| + |old(gv.tx_await_ack)| @/

  !st32 eth_reg + ETH_TDAR_OFF, TDAR_TDAR;
  return 0;
}

inline fun get_eir_status()
{
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/

  var eir = 0;
  !ld32 eir, eth_reg + ETH_EIR_OFF;
  return eir;
}

inline fun get_eir()
{
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/

  var 1 eir_full = get_eir_status();
  return eir_full & IRQ_MASK;
}

inline fun set_eir(1 eir)
{
  /@ requires (eir & IRQ_MASK) == eir @/
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/

  !st32 eth_reg + ETH_EIR_OFF, eir;
  // guide the SMT solver to refute false
  /@ assert eir == IRQ_MASK ==> (eir & IRQ_MASK) == eir @/
  return 0;
}

inline fun or_WRAP(1 x)
{
  /@ ensures bounded16(x) ==> bounded16(retval) @/
  /@ ensures bounded8(x) ==> bounded8(retval) @/
  /@ ensures retval == (x | WRAP_MASK) @/
  /@ ensures (retval | WRAP_MASK) == retval @/
  /@ ensures (x & RX_STAT_MASK) == 0 ==> (retval & RX_STAT_MASK) == 0 @/
  /@ ensures (x & TX_STAT_MASK) == 0 ==> (retval & TX_STAT_MASK) == 0 @/
  /@ ensures (x & RXD_EMPTY_MASK) != 0 ==> (retval & RXD_EMPTY_MASK) != 0 @/
  /@ ensures (x & TXD_READY_MASK) != 0 ==> (retval & TXD_READY_MASK) != 0 @/
  return x | WRAP_MASK;
}

inline fun rx_update_ring_slot(1 ring_addr, 1 idx, 1 phys, 1 len, 1 stat) {
  /@ requires is_valid_data_addr(phys) @/
  /@ requires is_valid_data_len(len) @/
  /@ requires is_valid_rx_stat(stat) && is_RXD_EMPTY(stat) && !is_WRAP(stat) @/
  /@ requires acc(gv.hw_rx_capacity, 1/2) && acc(gv.hw_rx_descr, 1/2) &&
              gv.hw_rx_capacity == QUEUE_CAPACITY &&
              gv.hw_rx_descr == HW_RING_RX_ADDR &&
              acc(gv.hardware_ring_rx, 2/3) &&
              acc(slot(gv.hardware_ring_rx, idx).hw_addr) &&
              acc(slot(gv.hardware_ring_rx, idx).hw_stat) &&
              acc(slot(gv.hardware_ring_rx, idx).hw_len) &&
              acc(slot(gv.hardware_ring_rx, idx).ghost_unprocessed, 2/3) &&
              !slot(gv.hardware_ring_rx, idx).ghost_unprocessed @/
  /@ requires acc(gv.rx_await_ack) @/
  /@ requires forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j] @/
  /@ requires 0 <= idx && idx < gv.hw_rx_capacity @/
  /@ ensures acc(gv.hw_rx_capacity, 1/2) && acc(gv.hw_rx_descr, 1/2) &&
             acc(gv.hardware_ring_rx, 2/3) &&
             acc(slot(gv.hardware_ring_rx, idx).hw_addr) &&
             acc(slot(gv.hardware_ring_rx, idx).hw_stat) &&
             acc(slot(gv.hardware_ring_rx, idx).hw_len) &&
             acc(slot(gv.hardware_ring_rx, idx).ghost_unprocessed, 2/3) @/
  /@ ensures slot(gv.hardware_ring_rx, idx).hw_addr == phys &&
             slot(gv.hardware_ring_rx, idx).hw_stat == (idx + 1 == gv.hw_rx_capacity ? old(stat) | WRAP_MASK : old(stat)) &&
             is_valid_rx_stat(slot(gv.hardware_ring_rx, idx).hw_stat) &&
             is_RXD_EMPTY(slot(gv.hardware_ring_rx, idx).hw_stat) &&
             slot(gv.hardware_ring_rx, idx).hw_len == len @/
  /@ ensures acc(gv.rx_await_ack) && idx in gv.rx_await_ack &&
             (idx in old(gv.rx_await_ack) ==> gv.rx_await_ack == old(gv.rx_await_ack)) &&
             (!(idx in old(gv.rx_await_ack)) ==> append_elem(gv.rx_await_ack, old(gv.rx_await_ack), idx)) @/
  /@ ensures forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j] @/
  /@ ensures old(|gv.rx_await_ack|) == 0 ==> |gv.rx_await_ack| == 1 @/

  var descr = hw_rx_descr + idx * DESCR_LEN;
  if (idx + 1 == hw_rx_capacity) {
    stat = or_WRAP(stat);
  }
  // help smt along
  /@ assert stat == (idx + 1 == gv.hw_rx_capacity ? old(stat) | WRAP_MASK : old(stat)) @/

  !st32 descr + DESCR_ADDR_OFF, phys;
  !st16 descr + DESCR_LEN_OFF, len;
  /* Ensure all writes to the descriptor complete, before we set the flags
   * that makes hardware aware of this slot.
   */
  THREAD_MEMORY_RELEASE()
  !st16 descr + DESCR_STAT_OFF, stat;
  return 0;
}

inline fun tx_update_ring_slot(1 ring_addr, 1 idx, 1 phys, 1 len, 1 stat) {
  /@ requires is_valid_data_addr(phys) @/
  /@ requires is_valid_data_len(len) @/
  /@ requires is_valid_tx_stat(stat) && is_TXD_READY(stat) && !is_WRAP(stat) @/
  /@ requires acc(gv.hw_tx_capacity, 1/2) && acc(gv.hw_tx_descr, 1/2) &&
              gv.hw_tx_capacity == QUEUE_CAPACITY &&
              gv.hw_tx_descr == HW_RING_TX_ADDR &&
              acc(gv.hardware_ring_tx, 2/3) &&
              acc(slot(gv.hardware_ring_tx, idx).hw_addr) &&
              acc(slot(gv.hardware_ring_tx, idx).hw_stat) &&
              acc(slot(gv.hardware_ring_tx, idx).hw_len) &&
              acc(slot(gv.hardware_ring_tx, idx).ghost_unprocessed, 2/3) &&
              !slot(gv.hardware_ring_tx, idx).ghost_unprocessed @/
  /@ requires acc(gv.tx_await_ack) @/
  /@ requires forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
                gv.tx_await_ack[i] != gv.tx_await_ack[j] @/
  /@ requires 0 <= idx && idx < gv.hw_tx_capacity @/
  /@ ensures acc(gv.hw_tx_capacity, 1/2) && acc(gv.hw_tx_descr, 1/2) &&
             acc(gv.hardware_ring_tx, 2/3) &&
             acc(slot(gv.hardware_ring_tx, idx).hw_addr) &&
             acc(slot(gv.hardware_ring_tx, idx).hw_stat) &&
             acc(slot(gv.hardware_ring_tx, idx).hw_len) &&
             acc(slot(gv.hardware_ring_tx, idx).ghost_unprocessed, 2/3) @/
  /@ ensures slot(gv.hardware_ring_tx, idx).hw_addr == phys &&
             slot(gv.hardware_ring_tx, idx).hw_stat == (idx + 1 == gv.hw_tx_capacity ? old(stat) | WRAP_MASK : old(stat)) &&
             is_valid_tx_stat(slot(gv.hardware_ring_tx, idx).hw_stat) &&
             is_TXD_READY(slot(gv.hardware_ring_tx, idx).hw_stat) &&
             slot(gv.hardware_ring_tx, idx).hw_len == len @/
  /@ ensures acc(gv.tx_await_ack) && idx in gv.tx_await_ack &&
             (idx in old(gv.tx_await_ack) ==> gv.tx_await_ack == old(gv.tx_await_ack)) &&
             (!(idx in old(gv.tx_await_ack)) ==> append_elem(gv.tx_await_ack, old(gv.tx_await_ack), idx)) @/
  /@ ensures forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
               gv.tx_await_ack[i] != gv.tx_await_ack[j] @/
  /@ ensures |gv.tx_await_ack| == |old(gv.tx_await_ack)| + 1 @/

  var descr = hw_tx_descr + idx * DESCR_LEN;
  if (idx + 1 == hw_tx_capacity) {
    stat = or_WRAP(stat);
  }
  // help smt along
  /@ assert stat == (idx + 1 == gv.hw_tx_capacity ? old(stat) | WRAP_MASK : old(stat)) @/

  !st32 descr + DESCR_ADDR_OFF, phys;
  !st16 descr + DESCR_LEN_OFF, len;
  /* Ensure all writes to the descriptor complete, before we set the flags
   * that makes hardware aware of this slot.
   */
  THREAD_MEMORY_RELEASE()
  !st16 descr + DESCR_STAT_OFF, stat;
  return 0;
}

#define disjoint_net_queue_removed_handled_rx() ( \
  (forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==> \
    !(slotq(gv.rx_free.net_descr, i).ndescr_addr in gv.rx_free.net_removed_addr)) && \
  (forall s: Seq[Int] :: s in gv.rx_handled ==> \
    |s| == 2 && forall j: Int :: gv.rx_free.net_head <= j && j < gv.rx_free.net_tail ==> \
      s[0] != slotq(gv.rx_free.net_descr, j).ndescr_addr) \
)

inline fun rx_provide_body() {
  /@ requires acc(gv.net_rx_free, 7/12) && gv.net_rx_free == RX_FREE_BASE && acc(gv.rx_free, 7/12) &&
               acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 7/12) &&
               acc(gv.net_rx_capacity, 7/12) && gv.net_rx_capacity == QUEUE_CAPACITY &&
               acc(gv.rx_free.net_signal) && acc(gv.rx_free.net_descr, 7/12) &&
               acc(gv.rx_free.net_removed_addr) &&
               0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
               forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
                 acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
                 acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
                 valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_consume(gv.rx_free) @/
  /@ requires acc(gv.hw_rx_ptr, 1/2) && bounded(gv.hw_rx_ptr) &&
               acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 7/12) && gv.hw_rx_capacity == 256 &&
               acc(gv.hw_rx_descr, 7/12) && acc(gv.hw_rx_head, 7/12) &&
               gv.hw_rx_descr == HW_RING_RX_ADDR @/
  /@ requires bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && gv.hw_rx_capacity == 256 @/
  /@ requires acc(gv.eth_reg, 7/12) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
  /@ requires valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
  /@ requires forall x: Int :: x in gv.rx_free.net_removed_addr ==> element2_seq(x, 0) in gv.rx_handled @/
  /@ requires forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
                 s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
  /@ requires disjoint_net_queue_removed_handled_rx() @/
  /@ requires (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity @/ // full == 0
  /@ requires gv.rx_free.net_tail != gv.rx_free.net_head @/ // empty == 0
  /@ ensures acc(gv.net_rx_free, 7/12) && gv.net_rx_free == RX_FREE_BASE && acc(gv.rx_free, 7/12) &&
               acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 7/12) &&
               acc(gv.net_rx_capacity, 7/12) && gv.net_rx_capacity == QUEUE_CAPACITY &&
               acc(gv.rx_free.net_signal) && acc(gv.rx_free.net_descr, 7/12) &&
               acc(gv.rx_free.net_removed_addr) &&
               0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
               forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
                 acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
                 acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
                 valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_consume(gv.rx_free) @/
  /@ ensures acc(gv.hw_rx_ptr, 1/2) && bounded(gv.hw_rx_ptr) &&
               acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 7/12) && gv.hw_rx_capacity == 256 &&
               acc(gv.hw_rx_descr, 7/12) && acc(gv.hw_rx_head, 7/12) &&
               gv.hw_rx_descr == HW_RING_RX_ADDR @/
  /@ ensures bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && gv.hw_rx_capacity == 256 @/
  /@ ensures acc(gv.eth_reg, 7/12) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
  /@ ensures valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
  /@ ensures forall x: Int :: x in gv.rx_free.net_removed_addr ==> element2_seq(x, 0) in gv.rx_handled @/
  /@ ensures forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
                 s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
  /@ ensures disjoint_net_queue_removed_handled_rx() @/
  /@ ensures |gv.rx_handled| == |old(gv.rx_handled)| + 1 @/
  /@ ensures gv.rx_free.net_head == old(gv.rx_free.net_head) + 1 @/
  /@ ensures gv.hw_rx_tail == (old(gv.hw_rx_tail) + 1) % (MAX_INT16 + 1) @/

  /@ unfold valid_hardware_ring_rx_write() @/

  var {1,1} buffer = net_dequeue(net_rx_free, net_rx_capacity);
  var idx = wrap_hw_rx_capacity(hw_rx_tail);

  var io_addr = buffer.0;
  rx_update_ring_slot(hw_rx_ptr, idx, io_addr, 0, RXD_EMPTY);

  var temp = wrap_int16(hw_rx_tail + 1);
  hw_rx_tail = temp;
  //st hw_rx_tail_slot, (hw_rx_tail + 1);
  set_rdar();

  /@ refute false @/
  /@ fold valid_hardware_ring_rx_write() @/
  return 0;
}

fun rx_provide()
{
  /@ requires acc(gv.net_rx_free, 2/3) && gv.net_rx_free == RX_FREE_BASE && acc(gv.rx_free, 2/3) &&
              acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail) &&
              acc(gv.net_rx_capacity, 2/3) && gv.net_rx_capacity == QUEUE_CAPACITY &&
              acc(gv.rx_free.net_signal) && acc(gv.rx_free.net_descr, 2/3) &&
              acc(gv.rx_free.net_removed_addr) &&
              0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
              forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
                acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
                acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
                valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
                valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_consume(gv.rx_free) @/
  /@ requires acc(gv.hw_rx_ptr, 1/2) && bounded(gv.hw_rx_ptr) &&
              acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
              acc(gv.hw_rx_descr, 2/3) && acc(gv.hw_rx_head, 2/3) &&
              gv.hw_rx_descr == HW_RING_RX_ADDR @/
  /@ requires bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) @/
  /@ requires acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
  /@ requires valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
  /@ requires gv.rx_free.net_removed_addr == empty_set() && gv.rx_handled == empty_set_seqint() @/
  /@ requires disjoint_net_queue_removed_handled_rx() @/
  /@ ensures acc(gv.net_rx_free, 2/3) && acc(gv.rx_free, 2/3) &&
             acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail) &&
             acc(gv.net_rx_capacity, 2/3) && acc(gv.rx_free.net_signal) &&
             acc(gv.rx_free.net_descr, 2/3) &&
             acc(gv.rx_free.net_removed_addr) &&
             0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
             forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
               acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
               acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
               valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
               valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_consume(gv.rx_free) @/
  /@ ensures acc(gv.hw_rx_ptr, 1/2) &&
             acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 2/3) &&
             acc(gv.hw_rx_descr, 2/3) && acc(gv.hw_rx_head, 2/3) @/
  /@ ensures bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && gv.hw_rx_capacity == 256 @/
  /@ ensures acc(gv.eth_reg, 2/3) @/
  /@ ensures acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
  /@ ensures valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
  // either the hardware ring is full, or the queue consumed is empty
  /@ ensures (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity ||
               (gv.rx_free.net_tail == gv.rx_free.net_head) @/
  // anything that was in the net queue and no longer is, is now in the hw queue, and v/v
  /@ ensures forall x: Int :: x in gv.rx_free.net_removed_addr ==> element2_seq(x, 0) in gv.rx_handled @/
  /@ ensures forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
               s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
  /@ ensures disjoint_net_queue_removed_handled_rx() @/
  /@ ensures (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity ||
               gv.rx_free.net_tail == gv.rx_free.net_head @/
  /@ ensures |gv.rx_handled| == gv.rx_free.net_head - old(gv.rx_free.net_head) @/
  /@ ensures |gv.rx_handled| >= (gv.hw_rx_tail - old(gv.hw_rx_tail)) % (MAX_INT16 + 1) @/
  /@ ensures gv.hw_rx_head == old(gv.hw_rx_head) @/ // assistance
  /@ ensures garbage_a() @/ // assistance
  /@ ensures old(gv.hw_rx_tail == gv.hw_rx_head) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity ==>
               (gv.hw_rx_tail - old(gv.hw_rx_tail)) % (MAX_INT16 + 1) > 0 @/ // actual property
  /@ ensures gv.rx_free.net_head >= old(gv.rx_free.net_head) && gv.rx_free.net_tail >= old(gv.rx_free.net_tail) @/ // assistance
  /@ ensures garbage_b() @/ // assistance
  /@ ensures old(gv.rx_free.net_tail != gv.rx_free.net_head) && gv.rx_free.net_tail == gv.rx_free.net_head ==>
               gv.rx_free.net_head - old(gv.rx_free.net_head) > 0 @/ // actual property
  /@ ensures old(gv.rx_free.net_tail != gv.rx_free.net_head && gv.hw_rx_tail == gv.hw_rx_head) ==>
         gv.rx_handled != empty_set_seqint() @/

  var reprocess = true;

  while (reprocess)
  {
    /@ invariant acc(gv.net_rx_free, 2/3) && gv.net_rx_free == RX_FREE_BASE && acc(gv.rx_free, 2/3) &&
                 acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail) &&
                 acc(gv.net_rx_capacity, 2/3) && gv.net_rx_capacity == QUEUE_CAPACITY &&
                 acc(gv.rx_free.net_signal) && acc(gv.rx_free.net_descr, 2/3) &&
                 acc(gv.rx_free.net_removed_addr) &&
                 0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
                 forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
                   acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
                   acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
                   valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
                   valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
    /@ invariant net_queue_injective_consume(gv.rx_free) @/
    /@ invariant acc(gv.hw_rx_ptr, 1/2) && bounded(gv.hw_rx_ptr) &&
                 acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
                 acc(gv.hw_rx_descr, 2/3) && acc(gv.hw_rx_head, 2/3) &&
                 gv.hw_rx_descr == HW_RING_RX_ADDR @/
    /@ invariant bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && gv.hw_rx_capacity == 256 @/
    /@ invariant acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
    /@ invariant acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
    /@ invariant forall x: Int :: x in gv.rx_free.net_removed_addr ==> element2_seq(x, 0) in gv.rx_handled @/
    /@ invariant forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
                   s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
    /@ invariant valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
    /@ invariant reprocess == false ==>
                   ((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity ||
                     gv.rx_free.net_tail == gv.rx_free.net_head) @/
    /@ invariant disjoint_net_queue_removed_handled_rx() @/
    /@ invariant gv.hw_rx_head == old(gv.hw_rx_head) @/
    /@ invariant gv.rx_free.net_head >= old(gv.rx_free.net_head) && gv.rx_free.net_tail >= old(gv.rx_free.net_tail) @/
    /@ invariant |gv.rx_handled| == gv.rx_free.net_head - old(gv.rx_free.net_head) @/
    /@ invariant |gv.rx_handled| >= (gv.hw_rx_tail - old(gv.hw_rx_tail)) % (MAX_INT16 + 1) @/
    /@ invariant reprocess == false ==> (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity ||
                   gv.rx_free.net_tail == gv.rx_free.net_head @/
    /@ invariant true @/

    var 1 full = rx_hw_ring_full();
    var 1 empty = net_queue_empty(net_rx_free);
    while ((!full + !empty) == 2)
    {
      /@ invariant acc(gv.net_rx_free, 2/3) && gv.net_rx_free == RX_FREE_BASE && acc(gv.rx_free, 2/3) &&
                   acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail) &&
                   acc(gv.net_rx_capacity, 2/3) && gv.net_rx_capacity == QUEUE_CAPACITY &&
                   acc(gv.rx_free.net_signal) && acc(gv.rx_free.net_descr, 2/3) &&
                   acc(gv.rx_free.net_removed_addr) &&
                   0 <= gv.rx_free.net_tail - gv.rx_free.net_head && gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
                   forall i: Int :: gv.rx_free.net_head <= i && i < gv.rx_free.net_tail ==>
                     acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) &&
                     acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
                     valid_net_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) &&
                     valid_net_len(slotq(gv.rx_free.net_descr, i).ndescr_len) @/
      /@ invariant net_queue_injective_consume(gv.rx_free) @/
      /@ invariant acc(gv.hw_rx_ptr, 1/2) && bounded(gv.hw_rx_ptr) &&
                   acc(gv.hw_rx_tail) && acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
                   acc(gv.hw_rx_descr, 2/3) && acc(gv.hw_rx_head, 2/3) &&
                   gv.hw_rx_descr == HW_RING_RX_ADDR @/
      /@ invariant bounded16(gv.hw_rx_tail) && bounded16(gv.hw_rx_head) && gv.hw_rx_capacity == 256 @/
      /@ invariant acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
      /@ invariant acc(gv.rx_await_ack) && gv.rx_await_ack == empty_seq() && acc(gv.rx_handled) @/
      /@ invariant valid_hardware_ring_rx_write() && valid_hardware_ring_rx_mdata_write() @/
      /@ invariant full == ((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == gv.hw_rx_capacity)  @/
      /@ invariant empty == (gv.rx_free.net_tail == gv.rx_free.net_head) @/
      /@ invariant forall x: Int :: x in gv.rx_free.net_removed_addr ==> element2_seq(x, 0) in gv.rx_handled @/
      /@ invariant forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
                   s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
      /@ invariant disjoint_net_queue_removed_handled_rx() @/
      /@ invariant gv.hw_rx_head == old(gv.hw_rx_head) @/
      /@ invariant gv.rx_free.net_head >= old(gv.rx_free.net_head) && gv.rx_free.net_tail >= old(gv.rx_free.net_tail) @/
      /@ invariant |gv.rx_handled| == gv.rx_free.net_head - old(gv.rx_free.net_head) @/
      /@ invariant |gv.rx_handled| >= (gv.hw_rx_tail - old(gv.hw_rx_tail)) % (MAX_INT16 + 1) @/
      /@ invariant true @/

      rx_provide_body();
      full = rx_hw_ring_full();
      empty = net_queue_empty(net_rx_free);
    }

    /* Only request a notification from virtualiser if HW ring not full */
    full = rx_hw_ring_full();
    if (!full) {
      net_request_signal(net_rx_free);
    } else {
      net_cancel_signal(net_rx_free);
    }
    reprocess = false;

    empty = net_queue_empty(net_rx_free);
    if ((!empty + !full) == 2) {
      net_cancel_signal(net_rx_free);
      reprocess = true;
    }
    /@ refute false @/
  }
  return 0;
}

inline fun wrap_hw_rx_capacity(1 x)
{
  /@ requires acc(gv.hw_rx_capacity, 1/2) && gv.hw_rx_capacity == 256 @/
  /@ ensures acc(gv.hw_rx_capacity, 1/2) && gv.hw_rx_capacity == 256 @/
  /@ ensures retval < gv.hw_rx_capacity @/
  /@ ensures retval == (x % gv.hw_rx_capacity) @/
  return x & (hw_rx_capacity - 1);
}

inline fun and_RXD_EMPTY(1 x)
{
  /@ ensures retval != 0 <==> (x & RXD_EMPTY_MASK) != 0 @/
  return x & RXD_EMPTY;
}

// i is between x and y in a ring
/@ function ring_between(i: Word, x: Word, y: Word): Bool {
    (x % 256 < y % 256 || y == x) ?
      i >= x % 256 && i < y % 256 :
      i >= x % 256 || i < y % 256
} @/

/*/@
function disjoint_device_unprocessed_net_added_rx(): Bool
  requires acc(gv.rx_active, wildcard) && acc(gv.rx_active.net_added, wildcard)
  requires acc(gv.hw_rx_tail, wildcard) && acc(gv.hw_rx_head, wildcard) &&
    acc(gv.hw_rx_capacity, wildcard) && gv.hw_rx_capacity == QUEUE_CAPACITY
  requires valid_hardware_ring_rx_read()
{
  unfolding valid_hardware_ring_rx_read() in
    forall s: Seq[Word] :: s in gv.rx_active.net_added ==>
      |s| == 2 &&
      forall i: Word :: 0 <= i && i < QUEUE_CAPACITY && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
        ((gv.hw_rx_tail % gv.hw_rx_capacity) <= (gv.hw_rx_head % gv.hw_rx_capacity)
          ? i < (gv.hw_rx_tail % gv.hw_rx_capacity) || i >= (gv.hw_rx_head % gv.hw_rx_capacity)
          : i < (gv.hw_rx_tail % gv.hw_rx_capacity) && i >= (gv.hw_rx_head % gv.hw_rx_capacity)) &&
         gv.hw_rx_head != gv.hw_rx_tail ==> s[0] != slot(gv.hardware_ring_rx, i).hw_addr
}
@/*/
#define disjoint_device_unprocessed_net_added_rx() ( \
  unfolding valid_hardware_ring_rx_read() in \
    forall s: Seq[Word] :: s in gv.rx_active.net_added ==> \
      |s| == 2 && \
      forall i: Word :: 0 <= i && i < QUEUE_CAPACITY && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) && \
        ((gv.hw_rx_tail % gv.hw_rx_capacity) <= (gv.hw_rx_head % gv.hw_rx_capacity) \
          ? i < (gv.hw_rx_tail % gv.hw_rx_capacity) || i >= (gv.hw_rx_head % gv.hw_rx_capacity) \
          : i < (gv.hw_rx_tail % gv.hw_rx_capacity) && i >= (gv.hw_rx_head % gv.hw_rx_capacity)) && \
         gv.hw_rx_head != gv.hw_rx_tail ==> s[0] != slot(gv.hardware_ring_rx, i).hw_addr \
)

/@ function X4(x: Int): Bool {
  true
} @/

inline fun {1,1,1} rx_return_body()
{
  /@ requires acc(gv.net_rx_active, 1/2) && gv.net_rx_active == RX_ACTIVE_BASE &&
               acc(gv.net_rx_capacity, 1/2) && gv.net_rx_capacity == QUEUE_CAPACITY &&
               acc(gv.rx_active, 2/3) &&
               acc(gv.rx_active.net_tail) &&
               acc(gv.rx_active.net_head, 2/3) &&
               acc(gv.rx_active.net_signal) && acc(gv.rx_active.net_added) &&
               acc(gv.rx_active.net_descr, 2/3) &&
               0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
               forall i : Int :: gv.rx_active.net_tail <= i && i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
                 acc(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                 acc(slotq(gv.rx_active.net_descr, i).ndescr_len) &&
                 valid_net_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.rx_active.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_produce(gv.rx_active) @/
  /@ requires acc(gv.hw_rx_head) && bounded16(gv.hw_rx_head) &&
               acc(gv.hw_rx_tail, 7/12) && bounded16(gv.hw_rx_tail) &&
               acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
               acc(gv.hw_rx_descr, 1/2) && gv.hw_rx_descr == HW_RING_RX_ADDR &&
               acc(gv.rx_processed) @/
  /@ requires valid_hardware_ring_rx_read() && valid_hardware_ring_rx_mdata_read() @/
  /@ requires disjoint_device_unprocessed_net_added_rx() @/
  /@ requires gv.hw_rx_tail != gv.hw_rx_head @/
  /@ requires gv.rx_processed == gv.rx_active.net_added @/
  /@ ensures acc(gv.net_rx_active, 1/2) && gv.net_rx_active == RX_ACTIVE_BASE &&
               acc(gv.net_rx_capacity, 1/2) && gv.net_rx_capacity == QUEUE_CAPACITY &&
               acc(gv.rx_active, 2/3) &&
               acc(gv.rx_active.net_tail) &&
               acc(gv.rx_active.net_head, 2/3) &&
               acc(gv.rx_active.net_signal) && acc(gv.rx_active.net_added) &&
               acc(gv.rx_active.net_descr, 2/3) &&
               0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
               gv.rx_active.net_head == old(gv.rx_active.net_head) &&
               forall i : Int :: gv.rx_active.net_tail <= i && i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
                 acc(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                 acc(slotq(gv.rx_active.net_descr, i).ndescr_len) &&
                 valid_net_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.rx_active.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_produce(gv.rx_active) @/
  /@ ensures acc(gv.hw_rx_head) && bounded16(gv.hw_rx_head) &&
               acc(gv.hw_rx_tail, 7/12) && bounded16(gv.hw_rx_tail) &&
               acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
               acc(gv.hw_rx_descr, 1/2) && gv.hw_rx_descr == HW_RING_RX_ADDR &&
               acc(gv.rx_processed) @/
  /@ ensures valid_hardware_ring_rx_read() && valid_hardware_ring_rx_mdata_read() @/
  /@ ensures retval.0 == 0 ==> retval.1 == (gv.hw_rx_tail == gv.hw_rx_head) @/
  /@ ensures unfolding valid_hardware_ring_rx_read() in
                 (retval.0 != 0) ==> is_RXD_EMPTY(slot(gv.hardware_ring_rx, gv.hw_rx_head % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures disjoint_device_unprocessed_net_added_rx() @/
  /@ ensures retval.0 == 0 ==> gv.rx_active.net_tail == old(gv.rx_active.net_tail) + 1 &&
               gv.hw_rx_head == (old(gv.hw_rx_head) + 1) % (MAX_INT16 + 1) @/
  /@ ensures retval.0 == 1 ==> gv.rx_active.net_tail == old(gv.rx_active.net_tail) && gv.hw_rx_head == old(gv.hw_rx_head) @/
  /@ ensures retval.0 == 1 ==> gv.rx_active.net_added == old(gv.rx_active.net_added) @/
  /@ ensures gv.rx_processed == gv.rx_active.net_added @/
  /@ ensures retval.0 == 0 ==> gv.rx_active.net_tail == old(gv.rx_active.net_tail) + 1 &&
               gv.hw_rx_head == (old(gv.hw_rx_head) + 1) % (MAX_INT16 + 1) &&
               |gv.rx_processed| == |old(gv.rx_processed)| + 1 @/
  /@ ensures retval.0 != 0 ==> gv.rx_active.net_tail == old(gv.rx_active.net_tail) &&
               gv.hw_rx_head == old(gv.hw_rx_head) &&
               gv.rx_processed == old(gv.rx_processed) @/
  /@ ensures !is_RXD_EMPTY(old(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, old(gv.hw_rx_head) % QUEUE_CAPACITY).hw_stat)) ==>
               !is_RXD_EMPTY(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, old(gv.hw_rx_head) % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures forall i: Int :: X4(i) && 0 <= i && i < QUEUE_CAPACITY && i != old(gv.hw_rx_head) % QUEUE_CAPACITY ==>
               old(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, i).hw_stat) ==
                 unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, i).hw_stat @/

  /@ unfold valid_hardware_ring_rx_read() @/
  /@ label l @/
  /* If buffer slot is still empty, we have processed all packets the device has filled */
  var idx = wrap_hw_rx_capacity(hw_rx_head);
  var dscr_addr = hw_rx_descr + idx * DESCR_LEN;
  var stat = 0;
  var empty = 0;
  var packets_transferred = 0;
  var reached_empty = 0;
  !ld16 stat, dscr_addr + DESCR_STAT_OFF;
  if (!(stat & RXD_EMPTY)) {
    THREAD_MEMORY_ACQUIRE()
    var len = 0;
    !ld16 len, dscr_addr;
    var io_addr = 0;
    !ld32 io_addr, dscr_addr + DESCR_ADDR_OFF;
    // the following should be provable with more work
    /@ inhale (gv.rx_active.net_tail - gv.rx_active.net_head) % (MAX_INT16 + 1) != QUEUE_CAPACITY @/
    /@ assert io_addr == slot(gv.hardware_ring_rx, idx).hw_addr @/
    /@ assert len == slot(gv.hardware_ring_rx, idx).hw_len @/
    net_enqueue(net_rx_active, io_addr, len, net_rx_capacity);
    /@ call rx_set_descr_processed(idx) @/
    var temp = wrap_int16(hw_rx_head + 1);
    hw_rx_head = temp;
    //st hw_rx_head_slot, (hw_rx_head + 1);
    empty = rx_hw_ring_empty();
    packets_transferred = true;
  } else {
    reached_empty = 1;
  }
  /@ refute false @/
  /@ assert forall i: Int :: 0 <= i && i < QUEUE_CAPACITY && i != old(gv.hw_rx_head) % QUEUE_CAPACITY ==>
              old[l](slot(gv.hardware_ring_rx, i).hw_stat) == slot(gv.hardware_ring_rx, i).hw_stat @/
  /@ assert forall i: Int :: { X4(i) } X4(i) && 0 <= i && i < QUEUE_CAPACITY && i != old(gv.hw_rx_head) % QUEUE_CAPACITY ==>
              old[l](slot(gv.hardware_ring_rx, i).hw_stat) ==
                old(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, i).hw_stat) @/
  /@ fold valid_hardware_ring_rx_read() @/
  /@ assert forall i: Int :: { X4(i) } X4(i) && 0 <= i && i < QUEUE_CAPACITY && i != old(gv.hw_rx_head) % QUEUE_CAPACITY ==>
              old(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, i).hw_stat) ==
                unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, i).hw_stat @/

  return <reached_empty, empty, packets_transferred>;
}

fun rx_return()
{
  /@ requires acc(gv.net_rx_active, 1/2) && gv.net_rx_active == RX_ACTIVE_BASE &&
              acc(gv.net_rx_capacity, 1/2) && gv.net_rx_capacity == QUEUE_CAPACITY &&
              acc(gv.rx_active, 2/3) &&
              acc(gv.rx_active.net_tail) &&
              acc(gv.rx_active.net_head, 2/3) &&
              acc(gv.rx_active.net_signal) && acc(gv.rx_active.net_added) &&
              acc(gv.rx_active.net_descr, 2/3) &&
              0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
              forall i : Int :: gv.rx_active.net_tail <= i && i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
                acc(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                acc(slotq(gv.rx_active.net_descr, i).ndescr_len) &&
                valid_net_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                valid_net_len(slotq(gv.rx_active.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_produce(gv.rx_active) @/
  /@ requires acc(gv.hw_rx_head) && bounded16(gv.hw_rx_head) &&
              acc(gv.hw_rx_tail, 2/3) && bounded16(gv.hw_rx_tail) &&
              acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
              acc(gv.hw_rx_descr, 1/2) && gv.hw_rx_descr == HW_RING_RX_ADDR &&
              acc(gv.rx_processed) @/
  /@ requires acc(gv.rx_ch, 1/4) @/
  /@ requires valid_hardware_ring_rx_read() && valid_hardware_ring_rx_mdata_read() @/
  /@ requires disjoint_device_unprocessed_net_added_rx() @/
  /@ requires gv.rx_active.net_added == empty_set_seqint() && gv.rx_processed == empty_set_seqint() @/
  /@ ensures acc(gv.net_rx_active, 1/2) && gv.net_rx_active == RX_ACTIVE_BASE &&
             acc(gv.net_rx_capacity, 1/2) && gv.net_rx_capacity == QUEUE_CAPACITY &&
             acc(gv.rx_active, 2/3) &&
             acc(gv.rx_active.net_tail) &&
             acc(gv.rx_active.net_head, 2/3) && acc(gv.rx_active.net_signal) &&
             acc(gv.rx_active.net_added) && acc(gv.rx_active.net_descr, 2/3) &&
             0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
             forall i : Int :: gv.rx_active.net_tail <= i && i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
               acc(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
               acc(slotq(gv.rx_active.net_descr, i).ndescr_len) &&
               valid_net_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
               valid_net_len(slotq(gv.rx_active.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_produce(gv.rx_active) @/
  /@ ensures acc(gv.hw_rx_head) && bounded16(gv.hw_rx_head) && acc(gv.hw_rx_tail, 2/3) &&
             acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 && acc(gv.hw_rx_descr, 1/2) &&
             acc(gv.rx_processed) @/
  /@ ensures acc(gv.rx_ch, 1/4) @/
  /@ ensures valid_hardware_ring_rx_read() && valid_hardware_ring_rx_mdata_read() @/
  /@ ensures disjoint_device_unprocessed_net_added_rx() @/
  // either the hw rx queue is empty, or the device is mid flight
  /@ ensures gv.hw_rx_tail == gv.hw_rx_head ||
               unfolding valid_hardware_ring_rx_read() in
                 is_RXD_EMPTY(slot(gv.hardware_ring_rx, gv.hw_rx_head % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures gv.rx_active.net_added == gv.rx_processed @/
  /@ ensures garbage_c2() @/
  /@ ensures old((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == QUEUE_CAPACITY) &&
               gv.hw_rx_tail == gv.hw_rx_head ==> (gv.hw_rx_head - old(gv.hw_rx_head)) % (MAX_INT16 + 1) > 0 @/
  /@ ensures old((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) == QUEUE_CAPACITY &&
               (unfolding valid_hardware_ring_rx_read() in
                 forall i: Int :: 0 <= i && i < QUEUE_CAPACITY ==> !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat))) ==>
               gv.rx_processed != empty_set_seqint() @/

  var packets_transferred = false;

  var 1 empty = rx_hw_ring_empty();
  var reached_empty = 0;
  var it = 0;
  while ((!empty + !reached_empty) == 2)
  {
    /@ invariant acc(gv.net_rx_active, 1/2) && gv.net_rx_active == RX_ACTIVE_BASE &&
                 acc(gv.net_rx_capacity, 1/2) && gv.net_rx_capacity == QUEUE_CAPACITY &&
                 acc(gv.rx_active, 2/3) &&
                 acc(gv.rx_active.net_tail) &&
                 acc(gv.rx_active.net_head, 2/3) &&
                 acc(gv.rx_active.net_signal) && acc(gv.rx_active.net_added) &&
                 acc(gv.rx_active.net_descr, 2/3) &&
                 0 <= gv.rx_active.net_tail - gv.rx_active.net_head && gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
                 forall i : Int :: gv.rx_active.net_tail <= i && i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
                   acc(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                   acc(slotq(gv.rx_active.net_descr, i).ndescr_len) &&
                   valid_net_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) &&
                   valid_net_len(slotq(gv.rx_active.net_descr, i).ndescr_len) @/
    /@ invariant net_queue_injective_produce(gv.rx_active) @/
    /@ invariant acc(gv.hw_rx_head) && bounded16(gv.hw_rx_head) &&
                 acc(gv.hw_rx_tail, 2/3) && bounded16(gv.hw_rx_tail) &&
                 acc(gv.hw_rx_capacity, 2/3) && gv.hw_rx_capacity == 256 &&
                 acc(gv.hw_rx_descr, 1/2) && gv.hw_rx_descr == HW_RING_RX_ADDR &&
                 acc(gv.rx_processed) @/
    /@ invariant valid_hardware_ring_rx_read() && valid_hardware_ring_rx_mdata_read() @/
    /@ invariant empty == (gv.hw_rx_tail == gv.hw_rx_head) @/
    /@ invariant unfolding valid_hardware_ring_rx_read() in
                   (reached_empty != 0) ==> is_RXD_EMPTY(slot(gv.hardware_ring_rx, gv.hw_rx_head % QUEUE_CAPACITY).hw_stat) @/
    /@ invariant disjoint_device_unprocessed_net_added_rx() @/
    /@ invariant gv.rx_active.net_tail - old(gv.rx_active.net_tail) == (gv.hw_rx_head - old(gv.hw_rx_head)) % (MAX_INT16 + 1) @/
    /@ invariant gv.hw_rx_tail == old(gv.hw_rx_tail) &&
                   0 <= (gv.hw_rx_tail - old(gv.hw_rx_head)) % (MAX_INT16 + 1) && (gv.hw_rx_tail - old(gv.hw_rx_head)) % (MAX_INT16 + 1) <= QUEUE_CAPACITY @/
    /@ invariant 0 <= (gv.hw_rx_head - old(gv.hw_rx_head)) % (MAX_INT16 + 1) && (gv.hw_rx_head - old(gv.hw_rx_head)) % (MAX_INT16 + 1) <= QUEUE_CAPACITY @/
    /@ invariant gv.rx_processed == gv.rx_active.net_added @/
    /@ invariant |gv.rx_processed| >= (gv.hw_rx_head - old(gv.hw_rx_head)) % (MAX_INT16 + 1) @/
    /@ invariant gv.rx_processed == empty_set_seqint() ==> gv.hw_rx_head == old(gv.hw_rx_head) @/
    /@ invariant !is_RXD_EMPTY(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, old(gv.hw_rx_head) % QUEUE_CAPACITY).hw_stat) &&
                   reached_empty ==> gv.rx_processed != empty_set_seqint() @/
    /@ invariant !is_RXD_EMPTY(old(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, old(gv.hw_rx_head) % QUEUE_CAPACITY).hw_stat)) ==>
                   !is_RXD_EMPTY(unfolding valid_hardware_ring_rx_read() in slot(gv.hardware_ring_rx, old(gv.hw_rx_head) % QUEUE_CAPACITY).hw_stat) @/
    /@ invariant true @/

    var {1,1,1} ret = rx_return_body();
    reached_empty = ret.0;
    if (!reached_empty) {
      empty = ret.1;
      packets_transferred = ret.2;
    }
  }
  /@ refute false @/

  var 1 to_signal = net_require_signal(net_rx_active, net_rx_capacity);
  if (!!packets_transferred + !!to_signal == 2) {
    net_cancel_signal(net_rx_active);
    microkit_notify(rx_ch);
  }

  return 0;
}

#define disjoint_net_queue_removed_handled_tx() ( \
  (forall i: Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==> \
    forall x: Seq[Int] :: x in gv.tx_active.net_removed ==> |x| == 2 && \
      x[0] != slotq(gv.tx_active.net_descr, i).ndescr_addr) && \
  (forall j: Int :: gv.tx_active.net_head <= j && j < gv.tx_active.net_tail ==> \
    forall y: Seq[Int] :: y in gv.tx_handled ==> |y| == 2 && \
      y[0] != slotq(gv.tx_active.net_descr, j).ndescr_addr) \
)

inline fun tx_provide_body()
{
  /@ requires acc(gv.net_tx_active, 7/12) && gv.net_tx_active == TX_ACTIVE_BASE && acc(gv.tx_active, 7/12) &&
               acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 7/12) &&
               acc(gv.net_tx_capacity, 7/12) && gv.net_tx_capacity == QUEUE_CAPACITY &&
               acc(gv.tx_active.net_signal) && acc(gv.tx_active.net_descr, 7/12) &&
               acc(gv.tx_active.net_removed) &&
               0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
               forall i: Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
                 acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
                 acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
                 valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_consume(gv.tx_active) @/
  /@ requires acc(gv.hw_tx_ptr, 1/2) && bounded(gv.hw_tx_ptr) &&
               acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 7/12) && gv.hw_tx_capacity == 256 &&
               acc(gv.hw_tx_descr, 7/12) && acc(gv.hw_tx_head, 7/12) &&
               gv.hw_tx_descr == HW_RING_TX_ADDR @/
  /@ requires bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && gv.hw_tx_capacity == 256 @/
  /@ requires acc(gv.eth_reg, 7/12) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
  /@ requires valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
  /@ requires forall x: Seq[Int] :: x in gv.tx_active.net_removed ==> x in gv.tx_handled @/
  /@ requires forall x: Seq[Int] :: x in gv.tx_handled ==> x in gv.tx_active.net_removed @/
  /@ requires disjoint_net_queue_removed_handled_tx() @/
  /@ requires (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity @/ // full == 0
  /@ requires gv.tx_active.net_tail != gv.tx_active.net_head @/ // empty == 0
  /@ ensures acc(gv.net_tx_active, 7/12) && gv.net_tx_active == TX_ACTIVE_BASE && acc(gv.tx_active, 7/12) &&
               acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 7/12) &&
               acc(gv.net_tx_capacity, 7/12) && gv.net_tx_capacity == QUEUE_CAPACITY &&
               acc(gv.tx_active.net_signal) && acc(gv.tx_active.net_descr, 7/12) &&
               acc(gv.tx_active.net_removed) &&
               0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
               forall i: Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
                 acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
                 acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
                 valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_consume(gv.tx_active) @/
  /@ ensures acc(gv.hw_tx_ptr, 1/2) && bounded(gv.hw_tx_ptr) &&
               acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 7/12) && gv.hw_tx_capacity == 256 &&
               acc(gv.hw_tx_descr, 7/12) && acc(gv.hw_tx_head, 7/12) &&
               gv.hw_tx_descr == HW_RING_TX_ADDR @/
  /@ ensures bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && gv.hw_tx_capacity == 256 @/
  /@ ensures acc(gv.eth_reg, 7/12) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
  /@ ensures valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
  /@ ensures forall x: Seq[Int] :: x in gv.tx_active.net_removed ==> x in gv.tx_handled @/
  /@ ensures forall x: Seq[Int] :: x in gv.tx_handled ==> x in gv.tx_active.net_removed @/
  /@ ensures disjoint_net_queue_removed_handled_tx() @/
  /@ ensures |gv.tx_handled| == |old(gv.tx_handled)| + 1 @/
  /@ ensures gv.tx_active.net_head == old(gv.tx_active.net_head) + 1 @/
  /@ ensures gv.hw_tx_tail == (old(gv.hw_tx_tail) + 1) % (MAX_INT16 + 1) @/

  /@ unfold valid_hardware_ring_tx_write() @/

  var {1,1} buffer = net_dequeue(net_tx_active, net_tx_capacity);
  var idx = wrap_hw_tx_capacity(hw_tx_tail);

  var io_addr = buffer.0;
  var len = buffer.1;
  var stat = TXD_READY | TXD_ADDCRC | TXD_LAST;
  tx_update_ring_slot(hw_tx_ptr, idx, io_addr, len, stat);

  var temp = wrap_int16(hw_tx_tail + 1);
  hw_tx_tail = temp;
  //st hw_tx_tail_slot, (hw_tx_tail + 1);
  set_tdar();

  /@ refute false @/
  /@ fold valid_hardware_ring_tx_write() @/
  return 0;
}

fun tx_provide()
{
  /@ requires acc(gv.net_tx_active, 2/3) && gv.net_tx_active == TX_ACTIVE_BASE && acc(gv.tx_active, 2/3) &&
              acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail) &&
              acc(gv.net_tx_capacity, 2/3) && gv.net_tx_capacity == QUEUE_CAPACITY &&
              acc(gv.tx_active.net_signal) && acc(gv.tx_active.net_descr, 2/3) &&
              acc(gv.tx_active.net_removed) &&
              0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
              forall i : Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
                acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
                acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
                valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
                valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_consume(gv.tx_active) @/
  /@ requires acc(gv.hw_tx_ptr, 1/2) && bounded(gv.hw_tx_ptr) &&
              acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 &&
              acc(gv.hw_tx_descr, 2/3) && acc(gv.hw_tx_head, 2/3) &&
              gv.hw_tx_descr == HW_RING_TX_ADDR @/
  /@ requires bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) @/
  /@ requires acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
  /@ requires acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
  /@ requires valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
  /@ requires gv.tx_active.net_removed == empty_set_seqint() && gv.tx_handled == empty_set_seqint() @/
  /@ requires disjoint_net_queue_removed_handled_tx() @/
  /@ ensures acc(gv.net_tx_active, 2/3) && acc(gv.tx_active, 2/3) &&
             acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail) &&
             acc(gv.net_tx_capacity, 2/3) && acc(gv.tx_active.net_signal) &&
             acc(gv.tx_active.net_descr, 2/3) && acc(gv.tx_active.net_removed) &&
             0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
             forall i: Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
               acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
               acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
               valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
               valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_consume(gv.tx_active) @/
  /@ ensures acc(gv.hw_tx_ptr, 1/2) &&
             acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 2/3) && acc(gv.hw_tx_descr, 2/3) &&
             acc(gv.hw_tx_head, 2/3) @/
  /@ ensures bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && gv.hw_tx_capacity == 256 @/
  /@ ensures acc(gv.eth_reg, 2/3) @/
  /@ ensures acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
  /@ ensures valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
  // either the hardware ring is full, or the queue consumed is empty
  /@ ensures (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity ||
               (gv.tx_active.net_tail == gv.tx_active.net_head) @/
  // anything that was in the net queue and no longer is, is now in the hw queue and v/v
  /@ ensures gv.tx_active.net_removed == gv.tx_handled @/
  /@ ensures disjoint_net_queue_removed_handled_tx() @/
  /@ ensures (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity ||
               gv.tx_active.net_tail == gv.tx_active.net_head @/
  /@ ensures |gv.tx_handled| == gv.tx_active.net_head - old(gv.tx_active.net_head) @/
  /@ ensures |gv.tx_handled| >= (gv.hw_tx_tail - old(gv.hw_tx_tail)) % (MAX_INT16 + 1) @/
  /@ ensures garbage_a2() @/ // assistance
  /@ ensures old(gv.hw_tx_tail == gv.hw_tx_head) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity ==>
       (gv.hw_tx_tail - old(gv.hw_tx_tail)) % (MAX_INT16 + 1) > 0 @/ // actual property
  /@ ensures gv.tx_active.net_head >= old(gv.tx_active.net_head) && gv.tx_active.net_tail >= old(gv.tx_active.net_tail) @/ // assistance
  /@ ensures garbage_b2() @/ // assistance
  /@ ensures old(gv.tx_active.net_tail != gv.tx_active.net_head) && gv.tx_active.net_tail == gv.tx_active.net_head ==>
       gv.tx_active.net_head - old(gv.tx_active.net_head) > 0 @/ // actual property
  /@ ensures old(gv.tx_active.net_tail != gv.tx_active.net_head && gv.hw_tx_tail == gv.hw_tx_head) ==>
       gv.tx_handled != empty_set_seqint() @/

  var reprocess = true;

  while (reprocess)
  {
    /@ invariant acc(gv.net_tx_active, 2/3) && gv.net_tx_active == TX_ACTIVE_BASE && acc(gv.tx_active, 2/3) &&
                 acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail) &&
                 acc(gv.net_tx_capacity, 2/3) && gv.net_tx_capacity == QUEUE_CAPACITY &&
                 acc(gv.tx_active.net_signal) && acc(gv.tx_active.net_descr, 2/3) &&
                 acc(gv.tx_active.net_removed) &&
                 0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
                 forall i : Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
                   acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
                   acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
                   valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
                   valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
    /@ invariant net_queue_injective_consume(gv.tx_active) @/
    /@ invariant acc(gv.hw_tx_ptr, 1/2) && bounded(gv.hw_tx_ptr) &&
                 acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 &&
                 acc(gv.hw_tx_descr, 2/3) && acc(gv.hw_tx_head, 2/3) &&
                 gv.hw_tx_descr == HW_RING_TX_ADDR @/
    /@ invariant bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && gv.hw_tx_capacity == 256 @/
    /@ invariant acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
    /@ invariant acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
    /@ invariant gv.tx_active.net_removed == gv.tx_handled @/
    /@ invariant valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
    /@ invariant reprocess == false ==>
                   ((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity ||
                     gv.tx_active.net_tail == gv.tx_active.net_head) @/
    /@ invariant disjoint_net_queue_removed_handled_tx() @/
    /@ invariant gv.hw_tx_head == old(gv.hw_tx_head) @/
    /@ invariant gv.tx_active.net_head >= old(gv.tx_active.net_head) && gv.tx_active.net_tail >= old(gv.tx_active.net_tail) @/
    /@ invariant |gv.tx_handled| == gv.tx_active.net_head - old(gv.tx_active.net_head) @/
    /@ invariant |gv.tx_handled| >= (gv.hw_tx_tail - old(gv.hw_tx_tail)) % (MAX_INT16 + 1) @/
    /@ invariant reprocess == false ==> (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity ||
                   gv.tx_active.net_tail == gv.tx_active.net_head @/

    var 1 full = tx_hw_ring_full();
    var 1 empty = net_queue_empty(net_tx_active);
    // see same comment in rx_provide
    while ((!full + !empty) == 2)
    {
      /@ invariant acc(gv.net_tx_active, 2/3) && gv.net_tx_active == TX_ACTIVE_BASE && acc(gv.tx_active, 2/3) &&
                   acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail) &&
                   acc(gv.net_tx_capacity, 2/3) && gv.net_tx_capacity == QUEUE_CAPACITY &&
                   acc(gv.tx_active.net_signal) && acc(gv.tx_active.net_descr, 2/3) &&
                   acc(gv.tx_active.net_removed) &&
                   0 <= gv.tx_active.net_tail - gv.tx_active.net_head && gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
                   forall i: Int :: gv.tx_active.net_head <= i && i < gv.tx_active.net_tail ==>
                     acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 2/3) &&
                     acc(slotq(gv.tx_active.net_descr, i).ndescr_len, 2/3) &&
                     valid_net_addr(slotq(gv.tx_active.net_descr, i).ndescr_addr) &&
                     valid_net_len(slotq(gv.tx_active.net_descr, i).ndescr_len) @/
      /@ invariant net_queue_injective_consume(gv.tx_active) @/
      /@ invariant acc(gv.hw_tx_ptr, 1/2) && bounded(gv.hw_tx_ptr) &&
                   acc(gv.hw_tx_tail) && acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 &&
                   acc(gv.hw_tx_descr, 2/3) && acc(gv.hw_tx_head, 2/3) &&
                   gv.hw_tx_descr == HW_RING_TX_ADDR @/
      /@ invariant bounded16(gv.hw_tx_tail) && bounded16(gv.hw_tx_head) && gv.hw_tx_capacity == 256 @/
      /@ invariant acc(gv.eth_reg, 2/3) && gv.eth_reg == HW_ETH_BASE @/
      /@ invariant acc(gv.tx_await_ack) && gv.tx_await_ack == empty_seq() && acc(gv.tx_handled) @/
      /@ invariant valid_hardware_ring_tx_write() && valid_hardware_ring_tx_mdata_write() @/
      /@ invariant full == ((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == gv.hw_tx_capacity) @/
      /@ invariant empty == (gv.tx_active.net_tail == gv.tx_active.net_head) @/
      /@ invariant forall x: Seq[Int] :: x in gv.tx_active.net_removed ==> x in gv.tx_handled @/
      /@ invariant forall x: Seq[Int] :: x in gv.tx_handled ==> x in gv.tx_active.net_removed @/
      /@ invariant disjoint_net_queue_removed_handled_tx() @/
      /@ invariant gv.hw_tx_head == old(gv.hw_tx_head) @/
      /@ invariant gv.tx_active.net_head >= old(gv.tx_active.net_head) && gv.tx_active.net_tail >= old(gv.tx_active.net_tail) @/
      /@ invariant |gv.tx_handled| == gv.tx_active.net_head - old(gv.tx_active.net_head) @/
      /@ invariant |gv.tx_handled| >= (gv.hw_tx_tail - old(gv.hw_tx_tail)) % (MAX_INT16 + 1) @/

      tx_provide_body();

      full = tx_hw_ring_full();
      empty = net_queue_empty(net_tx_active);
    }

    net_request_signal(net_tx_active);
    reprocess = false;

    full = tx_hw_ring_full();
    empty = net_queue_empty(net_tx_active);
    if (!empty + !full == 2) {
      net_cancel_signal(net_tx_active);
      reprocess = true;
    }
  }
  return 0;
}

inline fun wrap_hw_tx_capacity(1 x)
{
  /@ requires acc(gv.hw_tx_capacity, 1/2) && gv.hw_tx_capacity == 256 @/
  /@ ensures acc(gv.hw_tx_capacity, 1/2) && gv.hw_tx_capacity == 256 @/
  /@ ensures retval < gv.hw_tx_capacity @/
  /@ ensures retval == (x % gv.hw_tx_capacity) @/
  return x & (hw_tx_capacity - 1);
}

/*/@
function disjoint_device_unprocessed_net_added_tx(): Bool
  requires acc(gv.tx_free, wildcard) && acc(gv.tx_free.net_added, wildcard)
  requires acc(gv.hw_tx_tail, wildcard) && acc(gv.hw_tx_head, wildcard) &&
    acc(gv.hw_tx_capacity, wildcard) && gv.hw_tx_capacity == QUEUE_CAPACITY
  requires valid_hardware_ring_tx_read()
  requires true
{
  unfolding valid_hardware_ring_tx_read() in
    forall s: Seq[Word] :: s in gv.tx_free.net_added ==>
      |s| == 2 &&
      forall i: Word :: 0 <= i && i < QUEUE_CAPACITY && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) &&
        ((gv.hw_tx_tail % gv.hw_tx_capacity) <= (gv.hw_tx_head % gv.hw_tx_capacity)
          ? i < (gv.hw_tx_tail % gv.hw_tx_capacity) || i >= (gv.hw_tx_head % gv.hw_tx_capacity)
          : i < (gv.hw_tx_tail % gv.hw_tx_capacity) && i >= (gv.hw_tx_head % gv.hw_tx_capacity)) &&
         gv.hw_tx_head != gv.hw_tx_tail ==> s[0] != slot(gv.hardware_ring_tx, i).hw_addr
}
@/*/
#define disjoint_device_unprocessed_net_added_tx() ( \
  unfolding valid_hardware_ring_tx_read() in \
    forall s: Seq[Word] :: s in gv.tx_free.net_added ==> \
      |s| == 2 && \
      forall i: Word :: 0 <= i && i < QUEUE_CAPACITY && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) && \
        ((gv.hw_tx_tail % gv.hw_tx_capacity) <= (gv.hw_tx_head % gv.hw_tx_capacity) \
          ? i < (gv.hw_tx_tail % gv.hw_tx_capacity) || i >= (gv.hw_tx_head % gv.hw_tx_capacity) \
          : i < (gv.hw_tx_tail % gv.hw_tx_capacity) && i >= (gv.hw_tx_head % gv.hw_tx_capacity)) && \
         gv.hw_tx_head != gv.hw_tx_tail ==> s[0] != slot(gv.hardware_ring_tx, i).hw_addr \
)

/@ function X3(i: Int): Bool {
  true
} @/

inline fun {1,1,1} tx_return_body()
{
  /@ requires acc(gv.net_tx_free, 5/12) && gv.net_tx_free == TX_FREE_BASE &&
               acc(gv.net_tx_capacity, 5/12) && gv.net_tx_capacity == QUEUE_CAPACITY &&
               acc(gv.tx_free, 7/12) &&
               acc(gv.tx_free.net_tail) &&
               acc(gv.tx_free.net_head, 7/12) &&
               acc(gv.tx_free.net_signal) && acc(gv.tx_free.net_added) &&
               acc(gv.tx_free.net_descr, 7/12) &&
               0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
               forall i : Int :: gv.tx_free.net_tail <= i && i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
                 acc(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                 acc(slotq(gv.tx_free.net_descr, i).ndescr_len) &&
                 valid_net_addr(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.tx_free.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_produce(gv.tx_free) @/
  /@ requires acc(gv.hw_tx_head) && bounded16(gv.hw_tx_head) &&
               acc(gv.hw_tx_tail, 7/12) && bounded16(gv.hw_tx_tail) &&
               acc(gv.hw_tx_capacity, 7/12) && gv.hw_tx_capacity == 256 &&
               acc(gv.hw_tx_descr, 5/12) && gv.hw_tx_descr == HW_RING_TX_ADDR &&
               acc(gv.tx_processed) @/
  /@ requires valid_hardware_ring_tx_read() && valid_hardware_ring_tx_mdata_read() @/
  /@ requires disjoint_device_unprocessed_net_added_tx() @/
  /@ requires gv.hw_tx_tail != gv.hw_tx_head @/
  /@ requires forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
  /@ requires forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
               s[0] in gv.tx_processed @/
  /@ ensures acc(gv.net_tx_free, 5/12) && gv.net_tx_free == TX_FREE_BASE &&
               acc(gv.net_tx_capacity, 5/12) && gv.net_tx_capacity == QUEUE_CAPACITY &&
               acc(gv.tx_free, 7/12) &&
               acc(gv.tx_free.net_tail) &&
               acc(gv.tx_free.net_head, 7/12) &&
               acc(gv.tx_free.net_signal) && acc(gv.tx_free.net_added) &&
               acc(gv.tx_free.net_descr, 7/12) &&
               0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
               gv.tx_free.net_head == old(gv.tx_free.net_head) &&
               forall i : Int :: gv.tx_free.net_tail <= i && i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
                 acc(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                 acc(slotq(gv.tx_free.net_descr, i).ndescr_len) &&
                 valid_net_addr(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                 valid_net_len(slotq(gv.tx_free.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_produce(gv.tx_free) @/
  /@ ensures acc(gv.hw_tx_head) && bounded16(gv.hw_tx_head) &&
               acc(gv.hw_tx_tail, 7/12) && bounded16(gv.hw_tx_tail) &&
               acc(gv.hw_tx_capacity, 7/12) && gv.hw_tx_capacity == 256 &&
               acc(gv.hw_tx_descr, 5/12) && gv.hw_tx_descr == HW_RING_TX_ADDR &&
               acc(gv.tx_processed) @/
  /@ ensures valid_hardware_ring_tx_read() && valid_hardware_ring_tx_mdata_read() @/
  /@ ensures disjoint_device_unprocessed_net_added_tx() @/
  /@ ensures retval.0 == 0 ==> retval.1 == (gv.hw_tx_tail == gv.hw_tx_head) @/
  /@ ensures retval.0 == 0 ==> gv.tx_free.net_tail == old(gv.tx_free.net_tail) + 1 &&
               gv.hw_tx_head == (old(gv.hw_tx_head) + 1) % (MAX_INT16 + 1) @/
  /@ ensures retval.0 != 0 ==> gv.tx_free.net_tail == old(gv.tx_free.net_tail) && gv.hw_tx_head == old(gv.hw_tx_head) @/
  /@ ensures unfolding valid_hardware_ring_tx_read() in
                 (retval.0 != 0) ==> is_TXD_READY(slot(gv.hardware_ring_tx, gv.hw_tx_head % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures forall x: Seq[Int] :: x in old(gv.tx_free.net_added) ==> x in gv.tx_free.net_added @/
  /@ ensures forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
  /@ ensures forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
               s[0] in gv.tx_processed @/
  /@ ensures retval.0 == 0 ==> gv.tx_free.net_tail == old(gv.tx_free.net_tail) + 1 &&
               gv.hw_tx_head == (old(gv.hw_tx_head) + 1) % (MAX_INT16 + 1) &&
               |gv.tx_processed| == |old(gv.tx_processed)| + 1 @/
  /@ ensures retval.0 != 0 ==> gv.tx_free.net_tail == old(gv.tx_free.net_tail) &&
               gv.hw_tx_head == old(gv.hw_tx_head) &&
               gv.tx_processed == old(gv.tx_processed) @/
  /@ ensures !is_TXD_READY(old(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, old(gv.hw_tx_head) % QUEUE_CAPACITY).hw_stat)) ==>
               !is_TXD_READY(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, old(gv.hw_tx_head) % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures forall i: Int :: X3(i) && 0 <= i && i < 256 && i != old(gv.hw_tx_head) % QUEUE_CAPACITY ==>
               old(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, i).hw_stat) ==
                 unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, i).hw_stat @/

  /@ unfold valid_hardware_ring_tx_read() @/
  /@ label l @/

  /* Ensure that this buffer has been sent by the device */
  var idx = wrap_hw_tx_capacity(hw_tx_head);
  var dscr_addr = hw_tx_descr + idx * DESCR_LEN;
  var stat = 0;
  var reached_ready = 0;
  var enqueued = 0;
  var empty = 0;
  !ld16 stat, dscr_addr + DESCR_STAT_OFF;
  if (!(stat & TXD_READY)) {
    THREAD_MEMORY_ACQUIRE()

    var io_addr = 0;
    !ld32 io_addr, dscr_addr + DESCR_ADDR_OFF;
    /@ inhale (gv.tx_free.net_tail - gv.tx_free.net_head) % (MAX_INT16 + 1) != QUEUE_CAPACITY @/
    /@ assert io_addr == slot(gv.hardware_ring_tx, idx).hw_addr @/
    net_enqueue(net_tx_free, io_addr, 0, net_tx_capacity);
    /@ call tx_set_descr_processed(idx) @/

    enqueued = true;
    var temp = wrap_int16(hw_tx_head + 1);
    hw_tx_head = temp;

    empty = tx_hw_ring_empty();
  } else {
    reached_ready = 1;
  }
  /@ refute false @/
  /@ assert forall i: Int :: 0 <= i && i < 256 && i != old(gv.hw_tx_head) % QUEUE_CAPACITY ==>
               old[l](slot(gv.hardware_ring_tx, i).hw_stat) == slot(gv.hardware_ring_tx, i).hw_stat @/
  /@ assert forall i: Int :: { X3(i) } X3(i) && 0 <= i && i < 256 && i != old(gv.hw_tx_head) % QUEUE_CAPACITY ==>
               old[l](slot(gv.hardware_ring_tx, i).hw_stat) ==
                 old(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, i).hw_stat) @/
  /@ fold valid_hardware_ring_tx_read() @/
  /@ assert forall i: Int :: { X3(i) } X3(i) && 0 <= i && i < 256 && i != old(gv.hw_tx_head) % QUEUE_CAPACITY ==>
               old(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, i).hw_stat) ==
                 unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, i).hw_stat @/

  return <reached_ready, empty, enqueued>;
}

fun tx_return()
{
  /@ requires acc(gv.net_tx_free, 1/2) && gv.net_tx_free == TX_FREE_BASE &&
              acc(gv.net_tx_capacity, 1/2) && gv.net_tx_capacity == QUEUE_CAPACITY &&
              acc(gv.tx_free, 2/3) &&
              acc(gv.tx_free.net_tail) &&
              acc(gv.tx_free.net_head, 2/3) &&
              acc(gv.tx_free.net_signal) && acc(gv.tx_free.net_added) &&
              acc(gv.tx_free.net_descr, 2/3) &&
              0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
              forall i : Int :: gv.tx_free.net_tail <= i && i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
                acc(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                acc(slotq(gv.tx_free.net_descr, i).ndescr_len) &&
                valid_net_addr(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                valid_net_len(slotq(gv.tx_free.net_descr, i).ndescr_len) @/
  /@ requires net_queue_injective_produce(gv.tx_free) @/
  /@ requires acc(gv.hw_tx_head) && bounded16(gv.hw_tx_head) &&
              acc(gv.hw_tx_tail, 2/3) && bounded16(gv.hw_tx_tail) &&
              acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 &&
              acc(gv.hw_tx_descr, 1/2) && gv.hw_tx_descr == HW_RING_TX_ADDR &&
              acc(gv.tx_processed) @/
  /@ requires acc(gv.tx_ch, 1/4) @/
  /@ requires valid_hardware_ring_tx_read() && valid_hardware_ring_tx_mdata_read() @/
  /@ requires disjoint_device_unprocessed_net_added_tx() @/
  /@ requires gv.tx_free.net_added == empty_set_seqint() && gv.tx_processed == empty_set() @/
  /@ ensures acc(gv.net_tx_free, 1/2) && gv.net_tx_free == TX_FREE_BASE && acc(gv.net_tx_capacity, 1/2) &&
             acc(gv.tx_free, 2/3) && acc(gv.tx_free.net_tail) &&
             acc(gv.tx_free.net_head, 2/3) && acc(gv.tx_free.net_signal) &&
             acc(gv.tx_free.net_descr, 2/3) && acc(gv.tx_free.net_added) &&
             0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
             gv.tx_free.net_tail >= old(gv.tx_free.net_tail) && gv.tx_free.net_head == old(gv.tx_free.net_head) &&
             forall i : Int :: gv.tx_free.net_tail <= i && i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
               acc(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
               acc(slotq(gv.tx_free.net_descr, i).ndescr_len) &&
               valid_net_addr(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
               valid_net_len(slotq(gv.tx_free.net_descr, i).ndescr_len) @/
  /@ ensures net_queue_injective_produce(gv.tx_free) @/
  /@ ensures acc(gv.hw_tx_head) && bounded16(gv.hw_tx_head) &&
             acc(gv.hw_tx_tail, 2/3) && bounded16(gv.hw_tx_tail) &&
             acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 && acc(gv.hw_tx_descr, 1/2) &&
             acc(gv.tx_processed) @/
  /@ ensures acc(gv.tx_ch, 1/4) @/
  /@ ensures valid_hardware_ring_tx_read() && valid_hardware_ring_tx_mdata_read() @/
  /@ ensures disjoint_device_unprocessed_net_added_tx() @/
  // either the hw tx queue is empty, or the device is mid flight
  /@ ensures gv.hw_tx_tail == gv.hw_tx_head ||
               unfolding valid_hardware_ring_tx_read() in
                 is_TXD_READY(slot(gv.hardware_ring_tx, gv.hw_tx_head % QUEUE_CAPACITY).hw_stat) @/
  /@ ensures forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
  /@ ensures forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
                 s[0] in gv.tx_processed @/
  /@ ensures garbage_c() @/
  /@ ensures old((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == QUEUE_CAPACITY) &&
       gv.hw_tx_tail == gv.hw_tx_head ==> (gv.hw_tx_head - old(gv.hw_tx_head)) % (MAX_INT16 + 1) > 0 @/
  /@ ensures old((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == QUEUE_CAPACITY) &&
               !is_TXD_READY(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, gv.hw_tx_head % QUEUE_CAPACITY).hw_stat) ==>
                 gv.tx_processed != empty_set() @/
  /@ ensures old((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) == QUEUE_CAPACITY &&
               !is_TXD_READY(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, gv.hw_tx_head % QUEUE_CAPACITY).hw_stat)) ==>
                 gv.tx_processed != empty_set() @/

  var enqueued = false;

  var 1 empty = tx_hw_ring_empty();
  var 1 reached_ready = 0;
  while ((!empty + !reached_ready) == 2)
  {
    /@ invariant acc(gv.net_tx_free, 1/2) && gv.net_tx_free == TX_FREE_BASE &&
                 acc(gv.net_tx_capacity, 1/2) && gv.net_tx_capacity == QUEUE_CAPACITY &&
                 acc(gv.tx_free, 2/3) &&
                 acc(gv.tx_free.net_tail) &&
                 acc(gv.tx_free.net_head, 2/3) &&
                 acc(gv.tx_free.net_signal) && acc(gv.tx_free.net_added) &&
                 acc(gv.tx_free.net_descr, 2/3) &&
                 0 <= gv.tx_free.net_tail - gv.tx_free.net_head && gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
                 gv.tx_free.net_tail >= old(gv.tx_free.net_tail) && gv.tx_free.net_head == old(gv.tx_free.net_head) &&
                 forall i : Int :: gv.tx_free.net_tail <= i && i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
                   acc(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                   acc(slotq(gv.tx_free.net_descr, i).ndescr_len) &&
                   valid_net_addr(slotq(gv.tx_free.net_descr, i).ndescr_addr) &&
                   valid_net_len(slotq(gv.tx_free.net_descr, i).ndescr_len) @/
    /@ invariant net_queue_injective_produce(gv.tx_free) @/
    /@ invariant acc(gv.hw_tx_head) && bounded16(gv.hw_tx_head) &&
                 acc(gv.hw_tx_tail, 2/3) && bounded16(gv.hw_tx_tail) &&
                 acc(gv.hw_tx_capacity, 2/3) && gv.hw_tx_capacity == 256 &&
                 acc(gv.hw_tx_descr, 1/2) && gv.hw_tx_descr == HW_RING_TX_ADDR &&
                 acc(gv.tx_processed) @/
    /@ invariant valid_hardware_ring_tx_read() && valid_hardware_ring_tx_mdata_read() @/
    /@ invariant empty == (gv.hw_tx_tail == gv.hw_tx_head) @/
    /@ invariant unfolding valid_hardware_ring_tx_read() in
                   (reached_ready != 0) ==> is_TXD_READY(slot(gv.hardware_ring_tx, gv.hw_tx_head % QUEUE_CAPACITY).hw_stat) @/
    /@ invariant disjoint_device_unprocessed_net_added_tx() @/
    /@ invariant gv.tx_free.net_tail - old(gv.tx_free.net_tail) == (gv.hw_tx_head - old(gv.hw_tx_head)) % (MAX_INT16 + 1) @/
    /@ invariant gv.hw_tx_tail == old(gv.hw_tx_tail) &&
                   0 <= (gv.hw_tx_tail - old(gv.hw_tx_head)) % (MAX_INT16 + 1) && (gv.hw_tx_tail - old(gv.hw_tx_head)) % (MAX_INT16 + 1) <= QUEUE_CAPACITY @/
    /@ invariant 0 <= (gv.hw_tx_head - old(gv.hw_tx_head)) % (MAX_INT16 + 1) && (gv.hw_tx_head - old(gv.hw_tx_head)) % (MAX_INT16 + 1) <= QUEUE_CAPACITY @/
    /@ invariant forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
    /@ invariant forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
                   s[0] in gv.tx_processed @/
    /@ invariant |gv.tx_processed| >= (gv.hw_tx_head - old(gv.hw_tx_head)) % (MAX_INT16 + 1) @/
    /@ invariant gv.tx_processed == empty_set() ==> gv.hw_tx_head == old(gv.hw_tx_head) @/
    /@ invariant !is_TXD_READY(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, old(gv.hw_tx_head) % QUEUE_CAPACITY).hw_stat) &&
                   reached_ready ==> gv.tx_processed != empty_set() @/
    /@ invariant !is_TXD_READY(old(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, old(gv.hw_tx_head) % QUEUE_CAPACITY).hw_stat)) ==>
                   !is_TXD_READY(unfolding valid_hardware_ring_tx_read() in slot(gv.hardware_ring_tx, old(gv.hw_tx_head) % QUEUE_CAPACITY).hw_stat) @/
    /@ invariant true @/

    var {1,1,1} ret = tx_return_body();
    reached_ready = ret.0;
    if (reached_ready == 0) {
      empty = ret.1;
      enqueued = ret.2;
    }
  }
  /@ refute false @/

  var 1 to_signal = net_require_signal(net_tx_free, net_tx_capacity);
  if (!!enqueued + !!to_signal == 2) {
    net_cancel_signal(net_tx_free);
    microkit_notify(tx_ch);
  }

  return 0;
}

inline fun 1 irq_get_set_eir() {
  /@ requires acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/
  /@ ensures acc(gv.eth_reg, 1/2) && gv.eth_reg == HW_ETH_BASE @/

  var 1 eir_full = get_eir_status();
  var eir = eir_full & IRQ_MASK;
  set_eir(eir);
  return eir;
}

inline fun irq_transaction(1 eir) {
  /@ requires valid() @/
  /@ ensures valid() @/
  // --- if the device is full, and the queue is non-full, some progress will be made ---
  /@ ensures old(unfolding valid() in unfolding valid_hardware_ring_rx_write() in unfolding valid_net_queue_produce(gv.rx_active) in
       (eir & NETIRQ_TXF) != 0 ==>
         (forall i: Int :: 0 <= i && i < QUEUE_CAPACITY ==> !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_addr) &&
           slot(gv.hardware_ring_rx, i).ghost_unprocessed) ==>
           gv.rx_active.net_tail - gv.rx_active.net_head != QUEUE_CAPACITY) ==>
             gv.rx_active.net_added != empty_set_seqint() @/
  /@ ensures old(unfolding valid() in unfolding valid_hardware_ring_rx_write() in unfolding valid_net_queue_produce(gv.tx_free) in
       (eir & NETIRQ_TXF) != 0 ==>
         (forall i: Int :: 0 <= i && i < QUEUE_CAPACITY ==> !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_addr) &&
           slot(gv.hardware_ring_tx, i).ghost_unprocessed) ==>
           gv.tx_free.net_tail - gv.tx_free.net_head != QUEUE_CAPACITY) ==>
             gv.tx_free.net_added != empty_set_seqint() @/
  // --- correct movement of buffers ---
  /@ ensures unfolding valid() in unfolding valid_net_queue_consume(gv.rx_free) in
       forall x: Int :: x in gv.rx_free.net_removed_addr ==>
         element2_seq(x, 0) in gv.rx_handled @/
  /@ ensures unfolding valid() in unfolding valid_net_queue_consume(gv.rx_free) in
       forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
         s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
  /@ ensures unfolding valid() in unfolding valid_net_queue_produce(gv.rx_active) in
       gv.rx_active.net_added == gv.rx_processed @/
  /@ ensures unfolding valid() in unfolding valid_net_queue_consume(gv.tx_active) in
       gv.tx_handled == gv.tx_active.net_removed @/
  /@ ensures unfolding valid() in unfolding valid_net_queue_produce(gv.tx_free) in
       forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
  /@ ensures unfolding valid() in unfolding valid_net_queue_produce(gv.tx_free) in
       forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
         s[0] in gv.tx_processed @/
  /@ inhale empty_ghost_state() @/

  /@ unfold valid() @/
  if (eir & NETIRQ_TXF) {
    // A frame was transmitted
    /@ unfold valid_net_queue_produce(gv.tx_free, QUEUE_CAPACITY) @/
    tx_return();
    /@ refute false @/
    /@ fold valid_net_queue_produce(gv.tx_free, QUEUE_CAPACITY) @/
    /@ unfold valid_net_queue_consume(gv.tx_active, QUEUE_CAPACITY) @/
    tx_provide();
    /@ refute false @/
    /@ fold valid_net_queue_consume(gv.tx_active, QUEUE_CAPACITY) @/
  }
  if (eir & NETIRQ_RXF) {
    /@ unfold valid_net_queue_produce(gv.rx_active, QUEUE_CAPACITY) @/
    rx_return();
    /@ refute false @/
    /@ fold valid_net_queue_produce(gv.rx_active, QUEUE_CAPACITY) @/
    /@ unfold valid_net_queue_consume(gv.rx_free, QUEUE_CAPACITY) @/
    rx_provide();
    /@ refute false @/
    /@ fold valid_net_queue_consume(gv.rx_free, QUEUE_CAPACITY) @/
  }
  /@ fold valid() @/
  return 0;
}

fun handle_irq() {
  /@ requires valid() @/
  /@ ensures valid() @/

  /@ unfold valid() @/
  var 1 eir = irq_get_set_eir();
  /@ refute false @/
  /@ fold valid() @/
  while (eir & IRQ_MASK)
  {
    /@ invariant valid() @/
    irq_transaction(eir);

    /@ unfold valid() @/
    eir = irq_get_set_eir();
    /@ fold valid() @/
  }

  return 0;
}

export fun notified(1 ch)
{
  // --- if the device is empty, queue is non-empty, notified from virt, data will be moved ---
  /@ ensures ch == rx_ch ==> old(unfolding valid() in unfolding valid_net_queue_consume(gv.rx_free) in
       (forall i: Int :: 0 <= i && i < QUEUE_CAPACITY ==> !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_addr) &&
         !slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
         gv.rx_free.net_tail != gv.rx_free.net_head) ==>
           gv.rx_free.net_added != empty_set_seqint() @/
  /@ ensures ch == tx_ch ==> old(unfolding valid() in unfolding valid_net_queue_consume(gv.tx_active) in
       (forall i: Int :: 0 <= i && i < QUEUE_CAPACITY ==> !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_addr) &&
         !slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
         gv.tx_active.net_tail != gv.tx_active.net_head) ==>
           gv.tx_active.net_added != empty_set_seqint() @/
  // --- correct movement of buffers ---
  /@ ensures ch == rx_ch ==> unfolding valid() in unfolding valid_net_queue_consume(gv.rx_free) in
       forall x: Int :: x in gv.rx_free.net_removed_addr ==>
         element2_seq(x, 0) in gv.rx_handled @/
  /@ ensures ch == rx_ch ==> unfolding valid() in unfolding valid_net_queue_consume(gv.rx_free) in
       forall s: Seq[Int] :: s in gv.rx_handled ==> |s| == 2 &&
         s[0] in gv.rx_free.net_removed_addr && s[1] == 0 @/
  /@ ensures ch == rx_ch ==> unfolding valid() in unfolding valid_net_queue_produce(gv.rx_active) in
       gv.rx_active.net_added == gv.rx_processed @/
  /@ ensures ch == tx_ch ==> unfolding valid() in unfolding valid_net_queue_consume(gv.tx_active) in
       gv.tx_handled == gv.tx_active.net_removed @/
  /@ ensures ch == tx_ch ==> unfolding valid() in unfolding valid_net_queue_produce(gv.tx_free) in
       forall x: Int :: x in gv.tx_processed ==> element2_seq(x, 0) in gv.tx_free.net_added @/
  /@ ensures ch == tx_ch ==> unfolding valid() in unfolding valid_net_queue_produce(gv.tx_free) in
       forall s: Seq[Int] :: s in gv.tx_free.net_added ==> |s| == 2 && s[1] == 0 &&
         s[0] in gv.tx_processed @/
  /@ inhale valid() @/

  /@ unfold valid() @/
  if (ch == irq_ch) {
    /@ refute false @/
    /@ fold valid() @/
    handle_irq();
    /*
     * Delay calling into the kernel to ack the IRQ until the next loop
     * in the microkit event handler loop.
     */
    microkit_deferred_irq_ack(ch);
    /@ unfold valid() @/
  }
  // XXX no else if?!
  /@ unfold valid_virt() @/
  if (ch == rx_ch) {
    /@ unfold valid_net_queue(gv.rx_free, QUEUE_CAPACITY) @/
    rx_provide();
    /@ refute false @/
    /@ fold valid_net_queue(gv.rx_free, QUEUE_CAPACITY) @/
  }
  if (ch == tx_ch) {
    /@ unfold valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
    tx_provide();
    /@ refute false @/
    /@ fold valid_net_queue(gv.tx_active, QUEUE_CAPACITY) @/
  }
  /@ refute false @/
  /@ fold valid_virt() @/
  /@ refute false @/
  /@ fold valid() @/

  /@ exhale valid() @/
  return 0;
}
