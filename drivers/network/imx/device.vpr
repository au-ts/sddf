/* Hardware ring stat WRAP:
 * According to the imx8mm manual that:
 * > Wrap. Written by user.
 * > 0 The next buffer descriptor is found in the consecutive location.
 * > 1 The next buffer descriptor is found at the location defined in ENETn_RDSR.
 * This applies to both receive (rx) and transmit (tx) sides.
 * We want to make sure that the WRAP bit in the buffer descriptor is set iff
 * the descriptor is at the last slot in the contiguous hardware ring region.
 *
 * TLDR:
 * The last slot of hardware_ring_*_stat[] must have WRAP set.
 * Other slots must not have WRAP set.
*/
// predicate valid_hardware_ring_rx(heap: IArray, gv: Ref, p: Perm)
// {
//     acc(gv.hardware_ring_rx, p) &&
//     forall i: Int :: { slot(gv.hardware_ring_rx, i) }
//         (i >= 0 && i < hw_capacity) ==> (
//             acc(slot(gv.hardware_ring_rx, i).hw_stat, p) &&
//             (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
//                 acc(slot(gv.hardware_ring_rx, i).hw_addr, p) &&
//                 is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr) &&
//                 is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat) &&
//                 acc(slot(gv.hardware_ring_rx, i).hw_len), p) &&
//                 is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len)
//         )
//     )
// }

define valid_rx_read_slot(x) (
    acc(x.hw_addr, 3/4) &&
    is_valid_data_addr(x.hw_addr) &&
    is_valid_rx_stat(x.hw_stat) &&
    acc(x.hw_len, 3/4) &&
    is_valid_data_len(x.hw_len) &&
    acc(x.ghost_unprocessed)
)

// TODO can I use this define below?
predicate valid_hardware_ring_rx_read(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_rx, 3/4) &&
    (forall i: Int :: //{ slot(gv.hardware_ring_rx, i).hw_stat }
        i >= 0 && i < hw_capacity ==> acc(slot(gv.hardware_ring_rx, i).hw_stat, 3/4)) &&
    (forall i: Int ::
        //{ bounded16(slot(gv.hardware_ring_rx, i).hw_stat) }
        //{ bounded32(slot(gv.hardware_ring_rx, i).hw_stat) }
        //{ bounded64(slot(gv.hardware_ring_rx, i).hw_stat) }
        i >= 0 && i < hw_capacity ==>
        bounded16(slot(gv.hardware_ring_rx, i).hw_stat)) &&
    (forall i: Int :: //{ is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_addr }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).hw_addr, 3/4) &&
            is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr)) &&
    (forall i: Int :: //{ is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_stat }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat)) &&
    (forall i: Int :: //{ is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_len }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).hw_len, 3/4) &&
            is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len)) &&
    (forall i: Int :: //{ is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).ghost_unprocessed }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).ghost_unprocessed))
}

