function ND_bounded32(): Int
  ensures bounded32(result)

function ND_bounded16(): Int
  ensures bounded16(result)

define f_valid_hardware_ring_rx_read(x, y) valid_hardware_ring_rx_read(x, y)
define f_valid_hardware_ring_rx_write(x, y) valid_hardware_ring_rx_write(x, y)
define f_valid_hardware_ring_tx_read(x, y) valid_hardware_ring_tx_read(x, y)
define f_valid_hardware_ring_tx_write(x, y) valid_hardware_ring_tx_write(x, y)
define f_valid_hardware_ring_rx_mdata_read(x, y) valid_hardware_ring_rx_mdata_read(x, y)
define f_valid_hardware_ring_rx_mdata_write(x, y) valid_hardware_ring_rx_mdata_write(x, y)
define f_valid_hardware_ring_tx_mdata_read(x, y) valid_hardware_ring_tx_mdata_read(x, y)
define f_valid_hardware_ring_tx_mdata_write(x, y) valid_hardware_ring_tx_mdata_write(x, y)
define f_slot(_, _, x, y) slot(x, y)
define f_slotq(_, _, x, y) slotq(x, y)
define f_is_RXD_EMPTY(_, _, x) is_RXD_EMPTY(x)
define f_is_TXD_READY(_, _, x) is_TXD_READY(x)
define f_is_WRAP(_, _, x) is_WRAP(x)
define f_is_valid_data_addr(_, _, x) is_valid_data_addr(x)
define f_is_valid_data_len(_, _, x) is_valid_data_len(x)
define f_is_valid_rx_stat(_, _, x) is_valid_rx_stat(x)
define f_is_valid_tx_stat(_, _, x) is_valid_tx_stat(x)
define f_true(_, _) true

/* Hard-coded register addresses specified in
 * `examples/echo_server/board/maaxborad/echo_server.system` and
 * `driver/network/imx/ethernet.h`
*/
define REG_BASE         33554432    // 0x2_000_000
define EIR_offset       4           // 0x04
define RDAR_offset      16          // 0x10
define TDAR_offset      20          // 0x14

define hw_capacity          256
define hw_descriptor_size   8
define hw_ring_rx_size      hw_capacity * hw_descriptor_size
define hw_ring_tx_size      hw_capacity * hw_descriptor_size
define MAX_INT16            65535

define hw_ring_buffer_vaddr 35651584                                // 0x2_200_000
define hw_ring_rx_addr      hw_ring_buffer_vaddr                    // 0x2_200_000
define hw_ring_tx_addr      hw_ring_buffer_vaddr + hw_ring_rx_size  // 0x2_200_800

define unchanged(exprs)   exprs == old(exprs)

