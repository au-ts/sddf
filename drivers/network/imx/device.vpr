            0 <= j && j < gv.hw_tx_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, j).hw_stat) &&
            slot(gv.hardware_ring_tx, i).hw_addr == slot(gv.hardware_ring_tx, j).hw_addr ==>
                i == j)
}*/
define valid_hardware_ring_tx_mdata_write(heap, gv) 
(
    0 <= (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) <= gv.hw_tx_capacity && 
    gv.hw_tx_capacity == 256 &&
    (unfolding valid_hardware_ring_tx_write(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
            (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
             ((gv.hw_tx_tail % gv.hw_tx_capacity) < (gv.hw_tx_head % gv.hw_tx_capacity)
               ? i >= (gv.hw_tx_tail % gv.hw_tx_capacity) && i < (gv.hw_tx_head % gv.hw_tx_capacity)
               : i >= (gv.hw_tx_tail % gv.hw_tx_capacity) || i < (gv.hw_tx_head % gv.hw_tx_capacity)) ==>
               !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) && !slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_tx_write(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
            !((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
              (gv.hw_tx_tail % gv.hw_tx_capacity < gv.hw_tx_head % gv.hw_tx_capacity
                ? i >= gv.hw_tx_tail % gv.hw_tx_capacity && i < gv.hw_tx_head % gv.hw_tx_capacity
                : i >= gv.hw_tx_tail % gv.hw_tx_capacity || i < gv.hw_tx_head % gv.hw_tx_capacity)) &&
                !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
                  slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_tx_write(heap, gv) in
        forall i: Int, j: Int :: 0 <= i && i < gv.hw_tx_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) &&
            0 <= j && j < gv.hw_tx_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, j).hw_stat) &&
            slot(gv.hardware_ring_tx, i).hw_addr == slot(gv.hardware_ring_tx, j).hw_addr ==>
                i == j)
)

/* The below methods are pretty much similar to each other.
 * Bascially for stat, len, and addr update, we require that:
 *   - The given value is valid
 *   - There is access to the given address
*/
// todo: can we have disjoint address chunks that give the same method?
method store_hw_ring_rx_addr(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 4) >= hw_ring_rx_addr && (address - 4) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 4) % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    requires is_valid_data_addr(value)
    requires acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_RX_FREE_2
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_QM_AND_ADDR
    ensures acc(gv.wm_buf_addr) && acc(gv.wm_hw_slot)
    ensures gv.wm_buf_addr == value
    ensures gv.wm_hw_slot == (address - 4 - hw_ring_rx_addr) / hw_descriptor_size

method store_hw_ring_tx_addr(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 4) >= hw_ring_tx_addr && (address - 4) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 4) % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    requires is_valid_data_addr(value)
    requires acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_TX_ACTIVE_2
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_QM_AND_ADDR
    ensures acc(gv.wm_buf_addr) && acc(gv.wm_hw_slot)
    ensures gv.wm_buf_addr == value
    ensures gv.wm_hw_slot == (address - 4 - hw_ring_tx_addr) / hw_descriptor_size

// WM: No considerations need to be made for addr, since we assume if we have access to it, it is not changing.
method load_hw_ring_rx_addr(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 4) % 8 == 0
    requires (address - 4) >= hw_ring_rx_addr && (address - 4) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires acc(gv.hardware_ring_rx, 1/2) &&
        acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr, 1/2) &&
        is_valid_data_addr(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr, 1/2)
    ensures retval == slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr
    ensures is_valid_data_addr(retval)
{
    retval := slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr
    refute false
}

method load_hw_ring_tx_addr(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 4) % 8 == 0
    requires (address - 4) >= hw_ring_tx_addr && (address - 4) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires acc(gv.hardware_ring_tx, 1/2) &&
        acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr, 1/2) &&
        is_valid_data_addr(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr, 1/2)
    ensures retval == slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr
    ensures is_valid_data_addr(retval)
{
    retval := slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr
    refute false
}

method store_hw_ring_rx_stat(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 2) % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    requires is_valid_rx_stat(value)
    requires is_RXD_EMPTY(value)
    requires acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed
    // make sure the given value is wrapped properly
    requires (((address - 2 - hw_ring_rx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    requires acc(gv.rx_await_ack) &&
        forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j]
    requires acc(gv.wm_state) && gv.wm_state == WM_NONE
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    ensures acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_STAT
    ensures acc(gv.wm_hw_slot) && acc(gv.wm_stat)
    ensures gv.wm_hw_slot == (address - 2 - hw_ring_rx_addr) / hw_descriptor_size &&
      gv.wm_stat == value
    ensures acc(gv.rx_await_ack) && gv.wm_hw_slot in gv.rx_await_ack &&
        (gv.wm_hw_slot in old(gv.rx_await_ack) ==> gv.rx_await_ack == old(gv.rx_await_ack)) &&
        (!(gv.wm_hw_slot in old(gv.rx_await_ack)) ==> gv.rx_await_ack == old(gv.rx_await_ack) ++ Seq(gv.wm_hw_slot)) &&
        (forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
            gv.rx_await_ack[i] != gv.rx_await_ack[j]) &&
        (|old(gv.rx_await_ack)| == 0 ==> |gv.rx_await_ack| == 1)
/*{
    var index: Int := (address - 2 - hw_ring_rx_addr) / hw_descriptor_size
    slot(gv.hardware_ring_rx, index).hw_stat := value
    if (!(index in gv.rx_await_ack)) {
        gv.rx_await_ack := gv.rx_await_ack ++ Seq(index)
    }
    refute false
}*/

method load_hw_ring_rx_stat(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 2) % 8 == 0
    requires (address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires acc(gv.hardware_ring_rx, 1/2) &&
        acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat, 1/2)
    requires bounded16(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    requires !is_RXD_EMPTY(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat) ==>
        is_valid_rx_stat(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_RX_ACTIVE)
    ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_RX_STAT &&
        acc(gv.wm_state_old) && gv.wm_state_old == old(gv.wm_state) && acc(gv.wm_stat)
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat, 1/2)
    ensures retval == gv.wm_stat
    ensures is_valid_rx_stat(gv.wm_stat)
    ensures !is_RXD_EMPTY(old(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)) ==>
        !is_RXD_EMPTY(gv.wm_stat)
    ensures acc(gv.wm_stat_old_was_empty) && gv.wm_stat_old_was_empty == is_RXD_EMPTY(old(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)) &&
        acc(gv.wm_hw_slot) && gv.wm_hw_slot == (address - 2 - hw_ring_rx_addr) / hw_descriptor_size

method store_hw_ring_tx_stat(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 2) >= hw_ring_tx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 2) % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    requires is_valid_tx_stat(value)
    requires is_TXD_READY(value)
    requires acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed
    requires acc(gv.tx_await_ack) &&
        forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
        gv.tx_await_ack[i] != gv.tx_await_ack[j]
    // make sure the given value is wrapped properly
    requires (((address - 2 - hw_ring_tx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    requires acc(gv.wm_state) && gv.wm_state == WM_NONE
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    ensures acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_STAT
    ensures acc(gv.wm_hw_slot) && acc(gv.wm_stat)
    ensures gv.wm_hw_slot == (address - 2 - hw_ring_tx_addr) / hw_descriptor_size &&
      gv.wm_stat == value
    ensures acc(gv.tx_await_ack) && gv.wm_hw_slot in gv.tx_await_ack &&
        (gv.wm_hw_slot in old(gv.tx_await_ack) ==> gv.tx_await_ack == old(gv.tx_await_ack)) &&
        (!(gv.wm_hw_slot in old(gv.tx_await_ack)) ==> gv.tx_await_ack == old(gv.tx_await_ack) ++ Seq(gv.wm_hw_slot)) &&
        (forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
            gv.tx_await_ack[i] != gv.tx_await_ack[j]) &&
        (|old(gv.tx_await_ack)| == 0 ==> |gv.tx_await_ack| == 1)

method load_hw_ring_tx_stat(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 2) % 8 == 0
    requires (address - 2) >= hw_ring_tx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires acc(gv.hardware_ring_tx, 1/2) &&
        acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat, 1/2)
    requires bounded16(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    requires !is_TXD_READY(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat) ==>
        is_valid_tx_stat(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_TX_FREE)
    ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_TX_STAT &&
        acc(gv.wm_state_old) && gv.wm_state_old == old(gv.wm_state) && acc(gv.wm_stat)
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat, 1/2)
    ensures retval == gv.wm_stat
    ensures is_valid_tx_stat(gv.wm_stat)
    ensures !is_TXD_READY(old(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)) ==>
        !is_TXD_READY(gv.wm_stat)
    ensures acc(gv.wm_stat_old_was_empty) && gv.wm_stat_old_was_empty == is_TXD_READY(old(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)) &&
        acc(gv.wm_hw_slot) && gv.wm_hw_slot == (address - 2 - hw_ring_tx_addr) / hw_descriptor_size

// WM: No considerations need to be made for len, since we assume nothing about the contents of the len.
method load_hw_ring_rx_len(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires address >= hw_ring_rx_addr && address < (hw_ring_rx_addr + hw_ring_rx_size)
    requires address % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) &&
        acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len, 1/2) &&
        is_valid_data_len(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len)
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len, 1/2)
    ensures retval == slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len
    ensures is_valid_data_len(retval)
{
    retval := slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len
    refute false
}

method store_hw_ring_rx_len(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address >= hw_ring_rx_addr && address < (hw_ring_rx_addr + hw_ring_rx_size)
    requires address % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len)
    requires is_valid_data_len(value)
    requires acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed
    requires acc(gv.wm_state) && acc(gv.wm_hw_slot, 1/2)
    requires gv.wm_state == WM_STORE_RX_QM_AND_ADDR
    requires gv.wm_hw_slot == (address - hw_ring_rx_addr) / hw_descriptor_size
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).hw_len)
    ensures acc(slot(gv.hardware_ring_rx, (address - hw_ring_rx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && acc(gv.wm_buf_len) && acc(gv.wm_hw_slot, 1/2)
    ensures gv.wm_buf_len == value
    ensures gv.wm_state == WM_STORE_RX_QM_AND_BUF

method load_hw_ring_tx_len(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires address >= hw_ring_tx_addr && address < (hw_ring_tx_addr + hw_ring_tx_size)
    requires address % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) &&
        acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len, 1/2) &&
        is_valid_data_len(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len)
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len, 1/2)
    ensures retval == slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len
    ensures is_valid_data_len(retval)
{
    retval := slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len
    refute false
}

method store_hw_ring_tx_len(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address >= hw_ring_tx_addr && address < (hw_ring_tx_addr + hw_ring_tx_size)
    requires address % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len)
    requires is_valid_data_len(value)
    requires acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2) &&
        !slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed
    requires acc(gv.wm_state) && acc(gv.wm_hw_slot, 1/2)
    requires gv.wm_state == WM_STORE_TX_QM_AND_ADDR
    requires gv.wm_hw_slot == (address - hw_ring_tx_addr) / hw_descriptor_size
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).hw_len)
    ensures acc(slot(gv.hardware_ring_tx, (address - hw_ring_tx_addr) / hw_descriptor_size).ghost_unprocessed, 1/2)
    ensures acc(gv.wm_state) && acc(gv.wm_buf_len) && acc(gv.wm_hw_slot, 1/2)
    ensures gv.wm_buf_len == value
    ensures gv.wm_state == WM_STORE_TX_QM_AND_BUF

method store_hw_ring_reserve(heap: IArray, gv: Ref, address: Int, value: Int)
    requires ((address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size))
    requires (address - 2) % 8 == 0
    requires value == 0
{
    refute false
}

///////////////////////////// RDAR and TDAR registers
define RDAR_RDAR        16777216    // 1 << 24
define TDAR_TDAR        16777216    // 1 << 24

field wm_await_ack_data: Seq[Ref]

// WM: No permissions or information gained, so no need for move-later WM handling.
method store_RDAR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + RDAR_offset)
    requires value == RDAR_RDAR
    requires acc(gv.rx_handled) && acc(gv.hardware_ring_rx, 1/2)
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_RDAR && acc(gv.wm_await_ack_data)
    requires forall r: Ref :: r in gv.wm_await_ack_data ==> acc(r.hw_addr) && acc(r.hw_len)
    requires forall r: Ref :: r in gv.wm_await_ack_data ==> forall x: Seq[Int] :: x in gv.rx_handled ==>
               |x| == 2 && x[0] != r.hw_addr
    ensures acc(gv.wm_state) && gv.wm_state == WM_NONE
    ensures acc(gv.rx_handled) && acc(gv.hardware_ring_rx, 1/2)
    ensures forall x: Seq[Int] :: x in old(gv.rx_handled) ==> x in gv.rx_handled
    ensures forall i: Int :: forall r: Ref :: r in old(gv.wm_await_ack_data) ==> old(Seq(r.hw_addr, r.hw_len)) in gv.rx_handled
    ensures forall x: Seq[Int] :: x in gv.rx_handled ==> x in old(gv.rx_handled) ||
                (|x| == 2 && exists r: Ref :: (r in old(gv.wm_await_ack_data) && x == old(Seq(r.hw_addr, r.hw_len))))
    ensures |gv.rx_handled| == |old(gv.rx_handled)| + |old(gv.wm_await_ack_data)|

// WM: No permissions or information gained, so no need for move-later WM handling.
method store_TDAR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + TDAR_offset)
    requires value == TDAR_TDAR
    requires acc(gv.tx_handled) && acc(gv.hardware_ring_tx, 1/2)
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_TDAR && acc(gv.wm_await_ack_data)
    requires forall r: Ref :: r in gv.wm_await_ack_data ==> acc(r.hw_addr) && acc(r.hw_len)
    requires forall r: Ref :: r in gv.wm_await_ack_data ==> forall x: Seq[Int] :: x in gv.tx_handled ==>
               |x| == 2 && x[0] != r.hw_addr
    ensures acc(gv.wm_state) && gv.wm_state == WM_NONE
    ensures acc(gv.tx_handled) && acc(gv.hardware_ring_tx, 1/2)
    ensures forall x: Seq[Int] :: x in old(gv.tx_handled) ==> x in gv.tx_handled
    ensures forall i: Int :: forall r: Ref :: r in old(gv.wm_await_ack_data) ==> old(Seq(r.hw_addr, r.hw_len)) in gv.tx_handled
    ensures forall x: Seq[Int] :: x in gv.tx_handled ==> x in old(gv.tx_handled) ||
                (|x| == 2 && exists r: Ref :: (r in old(gv.wm_await_ack_data) && x == old(Seq(r.hw_addr, r.hw_len))))
    ensures |gv.tx_handled| == |old(gv.tx_handled)| + |old(gv.wm_await_ack_data)|

/////////////////////////////

///////////////////////////// EIR register
/*
 *         EIR register
 * ┌─────────────────────────┐
 * │     indicates RX IRQ    │
 * │         ▲               │
 * │         │               │
 * │─────────┴───────────────│
 * │31  27  25              0│
 * │    │                    │
 * │    ▼                    │
 * │   indicates TX IRQ      │
 * └─────────────────────────┘
*/
define EIR_RXF_MASK     33554432    // 1 << 25
define EIR_TXF_MASK     134217728   // 1 << 27
define IRQ_MASK         171966464   // (1 << 25) | (1 << 27) | (1 << 22)

function is_EIR_RXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_RXF_MASK))) != 0

function is_EIR_TXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_TXF_MASK))) != 0

// WM: We do not reason about EIR in relation to anything else, and it makes no guarantees,
//     so no WM handling required.
method store_EIR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + EIR_offset)
    requires bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(IRQ_MASK))) == value

// WM: We do not reason about EIR in relation to anything else, and it makes no guarantees,
//     so no WM handling required.
method load_EIR(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires address == (REG_BASE + EIR_offset)
    ensures bounded32(retval)
/////////////////////////////

method f_rx_set_descr_processed(heap: IArray, gv: Ref, i: Int)
    requires 0 <= i < 256
    requires acc(gv.hardware_ring_rx, 1/4) && acc(slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
      acc(gv.rx_processed) && acc(slot(gv.hardware_ring_rx, i).hw_addr, 1/4) &&
      acc(slot(gv.hardware_ring_rx, i).hw_len, 1/4)
    requires slot(gv.hardware_ring_rx, i).ghost_unprocessed == true
    ensures acc(gv.hardware_ring_rx, 1/4) && acc(slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
      acc(gv.rx_processed) && acc(slot(gv.hardware_ring_rx, i).hw_addr, 1/4) &&
      acc(slot(gv.hardware_ring_rx, i).hw_len, 1/4)
    ensures slot(gv.hardware_ring_rx, i).ghost_unprocessed == false
    ensures gv.rx_processed == old(gv.rx_processed) union
              Set(Seq(slot(gv.hardware_ring_rx, i).hw_addr, slot(gv.hardware_ring_rx, i).hw_len))
{
    slot(gv.hardware_ring_rx, i).ghost_unprocessed := false
    gv.rx_processed := gv.rx_processed union
              Set(Seq(slot(gv.hardware_ring_rx, i).hw_addr, slot(gv.hardware_ring_rx, i).hw_len))
}

method f_tx_set_descr_processed(heap: IArray, gv: Ref, i: Int)
    requires 0 <= i < 256
    requires acc(gv.hardware_ring_tx, 1/4) && acc(slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
      acc(gv.tx_processed) && acc(slot(gv.hardware_ring_tx, i).hw_addr, 1/4)
    requires slot(gv.hardware_ring_tx, i).ghost_unprocessed == true
    ensures acc(gv.hardware_ring_tx, 1/4) && acc(slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
      acc(gv.tx_processed) && acc(slot(gv.hardware_ring_tx, i).hw_addr, 1/4)
    ensures slot(gv.hardware_ring_tx, i).ghost_unprocessed == false
    ensures gv.tx_processed == old(gv.tx_processed) union Set(slot(gv.hardware_ring_tx, i).hw_addr)
{
    slot(gv.hardware_ring_tx, i).ghost_unprocessed := false
    gv.tx_processed := gv.tx_processed union Set(slot(gv.hardware_ring_tx, i).hw_addr)
}

// helpers because the transpiler is bad at some things
function f_union_elem(heap: IArray, gv: Ref, s: Set[Int], t: Set[Int], e: Int): Bool
{
    s == t union Set(e)
}

function f_union_elem_seq(heap: IArray, gv: Ref, s: Set[Seq[Int]], t: Set[Seq[Int]], e: Seq[Int]): Bool
{
    s == t union Set(e)
}

function f_append_elem(heap: IArray, gv: Ref, s: Seq[Int], t: Seq[Int], e: Int): Bool
{
    s == t ++ Seq(e)
}

function f_empty_set(heap: IArray, gv: Ref): Set[Int]
{
    Set[Int]()
}

function f_empty_set_seqint(heap: IArray, gv: Ref): Set[Seq[Int]]
{
    Set[Seq[Int]]()
}

function f_empty_seq(heap: IArray, gv: Ref): Seq[Int]
{
    Seq[Int]()
}

function f_element_set(heap: IArray, gv: Ref, e: Int): Set[Int]
{
    Set(e)
}

function f_element_seq(heap: IArray, gv: Ref, e: Int): Seq[Int]
{
    Seq(e)
}

function f_element2_seq(heap: IArray, gv: Ref, e1: Int, e2: Int): Seq[Int]
{
    Seq(e1, e2)
}

function f_setminus_seqint(heap: IArray, gv: Ref, s: Set[Seq[Int]], t: Set[Seq[Int]]): Set[Seq[Int]]
{
    s setminus t
}

define f_garbage_a(heap, gv) (
  let a == (old(gv.hw_rx_tail)) in let b == (old(gv.hw_rx_head)) in a == b &&
    (gv.hw_rx_tail - gv.hw_rx_head) % 65536 == gv.hw_rx_capacity &&
    gv.hw_rx_tail == a && gv.hw_rx_head == b ==>
    false
)

define f_garbage_b(heap, gv) (
  let a == (old(gv.rx_free.net_tail)) in let b == (old(gv.rx_free.net_head)) in
    gv.rx_free.net_tail >= a && gv.rx_free.net_head >= b && a >= b &&
    a != b && gv.rx_free.net_tail == gv.rx_free.net_head && gv.rx_free.net_head == b ==>
    false
)

define f_garbage_a2(heap, gv) (
  let a == (old(gv.hw_tx_tail)) in let b == (old(gv.hw_tx_head)) in a == b &&
    (gv.hw_tx_tail - gv.hw_tx_head) % 65536 == gv.hw_tx_capacity &&
    gv.hw_tx_tail == a && gv.hw_tx_head == b ==>
    false
)

define f_garbage_b2(heap, gv) (
  let a == (old(gv.tx_active.net_tail)) in let b == (old(gv.tx_active.net_head)) in
    gv.tx_active.net_tail >= a && gv.tx_active.net_head >= b && a >= b &&
    a != b && gv.tx_active.net_tail == gv.tx_active.net_head && gv.tx_active.net_head == b ==>
    false
)

define f_garbage_c(heap, gv) (
  let a == (old(gv.hw_tx_tail)) in let b == (old(gv.hw_tx_head)) in
    (a - b) % (MAX_INT16 + 1) == QUEUE_CAPACITY && gv.hw_tx_tail == gv.hw_tx_head &&
    gv.hw_tx_head == b && gv.hw_tx_tail == a ==> false
)

define f_garbage_c2(heap, gv) (
  let a == (old(gv.hw_rx_tail)) in let b == (old(gv.hw_rx_head)) in
    (a - b) % (MAX_INT16 + 1) == QUEUE_CAPACITY && gv.hw_rx_tail == gv.hw_rx_head &&
    gv.hw_rx_head == b && gv.hw_rx_tail == a ==> false
)

method f_wm_pre_rdar(heap: IArray, gv: Ref)
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_STAT
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_STAT_PRE_RDAR

method f_wm_pre_tdar(heap: IArray, gv: Ref)
    requires acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_STAT
    ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_STAT_PRE_TDAR

method f_ffiTHREAD_MEMORY_RELEASE(heap: IArray, gv: Ref, a: Int, b: Int, c: Int, d: Int)
    requires a == 0 && b == 0 && c == 0 && d == 0
    requires acc(gv.wm_state)
    requires gv.wm_state == WM_STORE_RX_QM_AND_BUF ==> acc(gv.wm_buf_addr) && acc(gv.wm_buf_len) && acc(gv.wm_hw_slot)
    requires gv.wm_state == WM_STORE_RX_QM_AND_BUF ==> acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_addr) && acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_len)
    requires gv.wm_state == WM_STORE_RX_QM_AND_BUF ==> acc(gv.wm_qhead)
    requires gv.wm_state == WM_STORE_RX_QM_AND_BUF ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head)
    requires gv.wm_state == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.wm_hw_slot) && acc(gv.wm_stat)
    requires gv.wm_state == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_stat)
    requires gv.wm_state == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.rx_await_ack) && gv.rx_await_ack == Seq(gv.wm_hw_slot) && acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_addr) &&
        acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_len) &&
        acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).ghost_unprocessed) &&
        is_RXD_EMPTY(gv.wm_stat) &&
        !slot(gv.hardware_ring_rx, gv.wm_hw_slot).ghost_unprocessed
    requires gv.wm_state == WM_STORE_TX_QM_AND_BUF ==> acc(gv.wm_buf_addr) && acc(gv.wm_buf_len) && acc(gv.wm_hw_slot)
    requires gv.wm_state == WM_STORE_TX_QM_AND_BUF ==> acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_addr) && acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_len)
    requires gv.wm_state == WM_STORE_TX_QM_AND_BUF ==> acc(gv.wm_qhead)
    requires gv.wm_state == WM_STORE_TX_QM_AND_BUF ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head)
    requires gv.wm_state == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.wm_hw_slot) && acc(gv.wm_stat)
    requires gv.wm_state == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_stat)
    requires gv.wm_state == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.tx_await_ack) && gv.tx_await_ack == Seq(gv.wm_hw_slot) && acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_addr) &&
        acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_len) &&
        acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).ghost_unprocessed) &&
        is_TXD_READY(gv.wm_stat) &&
        !slot(gv.hardware_ring_tx, gv.wm_hw_slot).ghost_unprocessed
    requires gv.wm_state == WM_STORE_QM_TX_ACTIVE ==>
        acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head, 1/4) && acc(gv.tx_active.net_descr, 1/4) && acc(gv.tx_active.net_removed) &&
        acc(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr) &&
        acc(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len)
    requires gv.wm_state == WM_STORE_QM_RX_FREE ==>
        acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4) && acc(gv.rx_free.net_descr, 1/4) && acc(gv.rx_free.net_removed_addr) &&
        acc(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr) &&
        acc(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_len)
    requires gv.wm_state == WM_STORE_QM_RX_ACTIVE || gv.wm_state == WM_STORE_QM_TX_FREE ==>
        acc(gv.wm_qtail)
    requires gv.wm_state == WM_STORE_QM_RX_ACTIVE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail)
    requires gv.wm_state == WM_STORE_QM_TX_FREE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail)
    requires gv.wm_state == WM_STORE_QM_W_DATA_RX_ACTIVE || gv.wm_state == WM_STORE_QM_W_DATA_TX_FREE ==>
        acc(gv.wm_qaddr) && acc(gv.wm_qlen) && acc(gv.wm_qref) && acc(gv.wm_qref.ndescr_addr) && acc(gv.wm_qref.ndescr_len) && acc(gv.wm_state_old)
    requires gv.wm_state == WM_STORE_QM_W_DATA_RX_ACTIVE || gv.wm_state == WM_STORE_QM_W_DATA_TX_FREE ==> acc(gv.wm_store_tail_count, 1/2)
    requires gv.wm_state == WM_STORE_QM_W_DATA_RX_ACTIVE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_added) && acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_descr, 1/4) &&
        gv.wm_qref == slotq(gv.rx_active.net_descr, gv.rx_active.net_tail + gv.wm_store_tail_count - 1)
    requires gv.wm_state == WM_STORE_QM_W_DATA_TX_FREE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_added) && acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_descr, 1/4) &&
        gv.wm_qref == slotq(gv.tx_free.net_descr, gv.tx_free.net_tail + gv.wm_store_tail_count - 1)
    requires gv.wm_state == WM_STORE_RX_FREE_CONSUMER_SIGNALLED ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_signal)
    requires gv.wm_state == WM_STORE_RX_ACTIVE_CONSUMER_SIGNALLED ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_signal)
    requires gv.wm_state == WM_STORE_TX_FREE_CONSUMER_SIGNALLED ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal)
    requires gv.wm_state == WM_STORE_TX_ACTIVE_CONSUMER_SIGNALLED ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_signal)
    requires gv.wm_state in Set(WM_STORE_RX_FREE_CONSUMER_SIGNALLED, WM_STORE_RX_ACTIVE_CONSUMER_SIGNALLED, WM_STORE_TX_FREE_CONSUMER_SIGNALLED, WM_STORE_TX_ACTIVE_CONSUMER_SIGNALLED) ==> 
        acc(gv.wm_consumer_signalled)
    ensures acc(gv.wm_state)
    ensures gv.wm_state == (old(gv.wm_state) in Set(WM_STORE_QM_TX_ACTIVE, WM_STORE_QM_RX_FREE)
            ? old(gv.wm_state)
            : old(gv.wm_state) == WM_STORE_QM_W_DATA_RX_ACTIVE
                ? WM_STORE_QM_RX_ACTIVE
                : old(gv.wm_state) == WM_STORE_QM_W_DATA_TX_FREE
                    ? WM_STORE_QM_TX_FREE
                    : old(gv.wm_state) == WM_STORE_RX_STAT_PRE_RDAR
                        ? WM_STORE_RDAR
                        : old(gv.wm_state) == WM_STORE_TX_STAT_PRE_TDAR
                            ? WM_STORE_TDAR
                            : WM_NONE)
    ensures old(gv.wm_state) == WM_STORE_RX_QM_AND_BUF ==> acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_addr) && acc(slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_len)
    ensures old(gv.wm_state) == WM_STORE_RX_QM_AND_BUF ==>
        slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_addr == old(gv.wm_buf_addr) &&
        slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_len == old(gv.wm_buf_len)
    ensures old(gv.wm_state) == WM_STORE_RX_QM_AND_BUF ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head)
    ensures old(gv.wm_state) == WM_STORE_RX_QM_AND_BUF ==> gv.rx_free.net_head == old(gv.wm_qhead)
    ensures old(gv.wm_state) == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_stat, 1/2)
    ensures old(gv.wm_state) == WM_STORE_RX_STAT_PRE_RDAR ==> slot(gv.hardware_ring_rx, old(gv.wm_hw_slot)).hw_stat == old(gv.wm_stat)
    ensures old(gv.wm_state) == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.rx_await_ack) && gv.rx_await_ack == Seq[Int]()
    ensures old(gv.wm_state) == WM_STORE_RX_STAT_PRE_RDAR ==> acc(gv.wm_await_ack_data) && |gv.wm_await_ack_data| == 1 &&
              acc(gv.wm_await_ack_data[0].hw_addr) && acc(gv.wm_await_ack_data[0].hw_len) &&
              gv.wm_await_ack_data[0].hw_addr == old(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_addr) &&
              gv.wm_await_ack_data[0].hw_len == old(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_len)
    ensures old(gv.wm_state) == WM_STORE_TX_QM_AND_BUF ==> acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_addr) && acc(slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_len)
    ensures old(gv.wm_state) == WM_STORE_TX_QM_AND_BUF ==>
        slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_addr == old(gv.wm_buf_addr) &&
        slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_len == old(gv.wm_buf_len)
    ensures old(gv.wm_state) == WM_STORE_TX_QM_AND_BUF ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head)
    ensures old(gv.wm_state) == WM_STORE_TX_QM_AND_BUF ==> gv.tx_active.net_head == old(gv.wm_qhead)
    ensures old(gv.wm_state) == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_stat, 1/2)
    ensures old(gv.wm_state) == WM_STORE_TX_STAT_PRE_TDAR ==> slot(gv.hardware_ring_tx, old(gv.wm_hw_slot)).hw_stat == old(gv.wm_stat)
    ensures old(gv.wm_state) == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.tx_await_ack) && gv.tx_await_ack == Seq[Int]()
    ensures old(gv.wm_state) == WM_STORE_TX_STAT_PRE_TDAR ==> acc(gv.wm_await_ack_data) && |gv.wm_await_ack_data| == 1 &&
              acc(gv.wm_await_ack_data[0].hw_addr) && acc(gv.wm_await_ack_data[0].hw_len) &&
              gv.wm_await_ack_data[0].hw_addr == old(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_addr) &&
              gv.wm_await_ack_data[0].hw_len == old(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_len)
    ensures old(gv.wm_state) == WM_STORE_QM_TX_ACTIVE ==> acc(gv.tx_active, 1/4) &&
        acc(gv.tx_active.net_head, 1/4) && acc(gv.tx_active.net_descr, 1/4) && acc(gv.tx_active.net_removed) &&
        gv.tx_active.net_removed == old(gv.tx_active.net_removed) union
            Set(Seq(old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr), old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len)))
    ensures old(gv.wm_state) == WM_STORE_QM_TX_ACTIVE ==> acc(gv.wm_qaddr) && acc(gv.wm_qlen) &&
        gv.wm_qaddr == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_addr) &&
        gv.wm_qlen == old(slotq(gv.tx_active.net_descr, gv.tx_active.net_head).ndescr_len)
    ensures old(gv.wm_state) == WM_STORE_QM_RX_FREE ==> acc(gv.rx_free, 1/4) &&
        acc(gv.rx_free.net_head, 1/4) && acc(gv.rx_free.net_descr, 1/4) && acc(gv.rx_free.net_removed_addr) &&
        gv.rx_free.net_removed_addr == old(gv.rx_free.net_removed_addr) union Set(old(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr))
    ensures old(gv.wm_state) == WM_STORE_QM_RX_ACTIVE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail) &&
        gv.rx_active.net_tail == old(gv.wm_qtail)
    ensures old(gv.wm_state) == WM_STORE_QM_TX_FREE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail) &&
        gv.tx_free.net_tail == old(gv.wm_qtail)
    ensures old(gv.wm_state) == WM_STORE_QM_W_DATA_RX_ACTIVE ==> acc(gv.rx_active, 1/4) &&
        acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_descr, 1/4) && acc(gv.rx_active.net_added) &&
        gv.rx_active.net_added == old(gv.rx_active.net_added) union Set(Seq(old(gv.wm_qaddr), old(gv.wm_qlen)))
    ensures old(gv.wm_state) == WM_STORE_QM_W_DATA_TX_FREE ==> acc(gv.tx_free, 1/4) &&
        acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_descr, 1/4) && acc(gv.tx_free.net_added) &&
        gv.tx_free.net_added == old(gv.tx_free.net_added) union Set(Seq(old(gv.wm_qaddr), old(gv.wm_qlen)))
    ensures old(gv.wm_state) == WM_STORE_QM_W_DATA_RX_ACTIVE || old(gv.wm_state) == WM_STORE_QM_W_DATA_TX_FREE ==> acc(gv.wm_store_tail_count, 1/2)
    ensures old(gv.wm_state) == WM_STORE_RX_FREE_CONSUMER_SIGNALLED ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_signal) &&
        gv.rx_free.net_signal == old(gv.wm_consumer_signalled)
    ensures old(gv.wm_state) == WM_STORE_RX_ACTIVE_CONSUMER_SIGNALLED ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_signal) &&
        gv.rx_active.net_signal == old(gv.wm_consumer_signalled)
    ensures old(gv.wm_state) == WM_STORE_TX_FREE_CONSUMER_SIGNALLED ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal) &&
        gv.tx_free.net_signal == old(gv.wm_consumer_signalled)
    ensures old(gv.wm_state) == WM_STORE_TX_ACTIVE_CONSUMER_SIGNALLED ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_signal) &&
        gv.tx_active.net_signal == old(gv.wm_consumer_signalled)

method f_ffiTHREAD_MEMORY_ACQUIRE(heap: IArray, gv: Ref, a: Int, b: Int, c: Int, d: Int)
    requires a == 0 && b == 0 && c == 0 && d == 0
    requires acc(gv.wm_state)
    requires gv.wm_state == WM_LOAD_QM_TX_FREE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head) && acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_descr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_TX_FREE ==> 0 <= gv.tx_free.net_tail - gv.tx_free.net_head <= 256 &&
      forall i: Int :: gv.tx_free.net_tail <= i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
        acc(slotq(gv.tx_free.net_descr, i).ndescr_addr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_TX_ACTIVE ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_tail)
    requires gv.wm_state == WM_LOAD_QM_TX_ACTIVE ==> acc(gv.tx_active.net_removed, 1/4) && acc(gv.tx_handled, 1/4) &&
        acc(gv.tx_active.net_descr, 1/4) && acc(gv.tx_active.net_head, 1/4)
    requires gv.wm_state == WM_LOAD_QM_TX_ACTIVE ==> 0 <= gv.tx_active.net_tail - gv.tx_active.net_head <= 256 &&
      forall i: Int :: gv.tx_active.net_head <= i < gv.tx_active.net_tail ==>
        acc(slotq(gv.tx_active.net_descr, i).ndescr_addr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_RX_ACTIVE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_head)
    requires gv.wm_state == WM_LOAD_QM_RX_ACTIVE ==> acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_descr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_RX_ACTIVE ==> 0 <= gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
      forall i: Int :: gv.rx_active.net_tail <= i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
        acc(slotq(gv.rx_active.net_descr, i).ndescr_addr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_RX_FREE ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_tail)
    requires gv.wm_state == WM_LOAD_QM_RX_FREE ==> acc(gv.rx_free.net_removed_addr, 1/4) && acc(gv.rx_handled, 1/4) &&
      acc(gv.rx_free.net_descr, 1/4) && acc(gv.rx_free.net_head, 1/4)
    requires gv.wm_state == WM_LOAD_QM_RX_FREE ==> 0 <= gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
      forall i: Int :: gv.rx_free.net_head <= i < gv.rx_free.net_tail ==>
        acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 1/4)
    requires gv.wm_state == WM_LOAD_QM_TX_FREE ==> acc(gv.wm_qhead) && gv.wm_qhead >= gv.tx_free.net_head &&
        0 <= gv.tx_free.net_tail - gv.wm_qhead <= 256
    requires gv.wm_state == WM_LOAD_QM_RX_ACTIVE ==> acc(gv.wm_qhead) && gv.wm_qhead >= gv.rx_active.net_head &&
        0 <= gv.rx_active.net_tail - gv.wm_qhead <= 256
    requires gv.wm_state == WM_LOAD_QM_RX_FREE ==> acc(gv.wm_qtail) && gv.wm_qtail >= gv.rx_free.net_tail &&
        0 <= gv.wm_qtail - gv.rx_free.net_tail <= 256
    requires gv.wm_state == WM_LOAD_QM_TX_ACTIVE ==> acc(gv.wm_qtail) && gv.wm_qtail >= gv.tx_active.net_tail &&
        0 <= gv.wm_qtail - gv.tx_active.net_tail <= 256
    requires gv.wm_state == WM_LOAD_RX_ACTIVE_CONSUMER_SIGNALLED ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_signal)
    requires gv.wm_state == WM_LOAD_TX_FREE_CONSUMER_SIGNALLED ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal)
    requires gv.wm_state in Set(WM_LOAD_RX_ACTIVE_CONSUMER_SIGNALLED, WM_LOAD_TX_FREE_CONSUMER_SIGNALLED) ==> 
        acc(gv.wm_consumer_signalled)
    requires gv.wm_state == WM_LOAD_RX_STAT || gv.wm_state == WM_LOAD_TX_STAT ==>
        acc(gv.wm_stat) && acc(gv.wm_state_old) && acc(gv.wm_stat_old_was_empty) && acc(gv.wm_hw_slot)
    requires gv.wm_state == WM_LOAD_RX_STAT ==> acc(gv.hardware_ring_rx, 1/4) && acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_added, 1/4) &&
        acc(slot(gv.hardware_ring_rx, gv.wm_hw_slot).hw_stat, 3/4) &&
        forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && j != gv.wm_hw_slot ==>
            acc(slot(gv.hardware_ring_rx, j).hw_stat, 1/4) &&
            (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) ==> acc(slot(gv.hardware_ring_rx, j).hw_addr, 1/4))
    requires gv.wm_state == WM_LOAD_TX_STAT ==> acc(gv.hardware_ring_tx, 1/4) && acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_added, 1/4) &&
        acc(slot(gv.hardware_ring_tx, gv.wm_hw_slot).hw_stat, 3/4) &&
        forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && j != gv.wm_hw_slot ==>
            acc(slot(gv.hardware_ring_tx, j).hw_stat, 1/4) &&
            (!is_TXD_READY(slot(gv.hardware_ring_tx, j).hw_stat) ==> acc(slot(gv.hardware_ring_tx, j).hw_addr, 1/4))
    ensures acc(gv.wm_state) && gv.wm_state ==
        (old(gv.wm_state) in Set(WM_LOAD_RX_STAT, WM_LOAD_TX_STAT) ? old(gv.wm_state_old) : WM_NONE)
    ensures old(gv.wm_state) == WM_LOAD_QM_TX_FREE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head)
    ensures old(gv.wm_state) == WM_LOAD_QM_TX_FREE ==> gv.tx_free.net_head == old(gv.wm_qhead)
    ensures old(gv.wm_state) == WM_LOAD_QM_TX_FREE ==> acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_descr, 1/4) &&
      0 <= gv.tx_free.net_tail - old(gv.tx_free.net_head) <= 256 &&
      forall i: Int :: gv.tx_free.net_tail <= i < old(gv.tx_free.net_head) + QUEUE_CAPACITY ==>
        acc(slotq(gv.tx_free.net_descr, i).ndescr_addr, 1/4)
    ensures old(gv.wm_state) == WM_LOAD_QM_TX_FREE ==> 0 <= gv.tx_free.net_tail - gv.tx_free.net_head <= 256
    ensures old(gv.wm_state) == WM_LOAD_QM_TX_FREE ==> forall i: Int :: old(gv.tx_free.net_head) + QUEUE_CAPACITY <= i < gv.tx_free.net_head + QUEUE_CAPACITY ==>
