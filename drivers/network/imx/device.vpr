///////////////////////////// RDAR and TDAR registers
define RDAR_RDAR        16777216    // 1 << 24
define TDAR_TDAR        16777216    // 1 << 24

method store_RDAR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + RDAR_offset)
    requires value == RDAR_RDAR
    requires acc(gv.rx_await_ack) && acc(gv.rx_handled) && acc(gv.hardware_ring_rx, 1/2)
    requires forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j]
    requires forall i: Int :: i in gv.rx_await_ack ==>
                acc(slot(gv.hardware_ring_rx, i).hw_addr) &&
                acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
                acc(slot(gv.hardware_ring_rx, i).hw_len) &&
                is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat)
    ensures acc(gv.rx_await_ack) && gv.rx_await_ack == Seq[Int]() && acc(gv.rx_handled) && acc(gv.hardware_ring_rx, 1/2)
    ensures forall i: Int :: i in old(gv.rx_await_ack) ==> acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2)
    ensures forall x: Seq[Int] :: x in old(gv.rx_handled) ==> x in gv.rx_handled
    ensures forall i: Int :: 0 <= i && i < old(|gv.rx_await_ack|) ==> old(Seq(
              slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr, slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len)) in gv.rx_handled
    ensures forall x: Seq[Int] :: x in gv.rx_handled ==> x in old(gv.rx_handled) ||
                (|x| == 2 && exists i: Int :: (0 <= i && i < old(|gv.rx_await_ack|) && x == Seq(
                    old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr), old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len))))
{
    var ix: Int := 0
    while (ix < |gv.rx_await_ack|)
        invariant acc(gv.rx_await_ack, 1/2) && acc(gv.rx_handled) && acc(gv.hardware_ring_rx, 1/2)
        invariant forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
            gv.rx_await_ack[i] != gv.rx_await_ack[j]
        invariant forall j: Int :: 0 <= j && j < |gv.rx_await_ack| ==>
            gv.rx_await_ack[j] in gv.rx_await_ack
        invariant forall i: Int :: i in gv.rx_await_ack ==>
            acc(slot(gv.hardware_ring_rx, i).hw_addr, 1/2) &&
            acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
            acc(slot(gv.hardware_ring_rx, i).hw_len, 1/2) &&
            is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat)
        invariant |gv.rx_await_ack| == old(|gv.rx_await_ack|)
        invariant forall i: Int :: 0 <= i && i < old(|gv.rx_await_ack|) ==>
            old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr) == slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr &&
            old(slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len) == slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len
        invariant forall x: Seq[Int] :: x in old(gv.rx_handled) ==> x in gv.rx_handled
        invariant 0 <= ix
        invariant forall i: Int :: 0 <= i && i < ix && i < |gv.rx_await_ack| ==> Seq(
                    slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr, slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len) in gv.rx_handled
        invariant forall x: Seq[Int] :: x in gv.rx_handled ==> x in old(gv.rx_handled) ||
                    (|x| == 2 && exists i: Int :: 0 <= i && i < |gv.rx_await_ack| && x == Seq(
                        slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_addr, slot(gv.hardware_ring_rx, gv.rx_await_ack[i]).hw_len))
    {
        gv.rx_handled := gv.rx_handled union Set(Seq(slot(gv.hardware_ring_rx, gv.rx_await_ack[ix]).hw_addr, slot(gv.hardware_ring_rx, gv.rx_await_ack[ix]).hw_len))
        ix := ix + 1
    }
    assert gv.rx_await_ack == old(gv.rx_await_ack)
    gv.rx_await_ack := Seq[Int]()
    refute false
}

method store_TDAR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + TDAR_offset)
    requires value == TDAR_TDAR
    requires acc(gv.tx_await_ack) && acc(gv.tx_handled) && acc(gv.hardware_ring_tx, 1/2)
    requires forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
        gv.tx_await_ack[i] != gv.tx_await_ack[j]
    requires forall i: Int :: i in gv.tx_await_ack ==>
                acc(slot(gv.hardware_ring_tx, i).hw_addr) &&
                acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
                acc(slot(gv.hardware_ring_tx, i).hw_len) &&
                is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat)
    ensures acc(gv.tx_await_ack) && gv.tx_await_ack == Seq[Int]() && acc(gv.tx_handled) && acc(gv.hardware_ring_tx, 1/2)
    ensures forall i: Int :: i in old(gv.tx_await_ack) ==> acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2)
    ensures forall x: Seq[Int] :: x in old(gv.tx_handled) ==> x in gv.tx_handled
    ensures forall i: Int :: 0 <= i && i < old(|gv.tx_await_ack|) ==> old(Seq(
              slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr, slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len)) in gv.tx_handled
    ensures forall x: Seq[Int] :: x in gv.tx_handled ==> x in old(gv.tx_handled) ||
                (|x| == 2 && exists i: Int :: (0 <= i && i < old(|gv.tx_await_ack|) && x == Seq(
                    old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr), old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len))))
{
    var ix: Int := 0
    while (ix < |gv.tx_await_ack|)
        invariant acc(gv.tx_await_ack, 1/2) && acc(gv.tx_handled) && acc(gv.hardware_ring_tx, 1/2)
        invariant forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
            gv.tx_await_ack[i] != gv.tx_await_ack[j]
        invariant forall j: Int :: 0 <= j && j < |gv.tx_await_ack| ==>
            gv.tx_await_ack[j] in gv.tx_await_ack
        invariant forall i: Int :: i in gv.tx_await_ack ==>
            acc(slot(gv.hardware_ring_tx, i).hw_addr, 1/2) &&
            acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
            acc(slot(gv.hardware_ring_tx, i).hw_len, 1/2) &&
            is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat)
        invariant |gv.tx_await_ack| == old(|gv.tx_await_ack|)
        invariant forall i: Int :: 0 <= i && i < old(|gv.tx_await_ack|) ==>
            old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr) == slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr &&
            old(slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len) == slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len
        invariant forall x: Seq[Int] :: x in old(gv.tx_handled) ==> x in gv.tx_handled
        invariant 0 <= ix
        invariant forall i: Int :: 0 <= i && i < ix && i < |gv.tx_await_ack| ==> Seq(
                    slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr, slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len) in gv.tx_handled
        invariant forall x: Seq[Int] :: x in gv.tx_handled ==> x in old(gv.tx_handled) ||
                    (|x| == 2 && exists i: Int :: 0 <= i && i < |gv.tx_await_ack| && x == Seq(
                        slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_addr, slot(gv.hardware_ring_tx, gv.tx_await_ack[i]).hw_len))
    {
        gv.tx_handled := gv.tx_handled union Set(Seq(slot(gv.hardware_ring_tx, gv.tx_await_ack[ix]).hw_addr, slot(gv.hardware_ring_tx, gv.tx_await_ack[ix]).hw_len))
        ix := ix + 1
    }
    assert gv.tx_await_ack == old(gv.tx_await_ack)
    gv.tx_await_ack := Seq[Int]()
    refute false
}

/////////////////////////////

///////////////////////////// EIR register
/*
 *         EIR register
 * ┌─────────────────────────┐
 * │     indicates RX IRQ    │
 * │         ▲               │
 * │         │               │
 * │─────────┴───────────────│
 * │31  27  25              0│
 * │    │                    │
 * │    ▼                    │
 * │   indicates TX IRQ      │
 * └─────────────────────────┘
*/
define EIR_RXF_MASK     33554432    // 1 << 25
define EIR_TXF_MASK     134217728   // 1 << 27
define IRQ_MASK         171966464   // (1 << 25) | (1 << 27) | (1 << 22)

function is_EIR_RXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_RXF_MASK))) != 0

function is_EIR_TXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_TXF_MASK))) != 0

method store_EIR(heap: IArray, gv: Ref, address: Int, value: Int)
    requires address == (REG_BASE + EIR_offset)
    requires bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(IRQ_MASK))) == value
{
    refute false
}

method load_EIR(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires address == (REG_BASE + EIR_offset)
    ensures bounded32(retval)
{
    retval := ND_bounded32()
    refute false
}
/////////////////////////////

// helpers because the transpiler is bad at some things
function f_union_elem(heap: IArray, gv: Ref, s: Set[Int], t: Set[Int], e: Int): Bool
{
    s == t union Set(e)
}

function f_union_elem_seq(heap: IArray, gv: Ref, s: Set[Seq[Int]], t: Set[Seq[Int]], e: Seq[Int]): Bool
{
    s == t union Set(e)
}

function f_setminus_seqint(heap: IArray, gv: Ref, s: Set[Seq[Int]], t: Set[Seq[Int]]): Set[Seq[Int]]
{
    s setminus t
}

function f_size_seqint(heap: IArray, gv: Ref, s: Set[Seq[Int]]): Int
{
    |s|
}

function f_append_elem(heap: IArray, gv: Ref, s: Seq[Int], t: Seq[Int], e: Int): Bool
{
    s == t ++ Seq(e)
}

function f_empty_set(heap: IArray, gv: Ref): Set[Int]
{
    Set[Int]()
}

function f_empty_seq(heap: IArray, gv: Ref): Seq[Int]
{
    Seq[Int]()
}

function f_element_set(heap: IArray, gv: Ref, e: Int): Set[Int]
{
    Set(e)
}

function f_element_seq(heap: IArray, gv: Ref, e: Int): Seq[Int]
{
    Seq(e)
}

function f_element2_seq(heap: IArray, gv: Ref, e1: Int, e2: Int): Seq[Int]
{
    Seq(e1, e2)
}

