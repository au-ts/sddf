               !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat)) &&
    (unfolding valid_hardware_ring_rx_read(heap, gv) in
        forall i: Int, j: Int :: 0 <= i && i < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
            0 <= j && j < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
            slot(gv.hardware_ring_rx, i).hw_addr == slot(gv.hardware_ring_rx, j).hw_addr ==>
                i == j)
}*/
define valid_hardware_ring_rx_mdata_read(heap, gv)
(
    bounded16(gv.hw_rx_head) &&
    0 <= (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) <= gv.hw_rx_capacity &&
    gv.hw_rx_capacity == 256 &&
    (unfolding valid_hardware_ring_rx_read(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
            (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
             (gv.hw_rx_tail % gv.hw_rx_capacity < gv.hw_rx_head % gv.hw_rx_capacity
               ? i >= gv.hw_rx_tail % gv.hw_rx_capacity && i < gv.hw_rx_head % gv.hw_rx_capacity
               : i >= gv.hw_rx_tail % gv.hw_rx_capacity || i < gv.hw_rx_head % gv.hw_rx_capacity) ==>
               !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) && !slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_rx_read(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
            !((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
              (gv.hw_rx_tail % gv.hw_rx_capacity < gv.hw_rx_head % gv.hw_rx_capacity
                ? i >= gv.hw_rx_tail % gv.hw_rx_capacity && i < gv.hw_rx_head % gv.hw_rx_capacity
                : i >= gv.hw_rx_tail % gv.hw_rx_capacity || i < gv.hw_rx_head % gv.hw_rx_capacity)) &&
                !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
                  slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_rx_read(heap, gv) in
        forall i: Int, j: Int :: 0 <= i && i < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
            0 <= j && j < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
            slot(gv.hardware_ring_rx, i).hw_addr == slot(gv.hardware_ring_rx, j).hw_addr ==>
                i == j)
)

function f_ring_head_incr_lemma(heap: IArray, gv: Ref, a: Int, b: Int, i: Int): Bool
    requires 0 <= i && i <= 256
    requires a != b
    requires 0 <= (a - b) % 65536 && (a - b) % 65536 <= 256
    requires 0 <= a < 65536
    requires 0 <= b < 65536
    requires (a % 256 < b % 256 || (a - b) % 65536 == 256) ?
                        i >= a % 256 && i < b % 256 :
                        i >= a % 256 || i < b % 256
    requires true
    ensures result == true
{
    let b_ == ((b + 1) % 65536) in ((a % 256 < b_ % 256 || (a - b_) % 65536 == 256) ?
                        i >= a % 256 && i < b_ % 256 :
                        i >= a % 256 || i < b_ % 256)
}
/*define f_ring_head_incr_lemma(heap, gv, a, b, i) (
    a != b && 0 <= (a - b) % 65536 && (a - b) % 65536 <= 256 &&
      ((a % 256 < b % 256 || (a - b) % 65536 == 256) ?
                        i >= a % 256 && i < b % 256 :
                        i >= a % 256 || i < b % 256) &&
    let b_ == ((b + 1) % 65536) in ((a % 256 < b_ % 256 || (a - b_) % 65536 == 256) ?
                        i >= a % 256 && i < b_ % 256 :
                        i >= a % 256 || i < b_ % 256)
)*/

predicate valid_hardware_ring_rx_write(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_rx, write) &&
    (forall i: Int :: //{ slot(gv.hardware_ring_rx, i).hw_stat }
        i >= 0 && i < hw_capacity ==> acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2)) &&
    (forall i: Int ::
//        { bounded16(slot(gv.hardware_ring_rx, i).hw_stat) }
//        { bounded32(slot(gv.hardware_ring_rx, i).hw_stat) }
//        { bounded64(slot(gv.hardware_ring_rx, i).hw_stat) }
        i >= 0 && i < hw_capacity ==> bounded16(slot(gv.hardware_ring_rx, i).hw_stat)) &&
    (forall i: Int ::// { is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_addr }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).hw_addr, write) &&
            is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr)) &&
    (forall i: Int ::// { is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_stat }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
            is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat)) &&
    (forall i: Int ::// { is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).hw_len }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).hw_len, write) &&
            is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len)) &&
    (forall i: Int ::// { is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat), slot(gv.hardware_ring_rx, i).ghost_unprocessed }
        i >= 0 && i < hw_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_rx, i).ghost_unprocessed))
}

