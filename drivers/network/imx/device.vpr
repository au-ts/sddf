/*  Devcie hardware descriptor:
 *  ┌───────────────────┬────┬────┬─────────┐
 *  │                   │    │    │         │
 *  │       addr        │stat│  0 │   len   │
 *  └───────────────────┴────┴────┴─────────┘
 *  8                   4    3    2         0  (byte)
 *
 *            RX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │        │  │
 *       ▼     ▼        ▼  ▼
 * RXD_EMPTY  WRAP      0  0
 *
 *            TX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │              │
 *       ▼     ▼              ▼
 * TXD_READY  WRAP            0
*/

define WRAP_MASK        32      // 1 << 5
define RXD_EMPTY_MASK   128     // 1 << 7
define TXD_READY_MASK   128     // 1 << 7
define RX_STAT_MASK     6       // (1 << 1) | (1 << 2) == 6
define TX_STAT_MASK     1

function is_WRAP(value: Int): Bool
    requires bounded8(value)
    ensures result == (bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(WRAP_MASK))) != 0)

function is_RXD_EMPTY(value: Int): Bool
    requires is_valid_rx_stat(value)
    ensures result == (bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(RXD_EMPTY_MASK))) != 0)

function is_TXD_READY(value: Int): Bool
    requires is_valid_tx_stat(value)
    ensures result == (bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(TXD_READY_MASK))) != 0)

function is_valid_data_addr(value: Int): Bool
    ensures result <==> bounded32(value)

/* In RX stat, 1st and 2nd bit in the stat field must be cleared */
function is_valid_rx_stat(value: Int): Bool
    ensures result <==> bounded8(value) && (bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(RX_STAT_MASK))) == 0)

function valid_rx_stat(): Int
    ensures is_valid_rx_stat(result)

/* In TX stat, 0-th bit in the stat field must be cleared */
function is_valid_tx_stat(value: Int): Bool
    ensures result <==> bounded8(value) && (bv64_to_int(bv64_and(bv64_from_int(value), bv64_from_int(TX_STAT_MASK))) == 0)

function valid_tx_stat(): Int
    ensures is_valid_tx_stat(result)

function is_valid_data_len(value: Int): Bool
    ensures result <==> bounded16(value)

function valid_desc_len(): Int
    ensures is_valid_data_len(result)

///////////////////////////// device state
field hardware_ring_rx_addr: Seq[Int]
field hardware_ring_tx_addr: Seq[Int]
field hardware_ring_rx_stat: Seq[Int]
field hardware_ring_tx_stat: Seq[Int]
field hardware_ring_rx_len:  Seq[Int]
field hardware_ring_tx_len:  Seq[Int]
/////////////////////////////

/* Hardware ring stat WRAP:
 * According to the imx8mm manual that:
 * > Wrap. Written by user.
 * > 0 The next buffer descriptor is found in the consecutive location.
 * > 1 The next buffer descriptor is found at the location defined in ENETn_RDSR.
 * This applies to both receive (rx) and transmit (tx) sides.
 * We want to make sure that the WRAP bit in the buffer descriptor is set iff
 * the descriptor is at the last slot in the contiguous hardware ring region.
 *
 * TLDR:
 * The last slot of hardware_ring_*_stat[] must have WRAP set.
 * Other slots must not have WRAP set.
*/
predicate valid_device(heap: IArray, device: Ref, virt: Ref)
{
    valid_hardware_ring_rx_addr(heap, device, virt) &&
    valid_hardware_ring_rx_stat(heap, device, virt) &&
    valid_hardware_ring_rx_len(heap, device, virt) &&
    valid_hardware_ring_tx_addr(heap, device, virt) &&
    valid_hardware_ring_tx_stat(heap, device, virt) &&
    valid_hardware_ring_tx_len(heap, device, virt)
}

predicate valid_hardware_ring_rx_addr(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_rx_addr) &&
    |device.hardware_ring_rx_addr| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_rx_addr[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_data_addr(device.hardware_ring_rx_addr[i]))
}

predicate valid_hardware_ring_tx_addr(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_tx_addr) &&
    |device.hardware_ring_tx_addr| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_tx_addr[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_data_addr(device.hardware_ring_tx_addr[i]))
}

predicate valid_hardware_ring_rx_len(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_rx_len) &&
    |device.hardware_ring_rx_len| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_rx_len[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_data_len(device.hardware_ring_rx_len[i]))
}

predicate valid_hardware_ring_tx_len(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_tx_len) &&
    |device.hardware_ring_tx_len| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_tx_len[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_data_len(device.hardware_ring_tx_len[i]))
}

predicate valid_hardware_ring_rx_stat(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_rx_stat) &&
    |device.hardware_ring_rx_stat| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_rx_stat[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_rx_stat(device.hardware_ring_rx_stat[i])) &&
    // the last slot in stat has WRAP set
    is_WRAP(device.hardware_ring_rx_stat[hw_capacity - 1]) &&
    // other slots in stat don't have WRAP set
    (forall i: Int:: {device.hardware_ring_rx_stat[i]}
        (i >= 0 && i < hw_capacity - 1) ==> !is_WRAP(device.hardware_ring_rx_stat[i]))
}

predicate valid_hardware_ring_tx_stat(heap: IArray, device: Ref, virt: Ref)
{
    acc(device.hardware_ring_tx_stat) &&
    |device.hardware_ring_tx_stat| == hw_capacity &&
    (forall i: Int:: {device.hardware_ring_tx_stat[i]}
        (i >= 0 && i < hw_capacity) ==> is_valid_tx_stat(device.hardware_ring_tx_stat[i])) &&
    // the last slot in stat has WRAP set
    is_WRAP(device.hardware_ring_tx_stat[hw_capacity - 1]) &&
    // other slots in stat don't have WRAP set
    (forall i: Int:: {device.hardware_ring_tx_stat[i]}
        (i >= 0 && i < hw_capacity - 1) ==> !is_WRAP(device.hardware_ring_tx_stat[i]))
}

// todo: not sure if we need these unchanged stuff
define device_rx_all_unchanged(heap, device, virt)
    device_rx_addr_unchanged(heap, device, virt) &&
    device_rx_len_unchanged(heap, device, virt)

define device_tx_all_unchanged(heap, device, virt)
    device_tx_addr_unchanged(heap, device, virt) &&
    device_tx_len_unchanged(heap, device, virt)

define device_rx_addr_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_addr(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_rx_addr[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_rx_addr[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_addr(heap, device, virt) in device.hardware_ring_rx_addr[i]))

define device_rx_stat_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_stat(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_rx_stat[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_rx_stat[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_stat(heap, device, virt) in device.hardware_ring_rx_stat[i]))

define device_rx_len_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_len(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_rx_len[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_rx_len[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_len(heap, device, virt) in device.hardware_ring_rx_len[i]))

define device_tx_addr_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_addr(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_tx_addr[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_tx_addr[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_addr(heap, device, virt) in device.hardware_ring_tx_addr[i]))

define device_tx_stat_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_stat(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_tx_stat[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_tx_stat[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_stat(heap, device, virt) in device.hardware_ring_tx_stat[i]))

define device_tx_len_unchanged(heap, device, virt)
    (unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_len(heap, device, virt) in
        forall i: Int:: {device.hardware_ring_tx_len[i]}
        i >= 0 && i < hw_capacity ==> device.hardware_ring_tx_len[i] ==
        old(unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_tx_len(heap, device, virt) in device.hardware_ring_tx_len[i]))

/* The below methods are pretty much similar to each other.
 * Bascially for stat, len, and addr udpate, we make sure that:
 * - For pre-conditions:
 *   - The given value is valid
 * - For post-conditions:
 *   - The speicified slot (by calculating via the given address) is updated properly to the give value
 *   - Other slots of the field are remained unchagned
 *   - Other fields of the device are remained unchanged
 *   - Device state remains valid
*/
// todo: can we have disjoint address chunks that give the same method?
method store_hw_ring_rx_addr(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires valid_device(heap, device, virt)
    requires (address - 4) >= hw_ring_rx_addr && (address - 4) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 4) % 8 == 0
    requires is_valid_data_addr(value)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    // check that the specified slot in the hardware ring is updated
    ensures unfolding valid_device(heap, device, virt) in unfolding valid_hardware_ring_rx_addr(heap, device, virt) in
        device.hardware_ring_rx_addr[(address - 4 - hw_ring_rx_addr) / hw_descriptor_size] == value
    // check that other slots are not modified
    ensures device_rx_len_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    unfold valid_device(heap, device, virt)
    unfold valid_hardware_ring_rx_addr(heap, device, virt)
    var index: Int := (address - 4 - hw_ring_rx_addr) / hw_descriptor_size
    device.hardware_ring_rx_addr := device.hardware_ring_rx_addr[index := value]
    fold valid_hardware_ring_rx_addr(heap, device, virt)
    fold valid_device(heap, device, virt)
    refute false
}

method store_hw_ring_tx_addr(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires valid_device(heap, device, virt)
    requires (address - 4) >= hw_ring_tx_addr && (address - 4) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 4) % 8 == 0
    requires is_valid_data_addr(value)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    // check that the specified slot in the hardware ring is updated
    ensures unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_tx_addr(heap, device, virt) in
        device.hardware_ring_tx_addr[(address - 4 - hw_ring_tx_addr) / hw_descriptor_size] == value
    // check that other slots are not modified
    ensures device_tx_len_unchanged(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
{
    unfold valid_device(heap, device, virt)
    unfold valid_hardware_ring_tx_addr(heap, device, virt)
    var index: Int := (address - 4 - hw_ring_tx_addr) / hw_descriptor_size
    device.hardware_ring_tx_addr := device.hardware_ring_tx_addr[index := value]
    fold valid_hardware_ring_tx_addr(heap, device, virt)
    fold valid_device(heap, device, virt)
    refute false
}

method store_hw_ring_rx_stat(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires valid_device(heap, device, virt)
    requires (address - 3) >= hw_ring_rx_addr && (address - 3) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 3) % 8 == 0
    requires is_valid_rx_stat(value)
    requires is_RXD_EMPTY(value)
    // make sure the given value is wrapped properly
    requires (((address - 3 - hw_ring_rx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    // check that the specified slot in the hardware ring is updated
    ensures unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_rx_stat(heap, device, virt) in
        device.hardware_ring_rx_stat[(address - 3 - hw_ring_rx_addr) / hw_descriptor_size] == value
    // check that other slots are not modified
    ensures device_rx_addr_unchanged(heap, device, virt)
    ensures device_rx_len_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    unfold valid_device(heap, device, virt)
    unfold valid_hardware_ring_rx_stat(heap, device, virt)
    var index: Int := (address - 3 - hw_ring_rx_addr) / hw_descriptor_size
    device.hardware_ring_rx_stat := device.hardware_ring_rx_stat[index := value]
    fold valid_hardware_ring_rx_stat(heap, device, virt)
    fold valid_device(heap, device, virt)
    refute false
}

method load_hw_ring_rx_stat(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int)
    returns (retval: Int)
    requires valid_device(heap, device, virt)
    requires (address - 3) % 8 == 0
    requires (address - 3) >= hw_ring_rx_addr && (address - 3) < (hw_ring_rx_addr + hw_ring_rx_size)
    ensures valid_device(heap, device, virt)
    ensures address == old(address)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
    ensures retval == unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_rx_stat(heap, device, virt) in
        device.hardware_ring_rx_stat[(address - 3 - hw_ring_rx_addr) / hw_descriptor_size]
    ensures is_valid_rx_stat(retval)
{
    retval := unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_rx_stat(heap, device, virt) in
        device.hardware_ring_rx_stat[(address - 3 - hw_ring_rx_addr) / hw_descriptor_size]
    refute false
}

method store_hw_ring_tx_stat(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires valid_device(heap, device, virt)
    requires (address - 3) >= hw_ring_tx_addr && (address - 3) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 3) % 8 == 0
    requires is_valid_tx_stat(value)
    requires is_TXD_READY(value)
    requires (((address - 3 - hw_ring_tx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    ensures unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_tx_stat(heap, device, virt) in
        device.hardware_ring_tx_stat[(address - 3 - hw_ring_tx_addr) / hw_descriptor_size] == value
    ensures device_tx_addr_unchanged(heap, device, virt)
    ensures device_tx_len_unchanged(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
{
    unfold valid_device(heap, device, virt)
    unfold valid_hardware_ring_tx_stat(heap, device, virt)
    var index: Int := (address - 3 - hw_ring_tx_addr) / hw_descriptor_size
    device.hardware_ring_tx_stat := device.hardware_ring_tx_stat[index := value]
    fold valid_hardware_ring_tx_stat(heap, device, virt)
    fold valid_device(heap, device, virt)
    refute false
}

method load_hw_ring_tx_stat(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int)
    returns (retval: Int)
    requires valid_device(heap, device, virt)
    requires (address - 3) % 8 == 0
    requires (address - 3) >= hw_ring_tx_addr && (address - 3) < (hw_ring_tx_addr + hw_ring_tx_size)
    ensures valid_device(heap, device, virt)
    ensures address == old(address)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
    ensures retval == unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_tx_stat(heap, device, virt) in
        device.hardware_ring_tx_stat[(address - 3 - hw_ring_tx_addr) / hw_descriptor_size]
    ensures is_valid_tx_stat(retval)
{
    retval := unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_tx_stat(heap, device, virt) in
        device.hardware_ring_tx_stat[(address - 3 - hw_ring_tx_addr) / hw_descriptor_size]
    refute false
}

method load_hw_ring_rx_len(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int)
    returns (retval: Int)
    requires valid_device(heap, device, virt)
    requires address >= hw_ring_rx_addr && address < (hw_ring_rx_addr + hw_ring_rx_size)
    requires address % 8 == 0
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
    ensures address == old(address)
    ensures retval == unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_rx_len(heap, device, virt) in
        device.hardware_ring_rx_len[(address - hw_ring_rx_addr) / hw_descriptor_size]
    ensures is_valid_data_len(retval)
{
    // todo: load the correspoding field
    retval := unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_rx_len(heap, device, virt) in
        device.hardware_ring_rx_len[(address - hw_ring_rx_addr) / hw_descriptor_size]
    refute false
}

method store_hw_ring_tx_len(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires valid_device(heap, device, virt)
    requires address >= hw_ring_tx_addr && address < (hw_ring_tx_addr + hw_ring_tx_size)
    requires address % 8 == 0
    requires is_valid_data_len(value)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    // check that the specified slot in the hardware ring is updated
    ensures unfolding valid_device(heap, device, virt) in
        unfolding valid_hardware_ring_tx_len(heap, device, virt) in
        device.hardware_ring_tx_len[(address - hw_ring_tx_addr) / hw_descriptor_size] == value
    // check that other slots are not modified
    ensures device_tx_addr_unchanged(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
{
    unfold valid_device(heap, device, virt)
    unfold valid_hardware_ring_tx_len(heap, device, virt)
    var index: Int := (address - hw_ring_tx_addr) / hw_descriptor_size
    device.hardware_ring_tx_len := device.hardware_ring_tx_len[index := value]
    fold valid_hardware_ring_tx_len(heap, device, virt)
    fold valid_device(heap, device, virt)
    refute false
}

method store_hw_ring_reserve(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires ((address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size))
    requires (address - 2) % 8 == 0
    requires value == 0
    requires valid_device(heap, device, virt)
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    refute false
}

///////////////////////////// RDAR and TDAR registers
define RDAR_RDAR        16777216    // 1 << 24
define TDAR_TDAR        16777216    // 1 << 24

method store_RDAR(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires address == (REG_BASE + RDAR_offset)
    requires value == RDAR_RDAR
    requires valid_device(heap, device, virt)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    refute false
}

method store_TDAR(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires address == (REG_BASE + TDAR_offset)
    requires value == TDAR_TDAR
    requires valid_device(heap, device, virt)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    refute false
}
/////////////////////////////

///////////////////////////// EIR register
/*
 *         EIR register
 * ┌─────────────────────────┐
 * │     indicates RX IRQ    │
 * │         ▲               │
 * │         │               │
 * │─────────┴───────────────│
 * │31  27  25              0│
 * │    │                    │
 * │    ▼                    │
 * │   indicates TX IRQ      │
 * └─────────────────────────┘
*/
define EIR_RXF_MASK     33554432    // 1 << 25
define EIR_TXF_MASK     134217728   // 1 << 27
define IRQ_MASK         167772160   // (1 << 25) | (1 << 27)

function is_EIR_RXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_RXF_MASK))) != 0

function is_EIR_TXF(eir: Int): Bool
    ensures result <==> bv64_to_int(bv64_and(bv64_from_int(eir), bv64_from_int(EIR_TXF_MASK))) != 0

method store_EIR(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int, value: Int)
    requires address == (REG_BASE + EIR_offset)
    requires value == IRQ_MASK
    requires valid_device(heap, device, virt)
    ensures address == old(address)
    ensures value == old(value)
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    refute false
}

method load_EIR(heap: IArray, gv: Ref, device: Ref, virt: Ref, address: Int)
    returns (retval: Int)
    requires address == (REG_BASE + EIR_offset)
    requires valid_device(heap, device, virt)
    ensures bounded32(retval)
    ensures address == old(address)
    ensures valid_device(heap, device, virt)
    ensures device_rx_all_unchanged(heap, device, virt)
    ensures device_tx_all_unchanged(heap, device, virt)
{
    retval := ND_bounded32()
    refute false
}
