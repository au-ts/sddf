define valid_hardware_ring_rx_mdata_write(heap, gv)
(
    bounded16(gv.hw_rx_head) &&
    0 <= (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) <= gv.hw_rx_capacity &&
    gv.hw_rx_capacity == 256 &&
    (unfolding valid_hardware_ring_rx_write(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
            (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
             ((gv.hw_rx_tail % gv.hw_rx_capacity) < (gv.hw_rx_head % gv.hw_rx_capacity)
               ? i >= (gv.hw_rx_tail % gv.hw_rx_capacity) && i < (gv.hw_rx_head % gv.hw_rx_capacity)
               : i >= (gv.hw_rx_tail % gv.hw_rx_capacity) || i < (gv.hw_rx_head % gv.hw_rx_capacity)) ==>
               !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) && !slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_rx_write(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
            !((gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
              (gv.hw_rx_tail % gv.hw_rx_capacity < gv.hw_rx_head % gv.hw_rx_capacity
                ? i >= gv.hw_rx_tail % gv.hw_rx_capacity && i < gv.hw_rx_head % gv.hw_rx_capacity
                : i >= gv.hw_rx_tail % gv.hw_rx_capacity || i < gv.hw_rx_head % gv.hw_rx_capacity)) &&
                !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
                  slot(gv.hardware_ring_rx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_rx_write(heap, gv) in
        forall i: Int, j: Int :: 0 <= i && i < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
            0 <= j && j < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
            slot(gv.hardware_ring_rx, i).hw_addr == slot(gv.hardware_ring_rx, j).hw_addr ==>
                i == j)
)

define valid_tx_read_slot(x) (
    acc(x.hw_addr, 3/4) &&
    is_valid_data_addr(x.hw_addr) &&
    is_valid_tx_stat(x.hw_stat) &&
    acc(x.hw_len, 3/4) &&
    is_valid_data_len(x.hw_len) &&
    acc(x.ghost_unprocessed)
)

predicate valid_hardware_ring_tx_read(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_tx, 3/4) &&
    (forall i: Int :: //{ slot(gv.hardware_ring_tx, i).hw_stat }
        i >= 0 && i < hw_capacity ==> acc(slot(gv.hardware_ring_tx, i).hw_stat, 3/4)) &&
    (forall i: Int ::
        //{ bounded16(slot(gv.hardware_ring_tx, i).hw_stat) }
        //{ bounded32(slot(gv.hardware_ring_tx, i).hw_stat) }
        //{ bounded64(slot(gv.hardware_ring_tx, i).hw_stat) }
        i >= 0 && i < hw_capacity ==>
        bounded16(slot(gv.hardware_ring_tx, i).hw_stat)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_addr }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).hw_addr, 3/4) &&
            is_valid_data_addr(slot(gv.hardware_ring_tx, i).hw_addr)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_stat }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            is_valid_tx_stat(slot(gv.hardware_ring_tx, i).hw_stat)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_len }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).hw_len, 3/4) &&
            is_valid_data_len(slot(gv.hardware_ring_tx, i).hw_len)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).ghost_unprocessed }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).ghost_unprocessed))
}

