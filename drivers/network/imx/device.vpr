                i == j)
}*/
define valid_hardware_ring_tx_mdata_read(heap, gv)
(
    0 <= (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) <= gv.hw_tx_capacity &&
    gv.hw_tx_capacity == 256 &&
    (unfolding valid_hardware_ring_tx_read(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
            (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
             ((gv.hw_tx_tail % gv.hw_tx_capacity) < (gv.hw_tx_head % gv.hw_tx_capacity)
               ? i >= (gv.hw_tx_tail % gv.hw_tx_capacity) && i < (gv.hw_tx_head % gv.hw_tx_capacity)
               : i >= (gv.hw_tx_tail % gv.hw_tx_capacity) || i < (gv.hw_tx_head % gv.hw_tx_capacity)) ==>
               !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) && !slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_tx_read(heap, gv) in
        forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
            !((gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
              (gv.hw_tx_tail % gv.hw_tx_capacity < gv.hw_tx_head % gv.hw_tx_capacity
                ? i >= gv.hw_tx_tail % gv.hw_tx_capacity && i < gv.hw_tx_head % gv.hw_tx_capacity
                : i >= gv.hw_tx_tail % gv.hw_tx_capacity || i < gv.hw_tx_head % gv.hw_tx_capacity)) &&
                !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
                  slot(gv.hardware_ring_tx, i).ghost_unprocessed) &&
    (unfolding valid_hardware_ring_tx_read(heap, gv) in
        forall i: Int, j: Int :: 0 <= i && i < gv.hw_tx_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) &&
            0 <= j && j < gv.hw_tx_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, j).hw_stat) &&
            slot(gv.hardware_ring_tx, i).hw_addr == slot(gv.hardware_ring_tx, j).hw_addr ==>
                i == j)
)

predicate valid_hardware_ring_tx_write(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_tx, write) &&
    (forall i: Int :: //{ slot(gv.hardware_ring_tx, i).hw_stat }
        i >= 0 && i < hw_capacity ==> acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2)) &&
    (forall i: Int ::
        //{ bounded16(slot(gv.hardware_ring_tx, i).hw_stat) }
        //{ bounded32(slot(gv.hardware_ring_tx, i).hw_stat) }
        //{ bounded64(slot(gv.hardware_ring_tx, i).hw_stat) }
        i >= 0 && i < hw_capacity ==> bounded16(slot(gv.hardware_ring_tx, i).hw_stat)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_addr }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).hw_addr, write) &&
            is_valid_data_addr(slot(gv.hardware_ring_tx, i).hw_addr)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_stat }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
            is_valid_tx_stat(slot(gv.hardware_ring_tx, i).hw_stat)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).hw_len }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).hw_len, write) &&
            is_valid_data_len(slot(gv.hardware_ring_tx, i).hw_len)) &&
    (forall i: Int :: //{ is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat), slot(gv.hardware_ring_tx, i).ghost_unprocessed }
        i >= 0 && i < hw_capacity && !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
            acc(slot(gv.hardware_ring_tx, i).ghost_unprocessed))
}

