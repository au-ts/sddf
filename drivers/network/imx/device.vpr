
/* I really don't like this.. */
function ND_bounded32(): Int
  ensures bounded32(result)

function ND_bounded16(): Int
  ensures bounded16(result)

/* Hard-coded register addresses specified in
 * `examples/echo_server/board/maaxborad/echo_server.system` and
 * `driver/network/imx/ethernet.h`
*/
define REG_BASE         33554432    // 0x2_000_000
define EIR_offset       4           // 0x04
define RDAR_offset      16          // 0x10
define TDAR_offset      20          // 0x14

define hw_capacity          256
define hw_descriptor_size   8
define hw_ring_rx_size      hw_capacity * hw_descriptor_size
define hw_ring_tx_size      hw_capacity * hw_descriptor_size

define hw_ring_buffer_vaddr 35651584                                // 0x2_200_000
define hw_ring_rx_addr      hw_ring_buffer_vaddr                    // 0x2_200_000
define hw_ring_tx_addr      hw_ring_buffer_vaddr + hw_ring_rx_size  // 0x2_200_800

define unchanged(exprs)   exprs == old(exprs)

