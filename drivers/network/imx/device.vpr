/*  Devcie hardware descriptor:
 *  ┌───────────────────┬────┬────┬─────────┐
 *  │                   │    │    │         │
 *  │       addr        │stat│  0 │   len   │
 *  └───────────────────┴────┴────┴─────────┘
 *  8                   4    3    2         0  (byte)
 *
 *            RX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │        │  │
 *       ▼     ▼        ▼  ▼
 * RXD_EMPTY  WRAP      0  0
 *
 *            TX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │              │
 *       ▼     ▼              ▼
 * TXD_READY  WRAP            0
*/

define WRAP_MASK        8192    // 1 << 13
define RXD_EMPTY_MASK   32768   // 1 << 15
define TXD_READY_MASK   32768   // 1 << 15
define RX_STAT_MASK     1544    // (1 << 3) | (1 << 9) | (1 << 10) == 1544
define TX_STAT_MASK     511     // bits 8-0 cleared

function is_WRAP(value: Int): Bool
    requires bounded16(value)
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(WRAP_MASK)) != bv64_from_int(0))

function is_RXD_EMPTY(value: Int): Bool
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(RXD_EMPTY_MASK)) != bv64_from_int(0))

function is_TXD_READY(value: Int): Bool
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(TXD_READY_MASK)) != bv64_from_int(0))

function is_valid_data_addr(value: Int): Bool
    ensures result <==> bounded32(value)

/* In RX stat, 1st and 2nd bit in the stat field must be cleared */
function is_valid_rx_stat(value: Int): Bool
    ensures result <==> bounded16(value) && (bv64_and(bv64_from_int(value), bv64_from_int(RX_STAT_MASK)) == bv64_from_int(0))

function valid_rx_stat(): Int
    ensures is_valid_rx_stat(result)

/* In TX stat, 0-th bit in the stat field must be cleared */
function is_valid_tx_stat(value: Int): Bool
    ensures result <==> bounded16(value) && (bv64_and(bv64_from_int(value), bv64_from_int(TX_STAT_MASK)) == bv64_from_int(0))

function valid_tx_stat(): Int
    ensures is_valid_tx_stat(result)

function is_valid_data_len(value: Int): Bool
    ensures result <==> bounded16(value)

function valid_desc_len(): Int
    ensures is_valid_data_len(result)

///////////////////////////// device state
field hw_addr: Int
field hw_stat: Int
field hw_len: Int
field hardware_ring_rx: IArray
field hardware_ring_tx: IArray
field rx_await_ack: Seq[Int]
field tx_await_ack: Seq[Int]
field rx_handled: Set[Seq[Int]]
field tx_handled: Set[Seq[Int]]
/////////////////////////////

/* Hardware ring stat WRAP:
 * According to the imx8mm manual that:
 * > Wrap. Written by user.
 * > 0 The next buffer descriptor is found in the consecutive location.
 * > 1 The next buffer descriptor is found at the location defined in ENETn_RDSR.
 * This applies to both receive (rx) and transmit (tx) sides.
 * We want to make sure that the WRAP bit in the buffer descriptor is set iff
 * the descriptor is at the last slot in the contiguous hardware ring region.
 *
 * TLDR:
 * The last slot of hardware_ring_*_stat[] must have WRAP set.
 * Other slots must not have WRAP set.
*/
// predicate valid_hardware_ring_rx(heap: IArray, gv: Ref, p: Perm)
// {
//     acc(gv.hardware_ring_rx, p) &&
//     forall i: Int :: { slot(gv.hardware_ring_rx, i) }
//         (i >= 0 && i < hw_capacity) ==> (
//             acc(slot(gv.hardware_ring_rx, i).hw_stat, p) &&
//             (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
//                 acc(slot(gv.hardware_ring_rx, i).hw_addr, p) &&
//                 is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr) &&
//                 is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat) &&
//                 acc(slot(gv.hardware_ring_rx, i).hw_len), p) &&
//                 is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len)
//         )
//     )
// }

define valid_rx_read_slot(x)
(
    acc(x.hw_addr, 3/4) &&
    is_valid_data_addr(x.hw_addr) &&
    acc(x.hw_stat, 1/4) &&
    is_valid_rx_stat(x.hw_stat) &&
    acc(x.hw_len, 3/4) &&
    is_valid_data_len(x.hw_len)
)

predicate valid_hardware_ring_rx_read(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_rx, 3/4) &&
    forall i: Int ::
        (i >= 0 && i < hw_capacity ==>
            acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
            bounded16(slot(gv.hardware_ring_rx, i).hw_stat) &&
            (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
                valid_rx_read_slot(slot(gv.hardware_ring_rx, i)))
        )
}

// todo: why the hell can this not be a function
function valid_hardware_ring_rx_mdata_read(heap: IArray, gv: Ref): Bool
    requires acc(gv.hw_rx_tail, 1/5) && acc(gv.hw_rx_head, 1/5) && acc(gv.hw_rx_capacity, 1/5) && valid_hardware_ring_rx_read(heap, gv)
{
    bounded16(gv.hw_rx_head) &&
    0 <= (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) <= gv.hw_rx_capacity &&
    gv.hw_rx_capacity == 256 &&
    (unfolding valid_hardware_ring_rx_read(heap, gv) in
        (forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
            (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
                 ((gv.hw_rx_tail % gv.hw_rx_capacity) < (gv.hw_rx_head % gv.hw_rx_capacity)
                   ? i >= (gv.hw_rx_tail % gv.hw_rx_capacity) && i < (gv.hw_rx_head % gv.hw_rx_capacity)
                   : i >= (gv.hw_rx_tail % gv.hw_rx_capacity) || i < (gv.hw_rx_head % gv.hw_rx_capacity)) ==>
                   !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat)))
}

function valid_hardware_ring_rx_inj(heap: IArray, gv: Ref): Bool
    requires valid_hardware_ring_rx_read(heap, gv)
{
    unfolding valid_hardware_ring_rx_read(heap, gv) in
        (forall i: Int, j: Int :: 0 <= i && i < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) &&
            0 <= j && j < gv.hw_rx_capacity && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
            slot(gv.hardware_ring_rx, i).hw_addr == slot(gv.hardware_ring_rx, j).hw_addr ==>
                i == j)
}

predicate valid_hardware_ring_rx_write(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_rx, write) &&
    forall i: Int ::
        (i >= 0 && i < hw_capacity ==>
            acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
            bounded16(slot(gv.hardware_ring_rx, i).hw_stat) &&
            (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat) ==>
                acc(slot(gv.hardware_ring_rx, i).hw_addr, write) &&
                is_valid_data_addr(slot(gv.hardware_ring_rx, i).hw_addr) &&
                acc(slot(gv.hardware_ring_rx, i).hw_stat, 1/2) &&
                is_valid_rx_stat(slot(gv.hardware_ring_rx, i).hw_stat) &&
                acc(slot(gv.hardware_ring_rx, i).hw_len, write) &&
                is_valid_data_len(slot(gv.hardware_ring_rx, i).hw_len))
        )
}

function valid_hardware_ring_rx_mdata_write(heap: IArray, gv: Ref): Bool
    requires acc(gv.hw_rx_tail, 1/5) && acc(gv.hw_rx_head, 1/5) && acc(gv.hw_rx_capacity, 1/5)
    requires valid_hardware_ring_rx_write(heap, gv)
{
    bounded16(gv.hw_rx_head) &&
    0 <= (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) && (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) <= gv.hw_rx_capacity &&
    gv.hw_rx_capacity == 256 &&
    unfolding valid_hardware_ring_rx_write(heap, gv) in
          (forall i: Int :: 0 <= i && i < gv.hw_rx_capacity &&
                          (gv.hw_rx_tail - gv.hw_rx_head) % (MAX_INT16 + 1) != gv.hw_rx_capacity &&
                           ((gv.hw_rx_tail % gv.hw_rx_capacity) < (gv.hw_rx_head % gv.hw_rx_capacity)
                             ? i >= (gv.hw_rx_tail % gv.hw_rx_capacity) && i < (gv.hw_rx_head % gv.hw_rx_capacity)
                             : i >= (gv.hw_rx_tail % gv.hw_rx_capacity) || i < (gv.hw_rx_head % gv.hw_rx_capacity)) ==>
                             !is_RXD_EMPTY(slot(gv.hardware_ring_rx, i).hw_stat))
}

define valid_tx_read_slot(x)
(
    acc(x.hw_addr, 3/4) &&
    is_valid_data_addr(x.hw_addr) &&
    is_valid_tx_stat(x.hw_stat) &&
    acc(x.hw_len, 3/4) &&
    is_valid_data_len(x.hw_len)
)

predicate valid_hardware_ring_tx_read(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_tx, 3/4) &&
    forall i: Int :: { slot(gv.hardware_ring_tx, i) }
        (i >= 0 && i < hw_capacity ==>
            acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
            bounded16(slot(gv.hardware_ring_tx, i).hw_stat) &&
            (!is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
                valid_tx_read_slot(slot(gv.hardware_ring_tx, i)))
        )
}

function valid_hardware_ring_tx_mdata_read(heap: IArray, gv: Ref): Bool
    requires acc(gv.hw_tx_tail, 1/5) && acc(gv.hw_tx_head, 1/5) && acc(gv.hw_tx_capacity, 1/5)
    requires valid_hardware_ring_tx_read(heap, gv)
{
    0 <= (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) <= gv.hw_tx_capacity &&
    gv.hw_tx_capacity == 256 &&
    unfolding valid_hardware_ring_tx_read(heap, gv) in
          (forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
                          (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
                           ((gv.hw_tx_tail % gv.hw_tx_capacity) < (gv.hw_tx_head % gv.hw_tx_capacity)
                             ? i >= (gv.hw_tx_tail % gv.hw_tx_capacity) && i < (gv.hw_tx_head % gv.hw_tx_capacity)
                             : i >= (gv.hw_tx_tail % gv.hw_tx_capacity) || i < (gv.hw_tx_head % gv.hw_tx_capacity)) ==>
                             !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat))
}

predicate valid_hardware_ring_tx_write(heap: IArray, gv: Ref)
{
    acc(gv.hardware_ring_tx, write) &&
    forall i: Int ::
        (i >= 0 && i < hw_capacity ==>
            acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
            bounded16(slot(gv.hardware_ring_tx, i).hw_stat) &&
            (!is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat) ==>
                acc(slot(gv.hardware_ring_tx, i).hw_addr, write) &&
                is_valid_data_addr(slot(gv.hardware_ring_tx, i).hw_addr) &&
                acc(slot(gv.hardware_ring_tx, i).hw_stat, 1/2) &&
                is_valid_tx_stat(slot(gv.hardware_ring_tx, i).hw_stat) &&
                acc(slot(gv.hardware_ring_tx, i).hw_len, write) &&
                is_valid_data_len(slot(gv.hardware_ring_tx, i).hw_len))
        )
}

function valid_hardware_ring_tx_mdata_write(heap: IArray, gv: Ref): Bool
    requires acc(gv.hw_tx_tail, 1/5) && acc(gv.hw_tx_head, 1/5) && acc(gv.hw_tx_capacity, 1/5)
    requires valid_hardware_ring_tx_write(heap, gv)
{
    0 <= (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) && (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) <= gv.hw_tx_capacity && 
    gv.hw_tx_capacity == 256 &&
    unfolding valid_hardware_ring_tx_write(heap, gv) in
          (forall i: Int :: 0 <= i && i < gv.hw_tx_capacity &&
                          (gv.hw_tx_tail - gv.hw_tx_head) % (MAX_INT16 + 1) != gv.hw_tx_capacity &&
                           ((gv.hw_tx_tail % gv.hw_tx_capacity) < (gv.hw_tx_head % gv.hw_tx_capacity)
                             ? i >= (gv.hw_tx_tail % gv.hw_tx_capacity) && i < (gv.hw_tx_head % gv.hw_tx_capacity)
                             : i >= (gv.hw_tx_tail % gv.hw_tx_capacity) || i < (gv.hw_tx_head % gv.hw_tx_capacity)) ==>
                             !is_TXD_READY(slot(gv.hardware_ring_tx, i).hw_stat))
}

/* The below methods are pretty much similar to each other.
 * Bascially for stat, len, and addr update, we require that:
 *   - The given value is valid
 *   - There is access to the given address
*/
// todo: can we have disjoint address chunks that give the same method?
method store_hw_ring_rx_addr(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 4) >= hw_ring_rx_addr && (address - 4) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 4) % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    requires is_valid_data_addr(value)
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    ensures slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr == value
{
    var index: Int := (address - 4 - hw_ring_rx_addr) / hw_descriptor_size
    slot(gv.hardware_ring_rx, index).hw_addr := value
    refute false
}

method store_hw_ring_tx_addr(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 4) >= hw_ring_tx_addr && (address - 4) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 4) % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    requires is_valid_data_addr(value)
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    ensures slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr == value
{
    var index: Int := (address - 4 - hw_ring_tx_addr) / hw_descriptor_size
    slot(gv.hardware_ring_tx, index).hw_addr := value
    refute false
}

method load_hw_ring_rx_addr(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 4) % 8 == 0
    requires (address - 4) >= hw_ring_rx_addr && (address - 4) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires acc(gv.hardware_ring_rx, 1/2) &&
        acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr, 1/2) &&
        is_valid_data_addr(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr, 1/2)
    ensures retval == slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr
    ensures is_valid_data_addr(retval)
{
    retval := slot(gv.hardware_ring_rx, (address - 4 - hw_ring_rx_addr) / hw_descriptor_size).hw_addr
    refute false
}

method load_hw_ring_tx_addr(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 4) % 8 == 0
    requires (address - 4) >= hw_ring_tx_addr && (address - 4) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires acc(gv.hardware_ring_tx, 1/2) &&
        acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr, 1/2) &&
        is_valid_data_addr(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr)
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr, 1/2)
    ensures retval == slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr
    ensures is_valid_data_addr(retval)
{
    retval := slot(gv.hardware_ring_tx, (address - 4 - hw_ring_tx_addr) / hw_descriptor_size).hw_addr
    refute false
}

method store_hw_ring_rx_stat(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_rx_addr + hw_ring_rx_size)
    requires (address - 2) % 8 == 0
    requires acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    requires is_valid_rx_stat(value)
    requires is_RXD_EMPTY(value)
    requires acc(gv.rx_await_ack)
    // make sure the given value is wrapped properly
    requires (((address - 2 - hw_ring_rx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    requires forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j]
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    // check that the specified slot in the hardware ring is updated
    ensures slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat == value
    ensures acc(gv.rx_await_ack)
    ensures (address - 2 - hw_ring_rx_addr) / hw_descriptor_size in gv.rx_await_ack
    ensures (address - 2 - hw_ring_rx_addr) / hw_descriptor_size in old(gv.rx_await_ack) ==> gv.rx_await_ack == old(gv.rx_await_ack)
    ensures !((address - 2 - hw_ring_rx_addr) / hw_descriptor_size in old(gv.rx_await_ack)) ==> gv.rx_await_ack == old(gv.rx_await_ack) ++ Seq((address - 2 - hw_ring_rx_addr) / hw_descriptor_size) 
    ensures forall i: Int, j: Int :: 0 <= i && i < |gv.rx_await_ack| && 0 <= j && j < |gv.rx_await_ack| && i != j ==>
        gv.rx_await_ack[i] != gv.rx_await_ack[j]
{
    var index: Int := (address - 2 - hw_ring_rx_addr) / hw_descriptor_size
    slot(gv.hardware_ring_rx, index).hw_stat := value
    if (!(index in gv.rx_await_ack)) {
        gv.rx_await_ack := gv.rx_await_ack ++ Seq(index)
    }
    refute false
}

method load_hw_ring_rx_stat(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 2) % 8 == 0
    requires (address - 2) >= hw_ring_rx_addr && (address - 2) < (hw_ring_rx_addr + hw_ring_rx_size)
    // 1/2 - 1/8 to make up for the additional 1/8 below
    requires acc(gv.hardware_ring_rx, 1/2) &&
        acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat, 1/2)
    requires bounded16(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)
    requires acc(gv.rx_active, 1/8) && acc(gv.rx_active.net_added, 1/8) &&
        forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && j != (address - 2 - hw_ring_rx_addr) / hw_descriptor_size ==>
            acc(slot(gv.hardware_ring_rx, j).hw_stat, 1/8) &&
                (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) ==> acc(slot(gv.hardware_ring_rx, j).hw_addr, 1/8))
    requires !is_RXD_EMPTY(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat) ==>
        valid_rx_read_slot(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size))
    ensures acc(gv.hardware_ring_rx, 1/2) && acc(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat, 1/2)
    ensures retval == slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat
    ensures is_valid_rx_stat(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat) ==> is_valid_rx_stat(retval)
    ensures old(!is_RXD_EMPTY(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)) ==>
        old(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat) == retval
    ensures !is_RXD_EMPTY(retval) ==> valid_rx_read_slot(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size))
    ensures acc(gv.rx_active, 1/8) && acc(gv.rx_active.net_added, 1/8) &&
        forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && j != (address - 2 - hw_ring_rx_addr) / hw_descriptor_size ==>
            acc(slot(gv.hardware_ring_rx, j).hw_stat, 1/8) &&
                (!is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) ==> acc(slot(gv.hardware_ring_rx, j).hw_addr, 1/8))
    ensures let r == (slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size)) in
                old(is_RXD_EMPTY(slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size).hw_stat)) &&
                !is_RXD_EMPTY(r.hw_stat) ==>
                    !(Seq(r.hw_addr, r.hw_len) in gv.rx_active.net_added) &&
                        forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
                            slot(gv.hardware_ring_rx, j).hw_addr == r.hw_addr ==> j == (address - 2 - hw_ring_rx_addr) / hw_descriptor_size
    ensures bounded16(retval)
{
    var r: Ref := slot(gv.hardware_ring_rx, (address - 2 - hw_ring_rx_addr) / hw_descriptor_size)
    if (is_RXD_EMPTY(r.hw_stat)) {
        exhale acc(r.hw_stat, 1/2)
        inhale acc(r.hw_stat, 1/2)
        inhale is_valid_rx_stat(r.hw_stat)
        if (!is_RXD_EMPTY(r.hw_stat)) {
            inhale valid_rx_read_slot(r)
            // todo: explain why this is okay
            inhale !(Seq(r.hw_addr, r.hw_len) in gv.rx_active.net_added)
            inhale forall j: Int :: 0 <= j && j < QUEUE_CAPACITY && !is_RXD_EMPTY(slot(gv.hardware_ring_rx, j).hw_stat) &&
               slot(gv.hardware_ring_rx, j).hw_addr == r.hw_addr ==> j == (address - 2 - hw_ring_rx_addr) / hw_descriptor_size
        }
    }
    retval := r.hw_stat
    refute false
}

method store_hw_ring_tx_stat(heap: IArray, gv: Ref, address: Int, value: Int)
    requires (address - 2) >= hw_ring_tx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires (address - 2) % 8 == 0
    requires acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    requires is_valid_tx_stat(value)
    requires is_TXD_READY(value)
    requires acc(gv.tx_await_ack)
    // make sure the given value is wrapped properly
    requires (((address - 2 - hw_ring_tx_addr) / hw_descriptor_size) == (hw_capacity - 1)) <==> is_WRAP(value)
    requires forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
        gv.tx_await_ack[i] != gv.tx_await_ack[j]
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
    // check that the specified slot in the hardware ring is updated
    ensures slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat == value
    ensures acc(gv.tx_await_ack)
    ensures (address - 2 - hw_ring_tx_addr) / hw_descriptor_size in gv.tx_await_ack
    ensures (address - 2 - hw_ring_tx_addr) / hw_descriptor_size in old(gv.tx_await_ack) ==> gv.tx_await_ack == old(gv.tx_await_ack)
    ensures !((address - 2 - hw_ring_tx_addr) / hw_descriptor_size in old(gv.tx_await_ack)) ==> gv.tx_await_ack == old(gv.tx_await_ack) ++ Seq((address - 2 - hw_ring_tx_addr) / hw_descriptor_size) 
    ensures forall i: Int, j: Int :: 0 <= i && i < |gv.tx_await_ack| && 0 <= j && j < |gv.tx_await_ack| && i != j ==>
        gv.tx_await_ack[i] != gv.tx_await_ack[j]
{
    var index: Int := (address - 2 - hw_ring_tx_addr) / hw_descriptor_size
    slot(gv.hardware_ring_tx, index).hw_stat := value
    if (!(index in gv.tx_await_ack)) {
        gv.tx_await_ack := gv.tx_await_ack ++ Seq(index)
    }
    refute false
}

method load_hw_ring_tx_stat(heap: IArray, gv: Ref, address: Int)
    returns (retval: Int)
    requires (address - 2) % 8 == 0
    requires (address - 2) >= hw_ring_tx_addr && (address - 2) < (hw_ring_tx_addr + hw_ring_tx_size)
    requires acc(gv.hardware_ring_tx, 1/2) &&
        acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat, 1/2)
    requires bounded16(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)
//    requires !is_TXD_READY(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat) ==>
    ensures acc(gv.hardware_ring_tx, 1/2) && acc(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat, 1/2)
    ensures retval == slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat
    ensures is_valid_tx_stat(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat) ==> is_valid_tx_stat(retval)
//    ensures old(!is_TXD_READY(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat)) ==>
//        old(slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat) == slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size).hw_stat
    ensures bounded16(retval)
{
    var r: Ref := slot(gv.hardware_ring_tx, (address - 2 - hw_ring_tx_addr) / hw_descriptor_size)
    if (is_TXD_READY(r.hw_stat)) {
        exhale acc(r.hw_stat, 1/2)
        inhale acc(r.hw_stat, 1/2)
        inhale is_valid_tx_stat(r.hw_stat)
    }
    retval := r.hw_stat
    refute false
}

method load_hw_ring_rx_len(heap: IArray, gv: Ref, address: Int)
