/*  Devcie hardware descriptor:
 *  ┌───────────────────┬────┬────┬─────────┐
 *  │                   │    │    │         │
 *  │       addr        │stat│  0 │   len   │
 *  └───────────────────┴────┴────┴─────────┘
 *  8                   4    3    2         0  (byte)
 *
 *            RX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │        │  │
 *       ▼     ▼        ▼  ▼
 * RXD_EMPTY  WRAP      0  0
 *
 *            TX stat
 *    ─────────────────────────
 *    8  7  6  5  4  3  2  1  0   (bit)
 *       │     │              │
 *       ▼     ▼              ▼
 * TXD_READY  WRAP            0
*/

define WRAP_MASK        8192    // 1 << 13
define RXD_EMPTY_MASK   32768   // 1 << 15
define TXD_READY_MASK   32768   // 1 << 15
define RX_STAT_MASK     1544    // (1 << 3) | (1 << 9) | (1 << 10) == 1544
define TX_STAT_MASK     511     // bits 8-0 cleared

function is_WRAP(value: Int): Bool
    requires bounded16(value)
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(WRAP_MASK)) != bv64_from_int(0))

function is_RXD_EMPTY(value: Int): Bool
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(RXD_EMPTY_MASK)) != bv64_from_int(0))

function is_TXD_READY(value: Int): Bool
    ensures result == (bv64_and(bv64_from_int(value), bv64_from_int(TXD_READY_MASK)) != bv64_from_int(0))

function is_valid_data_addr(value: Int): Bool
    ensures result <==> bounded32(value)

/* In RX stat, 1st and 2nd bit in the stat field must be cleared */
function is_valid_rx_stat(value: Int): Bool
    ensures result <==> bounded16(value) && (bv64_and(bv64_from_int(value), bv64_from_int(RX_STAT_MASK)) == bv64_from_int(0))

function valid_rx_stat(): Int
    ensures is_valid_rx_stat(result)

/* In TX stat, 0-th bit in the stat field must be cleared */
function is_valid_tx_stat(value: Int): Bool
    ensures result <==> bounded16(value) && (bv64_and(bv64_from_int(value), bv64_from_int(TX_STAT_MASK)) == bv64_from_int(0))

function valid_tx_stat(): Int
    ensures is_valid_tx_stat(result)

function is_valid_data_len(value: Int): Bool
    ensures result <==> bounded16(value)

function valid_desc_len(): Int
    ensures is_valid_data_len(result)

///////////////////////////// device state
field hw_addr: Int
field hw_stat: Int
field hw_len: Int
// refers to whether this descriptor is in the state where it has been returned from the device but not processed by the driver
field ghost_unprocessed: Bool
field rx_processed: Set[Seq[Int]]
field tx_processed: Set[Int]
field hardware_ring_rx: IArray
field hardware_ring_tx: IArray
field rx_await_ack: Seq[Int]
field tx_await_ack: Seq[Int]
field rx_handled: Set[Seq[Int]]
field tx_handled: Set[Seq[Int]]
/////////////////////////////

