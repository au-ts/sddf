define f_net_queue_injective_produce(_, _, x) net_queue_injective_produce(x)
define f_net_queue_injective_consume(_, _, x) net_queue_injective_consume(x)

define RX_FREE_BASE 		1234567
define RX_ACTIVE_BASE 		1244667
define TX_FREE_BASE 		1254767
define TX_ACTIVE_BASE 		1264867

define TAIL_OFFSET               0
define HEAD_OFFSET               2
define CONSUMER_SIGNALLED_OFFSET 4

define RX_QUEUE_CAPACITY   256
define TX_QUEUE_CAPACITY   256
define QUEUE_CAPACITY      256

define NDESC_ADDR_OFF         0
define NDESC_LEN_OFF          8
define NDESC_LEN              16

define BUFFERS_OFFSET      8
define NET_BUFF_DESC_SIZE  16
define VIRT_LEN            BUFFERS_OFFSET + QUEUE_CAPACITY * NET_BUFF_DESC_SIZE

define TX_CH   1
define RX_CH   2

field rx_free: Ref
field rx_active: Ref
field tx_free: Ref
field tx_active: Ref
field rx_notified: Int
field tx_notified: Int

/* Top level (default) virtualiser predicate */
predicate valid_virt(heap: IArray, virt: Ref)
{
  acc(virt.rx_free) && acc(virt.rx_active) && acc(virt.tx_free) && acc(virt.tx_active) &&
  acc(virt.rx_notified) && acc(virt.tx_notified) &&
  valid_net_queue_consume(heap, virt, virt.rx_free, RX_QUEUE_CAPACITY) &&
  valid_net_queue_produce(heap, virt, virt.rx_active, RX_QUEUE_CAPACITY) &&
  valid_net_queue_produce(heap, virt, virt.tx_free, TX_QUEUE_CAPACITY) &&
  valid_net_queue_consume(heap, virt, virt.tx_active, TX_QUEUE_CAPACITY)
}
define f_valid_virt(a, b) valid_virt(a, b) // silly transpiler bug

method microkit_notify(heap: IArray, virt: Ref, x1: Int, x2: Int, x3: Int, x4: Int) 
  requires acc(virt.rx_notified) && acc(virt.tx_notified)
  requires (x1 == 0) && (x3 == 0) && (x4 == 0)
  requires (x2 == RX_CH) || (x2 == TX_CH)
  ensures acc(virt.rx_notified) && acc(virt.tx_notified)
  ensures (x2 == RX_CH) ==> (virt.rx_notified == old(virt.rx_notified) + 1)
  ensures (x2 == TX_CH) ==> (virt.tx_notified == old(virt.tx_notified) + 1)
{
  if (x2 == RX_CH) {
    virt.rx_notified := virt.rx_notified + 1
  } elseif (x2 == TX_CH) {
    virt.tx_notified := virt.tx_notified + 1
  } else {assert false}
  refute false
}

/////////////////////// Generic sDDF network shared queue model (shared with virtuliser PDs)
field net_tail: Int
field net_head: Int
field net_signal: Bool
field net_descr: IArray
field ndescr_addr: Int
field ndescr_len: Int
field net_removed_addr: Set[Int]
field net_removed: Set[Seq[Int]]
field net_added: Set[Seq[Int]]

function net_queue_injective_produce(queue: Ref): Bool
  requires acc(queue.net_tail, wildcard)
  requires acc(queue.net_head, wildcard)
  requires acc(queue.net_descr, wildcard)
  requires 0 <= queue.net_tail - queue.net_head <= 256
  requires forall i: Int :: queue.net_tail <= i && i < queue.net_head ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, wildcard)
{
  forall i: Int, j: Int :: queue.net_tail <= i && i < queue.net_head &&
    queue.net_tail <= j && j < queue.net_head &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j
}

function net_queue_injective_consume(queue: Ref): Bool
  requires acc(queue.net_tail, wildcard)
  requires acc(queue.net_head, wildcard)
  requires acc(queue.net_descr, wildcard)
  requires 0 <= queue.net_tail - queue.net_head <= 256
  requires forall i: Int :: queue.net_head <= i && i < queue.net_tail ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, wildcard)
{
  forall i: Int, j: Int :: queue.net_head <= i && i < queue.net_tail &&
    queue.net_head <= j && j < queue.net_tail &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j
}

predicate valid_net_queue_produce(heap: IArray, virt: Ref, queue: Ref, capacity: Int)
{
  acc(queue.net_tail) && acc(queue.net_head, 3/4) && acc(queue.net_signal) &&
  acc(queue.net_descr) &&
  0 <= queue.net_tail - queue.net_head <= 256 &&
  (forall i : Int :: queue.net_tail <= i && i < queue.net_head ==>
    acc(slotq(queue.net_descr, i).ndescr_addr) && acc(slotq(queue.net_descr, i).ndescr_len)) &&
  (capacity == RX_QUEUE_CAPACITY || capacity == TX_QUEUE_CAPACITY) &&
  valid_net_tail(queue.net_tail) && valid_net_head(queue.net_head) &&
  (forall i: Int, j: Int :: queue.net_tail <= i && i < queue.net_head &&
    queue.net_tail <= j && j < queue.net_head &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j)
}

predicate valid_net_queue_consume(heap: IArray, virt: Ref, queue: Ref, capacity: Int)
{
  acc(queue.net_tail, 3/4) && acc(queue.net_head) && acc(queue.net_signal) &&
  acc(queue.net_descr) &&
  0 <= queue.net_tail - queue.net_head <= 256 &&
  (forall i : Int :: queue.net_head <= i && i < queue.net_tail ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, 3/4) && acc(slotq(queue.net_descr, i).ndescr_len, 3/4)) &&
  (capacity == RX_QUEUE_CAPACITY || capacity == TX_QUEUE_CAPACITY) &&
  valid_net_tail(queue.net_tail) && valid_net_head(queue.net_head) &&
  (forall i: Int, j: Int :: queue.net_head <= i && i < queue.net_tail &&
    queue.net_head <= j && j < queue.net_tail &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j)
}

define valid_net_tail(x)
  bounded16(x)

define valid_net_head(x)
  bounded16(x)

define valid_net_addr(x)
  bounded32(x)

define valid_net_len(x)
  bounded16(x)

/////////////////////// Helper macros
define queue_field(queue_name, capacity, field_)
  unfolding valid_net_queue(heap, gv, gv.queue_name, capacity) in gv.queue_name.field_

define queue_field_unchanged(queue_name, capacity, field_)
  unchanged(queue_field(queue_name, capacity, field_))

define queue_unchanged(queue_name, capacity)
 queue_field_unchanged(queue_name, capacity, net_tail) &&
  queue_field_unchanged(queue_name, capacity, net_head) &&
  queue_field_unchanged(queue_name, capacity, net_signal)

/////////////////////// RX_FREE queue
method store_rx_free_head(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_removed_addr) &&
    acc(gv.rx_free.net_descr, 1/4) && acc(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr, 1/4) &&
    acc(gv.rx_free.net_tail, 1/4)
  requires address == RX_FREE_BASE + HEAD_OFFSET
  requires valid_net_head(value)
  requires value == (gv.rx_free.net_head + 1) % (MAX_INT16 + 1)
  requires gv.rx_free.net_head != gv.rx_free.net_tail
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_removed_addr) &&
    acc(gv.rx_free.net_descr, 1/4) && acc(slotq(gv.rx_free.net_descr, old(gv.rx_free.net_head)).ndescr_addr, 1/4) &&
    acc(gv.rx_free.net_tail, 1/4)
  ensures gv.rx_free.net_removed_addr == old(gv.rx_free.net_removed_addr) union Set(slotq(gv.rx_free.net_descr, old(gv.rx_free.net_head)).ndescr_addr)
  ensures gv.rx_free.net_head == old(gv.rx_free.net_head) + 1
{
  gv.rx_free.net_removed_addr := gv.rx_free.net_removed_addr union Set(slotq(gv.rx_free.net_descr, gv.rx_free.net_head).ndescr_addr)
  gv.rx_free.net_head := gv.rx_free.net_head + 1
  refute false
}

method load_rx_free_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_tail)
  requires acc(gv.rx_free.net_removed_addr, 1/4) && acc(gv.rx_handled, 1/4) && acc(gv.rx_free.net_descr, 1/4) &&
    acc(gv.rx_free.net_head, 1/4)
  requires 0 <= gv.rx_free.net_tail - gv.rx_free.net_head <= 256 &&
    forall i: Int :: gv.rx_free.net_head <= i < gv.rx_free.net_tail ==>
      acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 1/4)
  requires address == RX_FREE_BASE + TAIL_OFFSET
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_tail)
  ensures acc(gv.rx_free.net_removed_addr, 1/4) && acc(gv.rx_handled, 1/4) && acc(gv.rx_free.net_descr, 1/4) &&
    acc(gv.rx_free.net_head, 1/4) && 0 <= old(gv.rx_free.net_tail) - gv.rx_free.net_head <= 256 &&
    forall i: Int :: gv.rx_free.net_head <= i < old(gv.rx_free.net_tail) ==>
      acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 1/4)
  ensures retval == gv.rx_free.net_tail % (MAX_INT16 + 1)
  ensures valid_net_tail(retval)
  ensures 0 <= gv.rx_free.net_tail - gv.rx_free.net_head <= 256
  ensures gv.rx_free.net_tail >= old(gv.rx_free.net_tail)
  ensures forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
    acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) && acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
    is_valid_data_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) && is_valid_data_len(slotq(gv.rx_free.net_descr, i).ndescr_len)
  ensures forall i: Int, j: Int :: old(gv.rx_free.net_tail) <= i && i < gv.rx_free.net_tail &&
    gv.rx_free.net_head <= j && j < gv.rx_free.net_tail &&
    slotq(gv.rx_free.net_descr, i).ndescr_addr == slotq(gv.rx_free.net_descr, j).ndescr_addr ==>
      i == j
  ensures forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
    !(slotq(gv.rx_free.net_descr, i).ndescr_addr in gv.rx_free.net_removed_addr)
  ensures forall s: Seq[Int] :: s in gv.rx_handled ==>
    |s| == 2 && forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
      s[0] != slotq(gv.rx_free.net_descr, i).ndescr_addr
{
  exhale acc(gv.rx_free.net_tail)
  inhale acc(gv.rx_free.net_tail)
  inhale 0 <= gv.rx_free.net_tail - gv.rx_free.net_head <= 256
  inhale gv.rx_free.net_tail >= old(gv.rx_free.net_tail)
  inhale forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
    acc(slotq(gv.rx_free.net_descr, i).ndescr_addr, 2/3) && acc(slotq(gv.rx_free.net_descr, i).ndescr_len, 2/3) &&
    is_valid_data_addr(slotq(gv.rx_free.net_descr, i).ndescr_addr) && is_valid_data_len(slotq(gv.rx_free.net_descr, i).ndescr_len)
  inhale forall i: Int, j: Int :: old(gv.rx_free.net_tail) <= i && i < gv.rx_free.net_tail &&
    gv.rx_free.net_head <= j && j < gv.rx_free.net_tail &&
    slotq(gv.rx_free.net_descr, i).ndescr_addr == slotq(gv.rx_free.net_descr, j).ndescr_addr ==>
      i == j
  inhale forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
    !(slotq(gv.rx_free.net_descr, i).ndescr_addr in gv.rx_free.net_removed_addr)
  inhale forall s: Seq[Int] :: s in gv.rx_handled ==>
    |s| == 2 && forall i: Int :: old(gv.rx_free.net_tail) <= i < gv.rx_free.net_tail ==>
      s[0] != slotq(gv.rx_free.net_descr, i).ndescr_addr
  retval := gv.rx_free.net_tail % (MAX_INT16 + 1)
  refute false
}

method load_rx_free_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4)
  requires address == RX_FREE_BASE + HEAD_OFFSET
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4)
  ensures retval == gv.rx_free.net_head % (MAX_INT16 + 1)
  ensures valid_net_head(retval)
{
  retval := gv.rx_free.net_head % (MAX_INT16 + 1)
  refute false
}

method store_rx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_signal)
  requires address == RX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_signal)
  ensures value == (gv.rx_free.net_signal ? 1 : 0)
{
  gv.rx_free.net_signal := (value == 1)
  refute false
}

method load_rx_free_addr(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - RX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= RX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < RX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr, 1/4) &&
    valid_net_addr(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  ensures acc(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr, 1/4)
  ensures retval == slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr
  ensures valid_net_addr(retval)
{
  var index: Int := (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  retval := slot(gv.rx_free.net_descr, index).ndescr_addr
  refute false
}

method load_rx_free_len(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - RX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= RX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < RX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len, 1/4) &&
    valid_net_len(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  ensures acc(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len, 1/4)
  ensures retval == slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len
  ensures valid_net_len(retval)
{
  var index: Int := (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  retval := slot(gv.rx_free.net_descr, index).ndescr_len
  refute false
}

/////////////////////// RX_ACTIVE queue
method load_rx_active_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  requires address == RX_ACTIVE_BASE + TAIL_OFFSET
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  ensures retval == gv.rx_active.net_tail % (MAX_INT16 + 1)
  ensures valid_net_tail(retval)
{
  retval := gv.rx_active.net_tail % (MAX_INT16 + 1)
  refute false
}

/*function slotq_add_capacity_lemma(queue: Ref, i: Int): Bool
  requires acc(queue.net_descr, wildcard)
  ensures (i + QUEUE_CAPACITY) % 256 == i % 256
  ensures result == true
{
  slotq(queue.net_descr, i) == slotq(queue.net_descr, i + QUEUE_CAPACITY)
}*/

method load_rx_active_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_head)
  requires acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_descr, 1/4)
  requires 0 <= gv.rx_active.net_tail - gv.rx_active.net_head <= 256 &&
    forall i: Int :: gv.rx_active.net_tail <= i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
      acc(slotq(gv.rx_active.net_descr, i).ndescr_addr, 1/4)
  requires address == RX_ACTIVE_BASE + HEAD_OFFSET
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_head)
  ensures retval == gv.rx_active.net_head % (MAX_INT16 + 1)
  ensures valid_net_head(retval)
  ensures gv.rx_active.net_head >= old(gv.rx_active.net_head)
  ensures acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_descr, 1/4) &&
    0 <= gv.rx_active.net_tail - old(gv.rx_active.net_head) <= 256 &&
    forall i: Int :: gv.rx_active.net_tail <= i < old(gv.rx_active.net_head) + QUEUE_CAPACITY ==>
      acc(slotq(gv.rx_active.net_descr, i).ndescr_addr, 1/4)
  ensures 0 <= gv.rx_active.net_tail - gv.rx_active.net_head <= 256
  ensures forall i: Int :: old(gv.rx_active.net_head) + QUEUE_CAPACITY <= i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
    acc(slotq(gv.rx_active.net_descr, i).ndescr_addr, 2/3) && acc(slotq(gv.rx_active.net_descr, i).ndescr_len, 2/3) &&
    is_valid_data_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) && is_valid_data_len(slotq(gv.rx_active.net_descr, i).ndescr_len)
  ensures forall i: Int, j: Int :: old(gv.rx_active.net_head) + QUEUE_CAPACITY <= i < gv.rx_active.net_head + QUEUE_CAPACITY &&
    gv.rx_active.net_tail <= j < gv.rx_active.net_head + QUEUE_CAPACITY &&
    slotq(gv.rx_active.net_descr, i).ndescr_addr == slotq(gv.rx_active.net_descr, j).ndescr_addr ==>
      i == j
{
  exhale acc(gv.rx_active.net_head)
  inhale acc(gv.rx_active.net_head)
  inhale gv.rx_active.net_head >= old(gv.rx_active.net_head)
  inhale 0 <= gv.rx_active.net_tail - gv.rx_active.net_head <= 256
  inhale forall i: Int :: old(gv.rx_active.net_head) + QUEUE_CAPACITY <= i < gv.rx_active.net_head + QUEUE_CAPACITY ==>
    acc(slotq(gv.rx_active.net_descr, i).ndescr_addr, 2/3) && acc(slotq(gv.rx_active.net_descr, i).ndescr_len, 2/3) &&
    is_valid_data_addr(slotq(gv.rx_active.net_descr, i).ndescr_addr) && is_valid_data_len(slotq(gv.rx_active.net_descr, i).ndescr_len)
  inhale forall i: Int, j: Int :: old(gv.rx_active.net_head) + QUEUE_CAPACITY <= i < gv.rx_active.net_head + QUEUE_CAPACITY &&
    gv.rx_active.net_tail <= j < gv.rx_active.net_head + QUEUE_CAPACITY &&
    slotq(gv.rx_active.net_descr, i).ndescr_addr == slotq(gv.rx_active.net_descr, j).ndescr_addr ==>
      i == j
  retval := gv.rx_active.net_head % (MAX_INT16 + 1)
  refute false
}

method store_rx_active_tail(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail) && acc(gv.rx_active.net_added) && acc(gv.rx_active.net_descr, 1/4) &&
    acc(slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_addr, 1/4) &&
    acc(slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_len, 1/4) &&
    acc(gv.rx_active.net_head, 1/4)
  requires address == RX_ACTIVE_BASE + TAIL_OFFSET
  requires valid_net_tail(value)
  requires value == (gv.rx_active.net_tail + 1) % (MAX_INT16 + 1)
  requires gv.rx_active.net_tail - gv.rx_active.net_head != QUEUE_CAPACITY
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail) && acc(gv.rx_active.net_added) && acc(gv.rx_active.net_descr, 1/4) &&
    acc(slotq(gv.rx_active.net_descr, old(gv.rx_active.net_tail)).ndescr_addr, 1/4) &&
    acc(slotq(gv.rx_active.net_descr, old(gv.rx_active.net_tail)).ndescr_len, 1/4) &&
    acc(gv.rx_active.net_head, 1/4)
  ensures gv.rx_active.net_added == old(gv.rx_active.net_added) union Set(Seq(
    slotq(gv.rx_active.net_descr, old(gv.rx_active.net_tail)).ndescr_addr,
    slotq(gv.rx_active.net_descr, old(gv.rx_active.net_tail)).ndescr_len
  ))
  ensures gv.rx_active.net_tail == old(gv.rx_active.net_tail) + 1
{
  gv.rx_active.net_added := gv.rx_active.net_added union Set(Seq(
    slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_addr,
    slotq(gv.rx_active.net_descr, gv.rx_active.net_tail).ndescr_len
  ))
  gv.rx_active.net_tail := gv.rx_active.net_tail + 1
  refute false
}

