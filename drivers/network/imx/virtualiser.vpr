  ensures acc(slot(gv.rx_active.net_descr, (address - NDESC_ADDR_OFF - RX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures slot(gv.rx_active.net_descr, (address - NDESC_ADDR_OFF - RX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr == value
{
