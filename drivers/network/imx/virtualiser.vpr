define f_net_queue_injective_produce(_, _, x) net_queue_injective_produce(x)
define f_net_queue_injective_consume(_, _, x) net_queue_injective_consume(x)

define RX_FREE_BASE 		1234567
define RX_ACTIVE_BASE 		1244667
define TX_FREE_BASE 		1254767
define TX_ACTIVE_BASE 		1264867

define TAIL_OFFSET               0
define HEAD_OFFSET               2
define CONSUMER_SIGNALLED_OFFSET 4

define RX_QUEUE_CAPACITY   256
define TX_QUEUE_CAPACITY   256
define QUEUE_CAPACITY      256

define NDESC_ADDR_OFF         0
define NDESC_LEN_OFF          8
define NDESC_LEN              16

define BUFFERS_OFFSET      8
define NET_BUFF_DESC_SIZE  16
define VIRT_LEN            BUFFERS_OFFSET + QUEUE_CAPACITY * NET_BUFF_DESC_SIZE

define TX_CH   1
define RX_CH   2

field rx_free: Ref
field rx_active: Ref
field tx_free: Ref
field tx_active: Ref
field rx_notified: Int
field tx_notified: Int

/* Top level (default) virtualiser predicate */
predicate valid_virt(heap: IArray, virt: Ref)
{
  acc(virt.rx_free) && acc(virt.rx_active) && acc(virt.tx_free) && acc(virt.tx_active) &&
  acc(virt.rx_notified) && acc(virt.tx_notified) &&
  valid_net_queue_consume(heap, virt, virt.rx_free, RX_QUEUE_CAPACITY) &&
  valid_net_queue_produce(heap, virt, virt.rx_active, RX_QUEUE_CAPACITY) &&
  valid_net_queue_produce(heap, virt, virt.tx_free, TX_QUEUE_CAPACITY) &&
  valid_net_queue_consume(heap, virt, virt.tx_active, TX_QUEUE_CAPACITY) &&
  acc(virt.rx_free.net_removed_addr) &&
  acc(virt.rx_active.net_added) &&
  acc(virt.tx_free.net_added) &&
  acc(virt.tx_active.net_removed)
}
define f_valid_virt(a, b) valid_virt(a, b) // silly transpiler bug

method microkit_notify(heap: IArray, virt: Ref, x1: Int, x2: Int, x3: Int, x4: Int) 
  requires acc(virt.rx_notified) && acc(virt.tx_notified)
  requires (x1 == 0) && (x3 == 0) && (x4 == 0)
  requires (x2 == RX_CH) || (x2 == TX_CH)
  ensures acc(virt.rx_notified) && acc(virt.tx_notified)
  ensures (x2 == RX_CH) ==> (virt.rx_notified == old(virt.rx_notified) + 1)
  ensures (x2 == TX_CH) ==> (virt.tx_notified == old(virt.tx_notified) + 1)
{
  if (x2 == RX_CH) {
    virt.rx_notified := virt.rx_notified + 1
  } elseif (x2 == TX_CH) {
    virt.tx_notified := virt.tx_notified + 1
  } else {assert false}
  refute false
}

/////////////////////// Generic sDDF network shared queue model (shared with virtuliser PDs)
field net_tail: Int
field net_head: Int
field net_signal: Bool
field net_descr: IArray
field ndescr_addr: Int
field ndescr_len: Int
field net_removed_addr: Set[Int]
field net_removed: Set[Seq[Int]]
field net_added: Set[Seq[Int]]

function net_queue_injective_produce(queue: Ref): Bool
  requires acc(queue.net_tail, wildcard)
  requires acc(queue.net_head, wildcard)
  requires acc(queue.net_descr, wildcard)
  requires 0 <= queue.net_tail - queue.net_head <= 256
  requires forall i: Int :: queue.net_tail <= i && i < queue.net_head ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, wildcard)
{
  forall i: Int, j: Int :: queue.net_tail <= i && i < queue.net_head &&
    queue.net_tail <= j && j < queue.net_head &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j
}

function net_queue_injective_consume(queue: Ref): Bool
  requires acc(queue.net_tail, wildcard)
  requires acc(queue.net_head, wildcard)
  requires acc(queue.net_descr, wildcard)
  requires 0 <= queue.net_tail - queue.net_head <= 256
  requires forall i: Int :: queue.net_head <= i && i < queue.net_tail ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, wildcard)
{
  forall i: Int, j: Int :: queue.net_head <= i && i < queue.net_tail &&
    queue.net_head <= j && j < queue.net_tail &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j
}

predicate valid_net_queue_produce(heap: IArray, virt: Ref, queue: Ref, capacity: Int)
{
  acc(queue.net_tail) && acc(queue.net_head, 3/4) && acc(queue.net_signal) &&
  acc(queue.net_descr) &&
  0 <= queue.net_tail - queue.net_head <= 256 &&
  (forall i : Int :: queue.net_tail <= i && i < queue.net_head ==>
    acc(slotq(queue.net_descr, i).ndescr_addr) && acc(slotq(queue.net_descr, i).ndescr_len)) &&
  (capacity == RX_QUEUE_CAPACITY || capacity == TX_QUEUE_CAPACITY) &&
  valid_net_tail(queue.net_tail) && valid_net_head(queue.net_head) &&
  (forall i: Int, j: Int :: queue.net_tail <= i && i < queue.net_head &&
    queue.net_tail <= j && j < queue.net_head &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j)
}

predicate valid_net_queue_consume(heap: IArray, virt: Ref, queue: Ref, capacity: Int)
{
  acc(queue.net_tail, 3/4) && acc(queue.net_head) && acc(queue.net_signal) &&
  acc(queue.net_descr) &&
  0 <= queue.net_tail - queue.net_head <= 256 &&
  (forall i : Int :: queue.net_head <= i && i < queue.net_tail ==>
    acc(slotq(queue.net_descr, i).ndescr_addr, 3/4) && acc(slotq(queue.net_descr, i).ndescr_len, 3/4)) &&
  (capacity == RX_QUEUE_CAPACITY || capacity == TX_QUEUE_CAPACITY) &&
  valid_net_tail(queue.net_tail) && valid_net_head(queue.net_head) &&
  (forall i: Int, j: Int :: queue.net_head <= i && i < queue.net_tail &&
    queue.net_head <= j && j < queue.net_tail &&
    slotq(queue.net_descr, i).ndescr_addr == slotq(queue.net_descr, j).ndescr_addr ==>
      i == j)
}

define valid_net_tail(x)
  bounded16(x)

define valid_net_head(x)
  bounded16(x)

define valid_net_addr(x)
  bounded32(x)

define valid_net_len(x)
  bounded16(x)

/////////////////////// Helper macros
define queue_field(queue_name, capacity, field_)
  unfolding valid_net_queue(heap, gv, gv.queue_name, capacity) in gv.queue_name.field_

define queue_field_unchanged(queue_name, capacity, field_)
  unchanged(queue_field(queue_name, capacity, field_))

define queue_unchanged(queue_name, capacity)
 queue_field_unchanged(queue_name, capacity, net_tail) &&
  queue_field_unchanged(queue_name, capacity, net_head) &&
  queue_field_unchanged(queue_name, capacity, net_signal)

/////////////////////// RX_FREE queue
method store_rx_free_head(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 1/4)
  requires address == RX_FREE_BASE + HEAD_OFFSET
  requires valid_net_head(value)
  requires value == (gv.rx_free.net_head + 1) % (MAX_INT16 + 1)
  requires gv.rx_free.net_head != gv.rx_free.net_tail
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_RX_FREE
  requires acc(gv.wm_qhead, 1/2) && gv.wm_qhead == gv.rx_free.net_head + 1
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head) && acc(gv.rx_free.net_tail, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_RX_FREE_2 &&
    acc(gv.wm_qhead, 1/2)

method load_rx_free_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_tail, 1/4) && acc(gv.rx_free.net_head, 1/4)
  requires address == RX_FREE_BASE + TAIL_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_tail, 1/4) && acc(gv.rx_free.net_head, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_QM_RX_FREE
  ensures acc(gv.wm_qtail) && retval == gv.wm_qtail % (MAX_INT16 + 1)
  ensures valid_net_tail(retval)
  ensures 0 <= gv.wm_qtail - gv.rx_free.net_head <= 256
  ensures gv.wm_qtail >= gv.rx_free.net_tail

method load_rx_free_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4)
  requires address == RX_FREE_BASE + HEAD_OFFSET
  requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_LOAD_QM_RX_FREE)
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4)
  ensures retval == gv.rx_free.net_head % (MAX_INT16 + 1)
  ensures valid_net_head(retval)
  ensures acc(gv.wm_state) && gv.wm_state == old(gv.wm_state)

method store_rx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires address == RX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && value == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_FREE_CONSUMER_SIGNALLED

// WM: No WM handling needed, since we do not gain or lose information here.
method load_rx_free_addr(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - RX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= RX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < RX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr) &&
    valid_net_addr(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  ensures acc(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures retval == slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr
  ensures slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr == old(slot(gv.rx_free.net_descr, (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures valid_net_addr(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_NONE
{
  var index: Int := (address - NDESC_ADDR_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  retval := slot(gv.rx_free.net_descr, index).ndescr_addr
  refute false
}

method load_rx_free_len(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - RX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= RX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < RX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len) &&
    valid_net_len(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_descr, 1/4)
  ensures acc(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures retval == slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len
  ensures slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len == old(slot(gv.rx_free.net_descr, (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures valid_net_len(retval)
{
  var index: Int := (address - NDESC_LEN_OFF - RX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  retval := slot(gv.rx_free.net_descr, index).ndescr_len
  refute false
}

/////////////////////// RX_ACTIVE queue
method load_rx_active_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.wm_state, 1/2) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_RX_ACTIVE)
  requires gv.wm_state == WM_NONE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  requires gv.wm_state == WM_STORE_QM_RX_ACTIVE ==> acc(gv.wm_qtail, 1/4)
  requires address == RX_ACTIVE_BASE + TAIL_OFFSET
  ensures acc(gv.wm_state, 1/2)
  ensures gv.wm_state == WM_NONE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  ensures gv.wm_state == WM_STORE_QM_RX_ACTIVE ==> acc(gv.wm_qtail, 1/4)
  ensures gv.wm_state == WM_NONE ==> retval == gv.rx_active.net_tail % (MAX_INT16 + 1)
  ensures gv.wm_state == WM_STORE_QM_RX_ACTIVE ==> retval == gv.wm_qtail % (MAX_INT16 + 1)
  ensures valid_net_tail(retval)

/*function slotq_add_capacity_lemma(queue: Ref, i: Int): Bool
  requires acc(queue.net_descr, wildcard)
  ensures (i + QUEUE_CAPACITY) % 256 == i % 256
  ensures result == true
{
  slotq(queue.net_descr, i) == slotq(queue.net_descr, i + QUEUE_CAPACITY)
}*/

method load_rx_active_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_head, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  requires address == RX_ACTIVE_BASE + HEAD_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_head, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  ensures valid_net_head(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_QM_RX_ACTIVE
  ensures acc(gv.wm_qhead) && retval == gv.wm_qhead % (MAX_INT16 + 1)
  ensures gv.wm_qhead >= gv.rx_active.net_head
  ensures 0 <= gv.rx_active.net_tail - gv.wm_qhead <= 256

method store_rx_active_tail(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_head, 1/4) && acc(gv.wm_store_tail_count, 1/2)
  requires address == RX_ACTIVE_BASE + TAIL_OFFSET
  requires valid_net_tail(value)
  requires value == (gv.rx_active.net_tail + gv.wm_store_tail_count) % (MAX_INT16 + 1)
  requires (gv.rx_active.net_tail + gv.wm_store_tail_count - 1) - gv.rx_active.net_head != QUEUE_CAPACITY
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_RX_ACTIVE
  requires acc(gv.wm_qtail) && gv.wm_qtail == gv.rx_active.net_tail + gv.wm_store_tail_count - 1
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4) && acc(gv.rx_active.net_head, 1/4) && acc(gv.wm_store_tail_count, 1/2)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_RX_ACTIVE && acc(gv.wm_qtail) && gv.wm_qtail == gv.rx_active.net_tail + gv.wm_store_tail_count

method store_rx_active_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires address == RX_ACTIVE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && value == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_RX_ACTIVE_CONSUMER_SIGNALLED

method load_rx_active_consumer_signalled(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires address == RX_ACTIVE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && retval == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_RX_ACTIVE_CONSUMER_SIGNALLED

method store_rx_active_addr(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - RX_ACTIVE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= RX_ACTIVE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < RX_ACTIVE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires valid_net_addr(value)
  requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_RX_ACTIVE)
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_descr, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_ADDR_RX_ACTIVE && acc(gv.wm_qaddr) && gv.wm_qaddr == value &&
    acc(gv.wm_qref) && gv.wm_qref == slot(gv.rx_active.net_descr, (address - NDESC_ADDR_OFF - RX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN)
  ensures acc(gv.wm_state_old) && gv.wm_state_old == old(gv.wm_state)

method store_rx_active_len(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - RX_ACTIVE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= RX_ACTIVE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < RX_ACTIVE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires valid_net_len(value)
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_ADDR_RX_ACTIVE &&
    acc(gv.wm_qref, 1/2) && gv.wm_qref == slot(gv.rx_active.net_descr, (address - NDESC_LEN_OFF - RX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN)
  ensures acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_descr, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_DATA_RX_ACTIVE && acc(gv.wm_qref, 1/2) && acc(gv.wm_qlen) && gv.wm_qlen == value

/////////////////////// TX_ACTIVE queue
method f_store_queue_head_ghost(heap: IArray, gv: Ref, queue_ptr: Int)
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  requires queue_ptr == TX_ACTIVE_BASE ==> acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head, 1/4)
  requires queue_ptr == RX_FREE_BASE ==> acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4)
  ensures acc(gv.wm_state) && acc(gv.wm_qhead)
  ensures queue_ptr == TX_ACTIVE_BASE ==> gv.wm_state == WM_STORE_QM_TX_ACTIVE &&
    acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head, 1/4) && gv.wm_qhead == gv.tx_active.net_head + 1
  ensures queue_ptr == RX_FREE_BASE ==> gv.wm_state == WM_STORE_QM_RX_FREE &&
    acc(gv.rx_free, 1/4) && acc(gv.rx_free.net_head, 1/4) && gv.wm_qhead == gv.rx_free.net_head + 1

method store_tx_active_head(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 1/4)
  requires address == TX_ACTIVE_BASE + HEAD_OFFSET
  requires valid_net_head(value)
  requires value == (gv.tx_active.net_head + 1) % (MAX_INT16 + 1)
  requires gv.tx_active.net_head != gv.tx_active.net_tail
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_TX_ACTIVE
  requires acc(gv.wm_qhead, 1/2) && gv.wm_qhead == gv.tx_active.net_head + 1
  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head) && acc(gv.tx_active.net_tail, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_TX_ACTIVE_2 && acc(gv.wm_qhead, 1/2)

method load_tx_active_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_tail, 1/4) && acc(gv.tx_active.net_descr, 1/4) &&
    acc(gv.tx_active.net_head, 1/4)
  requires address == TX_ACTIVE_BASE + TAIL_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_tail, 1/4) && acc(gv.tx_active.net_descr, 1/4) &&
    acc(gv.tx_active.net_head, 1/4) && 0 <= gv.tx_active.net_tail - gv.tx_active.net_head <= 256
  ensures valid_net_tail(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_QM_TX_ACTIVE
  ensures acc(gv.wm_qtail) && retval == gv.wm_qtail % (MAX_INT16 + 1)
  ensures 0 <= gv.wm_qtail - gv.tx_active.net_head <= 256
  ensures gv.wm_qtail >= gv.tx_active.net_tail

method load_tx_active_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head, 1/4)
  requires address == TX_ACTIVE_BASE + HEAD_OFFSET
  requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_LOAD_QM_TX_ACTIVE)
  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_head, 1/4)
  ensures retval == gv.tx_active.net_head % (MAX_INT16 + 1)
  ensures valid_net_head(retval)
  ensures acc(gv.wm_state) && gv.wm_state == old(gv.wm_state)

method store_tx_active_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires address == TX_ACTIVE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && value == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_ACTIVE_CONSUMER_SIGNALLED

// No WM handling required: assumes exclusive control already.
method load_tx_active_addr(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - TX_ACTIVE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= TX_ACTIVE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < TX_ACTIVE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr) &&
    valid_net_addr(slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_descr, 1/4)
  ensures acc(slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures retval == slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr
  ensures slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr == old(slot(gv.tx_active.net_descr, (address - NDESC_ADDR_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures valid_net_addr(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_NONE

method load_tx_active_len(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - TX_ACTIVE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= TX_ACTIVE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < TX_ACTIVE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len) &&
    valid_net_len(slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_descr, 1/4)
  ensures acc(slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures retval == slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len
  ensures slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len == old(slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures valid_net_len(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_NONE

/////////////////////// TX_FREE queue
method f_store_queue_tail_ghost(heap: IArray, gv: Ref, queue_ptr: Int)
  requires acc(gv.wm_state_old, 1/2) && acc(gv.wm_state)
  requires queue_ptr == RX_ACTIVE_BASE ==> gv.wm_state == WM_STORE_DATA_RX_ACTIVE && (gv.wm_state_old == WM_NONE || gv.wm_state_old == WM_STORE_QM_RX_ACTIVE)
  requires queue_ptr == TX_FREE_BASE ==> gv.wm_state == WM_STORE_DATA_TX_FREE && (gv.wm_state_old == WM_NONE || gv.wm_state_old == WM_STORE_QM_TX_FREE)
  requires queue_ptr == RX_ACTIVE_BASE ==> acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  requires queue_ptr == TX_FREE_BASE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  requires gv.wm_state_old != WM_NONE ==> acc(gv.wm_store_tail_count)
  ensures acc(gv.wm_state_old, 1/2) && acc(gv.wm_state) && acc(gv.wm_store_tail_count)
  ensures gv.wm_state_old == old(gv.wm_state_old)
  ensures gv.wm_store_tail_count == (gv.wm_state_old == WM_NONE ? 1 : old(gv.wm_store_tail_count) + 1)
  ensures queue_ptr == RX_ACTIVE_BASE ==> gv.wm_state == WM_STORE_QM_W_DATA_RX_ACTIVE &&
    acc(gv.rx_active, 1/4) && acc(gv.rx_active.net_tail, 1/4)
  ensures queue_ptr == TX_FREE_BASE ==> gv.wm_state == WM_STORE_QM_W_DATA_TX_FREE &&
    acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  ensures queue_ptr == RX_ACTIVE_BASE && old(gv.wm_state_old) == WM_NONE ==> acc(gv.wm_qtail) && gv.wm_qtail == gv.rx_active.net_tail
  ensures queue_ptr == TX_FREE_BASE && old(gv.wm_state_old) == WM_NONE ==> acc(gv.wm_qtail) && gv.wm_qtail == gv.tx_free.net_tail

method load_tx_free_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.wm_state, 1/2) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_TX_FREE)
  requires gv.wm_state == WM_NONE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  requires gv.wm_state == WM_STORE_QM_TX_FREE ==> acc(gv.wm_qtail, 1/4)
  requires address == TX_FREE_BASE + TAIL_OFFSET
  ensures acc(gv.wm_state, 1/2)
  ensures gv.wm_state == WM_NONE ==> acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  ensures gv.wm_state == WM_STORE_QM_TX_FREE ==> acc(gv.wm_qtail, 1/4)
  ensures gv.wm_state == WM_NONE ==> retval == gv.tx_free.net_tail % (MAX_INT16 + 1)
  ensures gv.wm_state == WM_STORE_QM_TX_FREE ==> retval == gv.wm_qtail % (MAX_INT16 + 1)
  ensures valid_net_tail(retval)

method load_tx_free_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  requires address == TX_FREE_BASE + HEAD_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  ensures retval == gv.tx_free.net_head % (MAX_INT16 + 1)
  ensures valid_net_head(retval)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_QM_TX_FREE
  ensures acc(gv.wm_qhead) && retval == gv.wm_qhead % (MAX_INT16 + 1)
  ensures gv.wm_qhead >= gv.tx_free.net_head
  ensures 0 <= gv.tx_free.net_tail - gv.wm_qhead <= 256

method store_tx_free_tail(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_head, 1/4) && acc(gv.wm_store_tail_count, 1/2)
  requires address == TX_FREE_BASE + TAIL_OFFSET
  requires valid_net_tail(value)
  requires value == (gv.tx_free.net_tail + gv.wm_store_tail_count) % (MAX_INT16 + 1)
  requires (gv.tx_free.net_tail + gv.wm_store_tail_count - 1) - gv.tx_free.net_head != QUEUE_CAPACITY
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_TX_FREE
  requires acc(gv.wm_qtail) && gv.wm_qtail == gv.tx_free.net_tail + gv.wm_store_tail_count - 1
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4) && acc(gv.tx_free.net_head, 1/4) && acc(gv.wm_store_tail_count, 1/2)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_QM_TX_FREE && acc(gv.wm_qtail) && gv.wm_qtail == gv.tx_free.net_tail + gv.wm_store_tail_count

method store_tx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires address == TX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && value == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_TX_FREE_CONSUMER_SIGNALLED

method load_tx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires address == TX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires acc(gv.wm_state) && gv.wm_state == WM_NONE
  ensures acc(gv.wm_consumer_signalled) && retval == (gv.wm_consumer_signalled ? 1 : 0)
  ensures acc(gv.wm_state) && gv.wm_state == WM_LOAD_TX_FREE_CONSUMER_SIGNALLED

method store_tx_free_addr(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - TX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= TX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < TX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires valid_net_addr(value)
  requires acc(gv.wm_state) && (gv.wm_state == WM_NONE || gv.wm_state == WM_STORE_QM_TX_FREE)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_ADDR_TX_FREE && acc(gv.wm_qaddr) && gv.wm_qaddr == value &&
    acc(gv.wm_qref) && gv.wm_qref == slot(gv.tx_free.net_descr, (address - NDESC_ADDR_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN)
  ensures acc(gv.wm_state_old) && gv.wm_state_old == old(gv.wm_state)

method store_tx_free_len(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - TX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= TX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < TX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires valid_net_len(value)
  requires acc(gv.wm_state) && gv.wm_state == WM_STORE_ADDR_TX_FREE &&
    acc(gv.wm_qref, 1/2) && gv.wm_qref == slot(gv.tx_free.net_descr, (address - NDESC_LEN_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  ensures acc(gv.wm_state) && gv.wm_state == WM_STORE_DATA_TX_FREE && acc(gv.wm_qref, 1/2) &&
    acc(gv.wm_qlen) && gv.wm_qlen == value

