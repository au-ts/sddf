  ensures acc(gv.tx_active, 1/4) && acc(gv.tx_active.net_descr, 1/4)
  ensures acc(slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len, 1/4)
  ensures retval == slot(gv.tx_active.net_descr, (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len
  ensures valid_net_len(retval)
{
  var index: Int := (address - NDESC_LEN_OFF - TX_ACTIVE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  retval := slot(gv.tx_active.net_descr, index).ndescr_len
  refute false
}

/////////////////////// TX_FREE queue
method load_tx_free_tail(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  requires valid_net_tail(gv.tx_free.net_tail)
  requires address == TX_FREE_BASE + TAIL_OFFSET
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail, 1/4)
  ensures retval == gv.tx_free.net_tail
  ensures valid_net_tail(retval)
{
  retval := gv.tx_free.net_tail
  refute false
}

method load_tx_free_head(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head, 1/4)
  requires valid_net_tail(gv.tx_free.net_head)
  requires address == TX_FREE_BASE + HEAD_OFFSET
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head, 1/4)
  ensures retval == gv.tx_free.net_head
  ensures valid_net_head(retval)
{
  retval := gv.tx_free.net_head
  refute false
}

method store_tx_free_head(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head)
  requires address == TX_FREE_BASE + HEAD_OFFSET
  requires valid_net_head(value)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_head)
  ensures gv.tx_free.net_head == value
{
  gv.tx_free.net_head := value
  refute false
}

method store_tx_free_tail(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail)
  requires address == TX_FREE_BASE + TAIL_OFFSET
  requires valid_net_tail(value)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_tail)
  ensures gv.tx_free.net_tail == value
{
  gv.tx_free.net_tail := value
  refute false
}

method store_tx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal)
  requires address == TX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  requires value == 0 || value == 1
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal)
  ensures value == (gv.tx_free.net_signal ? 1 : 0)
{
  gv.tx_free.net_signal := (value == 1)
  refute false
}

method load_tx_free_consumer_signalled(heap: IArray, gv: Ref, address: Int)
  returns (retval: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal, 1/4)
  requires address == TX_FREE_BASE + CONSUMER_SIGNALLED_OFFSET
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_signal, 1/4)
  ensures retval == (gv.tx_free.net_signal ? 1 : 0)
{
  retval := (gv.tx_free.net_signal ? 1 : 0)
  refute false
}

method store_tx_free_addr(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  requires (address - NDESC_ADDR_OFF - BUFFERS_OFFSET - TX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_ADDR_OFF) >= TX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_ADDR_OFF) < TX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.tx_free.net_descr, (address - NDESC_ADDR_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  requires valid_net_addr(value)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  ensures acc(slot(gv.tx_free.net_descr, (address - NDESC_ADDR_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr)
  ensures slot(gv.tx_free.net_descr, (address - NDESC_ADDR_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_addr == value
{
  var index: Int := (address - NDESC_ADDR_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  slot(gv.tx_free.net_descr, index).ndescr_addr := value
  refute false
}

method store_tx_free_len(heap: IArray, gv: Ref, address: Int, value: Int)
  requires acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  requires (address - NDESC_LEN_OFF - BUFFERS_OFFSET - TX_FREE_BASE) % NDESC_LEN == 0
  requires (address - NDESC_LEN_OFF) >= TX_FREE_BASE + BUFFERS_OFFSET && (address - NDESC_LEN_OFF) < TX_FREE_BASE + BUFFERS_OFFSET + NDESC_LEN * QUEUE_CAPACITY
  requires acc(slot(gv.tx_free.net_descr, (address - NDESC_LEN_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  requires valid_net_len(value)
  ensures acc(gv.tx_free, 1/4) && acc(gv.tx_free.net_descr, 1/4)
  ensures acc(slot(gv.tx_free.net_descr, (address - NDESC_LEN_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len)
  ensures slot(gv.tx_free.net_descr, (address - NDESC_LEN_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN).ndescr_len == value
{
  var index: Int := (address - NDESC_LEN_OFF - TX_FREE_BASE - BUFFERS_OFFSET) / NDESC_LEN
  slot(gv.tx_free.net_descr, index).ndescr_len := value
  refute false
}

