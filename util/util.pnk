/* Helper constants */
#define MAX_INT64        18446744073709551615
#define MAX_INT32        4294967295
#define MAX_INT16        65535
#define MAX_INT8         255

#define microkit_notify(channel) \
  @microkit_notify(0,channel,0,0)
/@ method ffimicrokit_notify(c: Int, cl: Int, a: Int, al: Int) @/

#define microkit_deferred_irq_ack(channel) \
  @microkit_deferred_irq_ack(0,channel,0,0)
/@ method ffimicrokit_deferred_irq_ack(c: Int, cl: Int, a: Int, al: Int) @/

#define sddf_irq_ack(channel) \
  @sddf_irq_ack(0,channel,0,0);
/@ method ffisddf_irq_ack(c: Int, cl: Int, a: Int, al: Int) @/

#define sddf_notify(channel) \
  @sddf_notify(0,channel,0,0);
/@ method ffisddf_notify(c: Int, cl: Int, a: Int, al: Int) @/

#define sddf_deferred_notify(channel) \
  @sddf_deferred_notify(0,channel,0,0);
/@ method ffisddf_deferred_notify(c: Int, cl: Int, a: Int, al: Int) @/

#define cache_clean(start, end) \
  @cache_clean(start,0,end,0);
/@ method fficache_clean(c: Int, cl: Int, a: Int, al: Int) @/

#define cache_clean_and_invalidate(start, end) \
  @cache_clean_and_invalidate(start,0,end,0);
/@ method fficache_clean_and_invalidate(c: Int, cl: Int, a: Int, al: Int) @/

/* Some helper macros */
#define pnk_mem_ptr(idx)  (@base + (idx) * @biw)
#define pnk_mem(idx)      (lds 1 pnk_mem_ptr(idx))

#define get_idx_array(addr, idx)    lds 1 (addr + idx * @biw)

#define THREAD_MEMORY_RELEASE() \
  @THREAD_MEMORY_RELEASE(0,0,0,0);
///@ method ffiTHREAD_MEMORY_RELEASE(c: Int, cl: Int, a: Int, al: Int) @/

#define THREAD_MEMORY_ACQUIRE() \
  @THREAD_MEMORY_ACQUIRE(0,0,0,0);
///@ method ffiTHREAD_MEMORY_ACQUIRE(c: Int, cl: Int, a: Int, al: Int) @/

#define seL4_SetMR(reg, value) \
  @seL4_SetMR(0,reg,0,value);
/@ method ffiseL4_SetMR(c: Int, cl: Int, a: Int, al: Int) @/

#define debug_print(c, cl, a, al) \
  @debug_print(c,cl,a,al)
/@ method ffidebug_print(c: Int, cl: Int, a: Int, al: Int) @/

fun wrap_int8(1 a)
{
    /@ requires a > 0 @/
    /@ ensures retval == (a % (MAX_INT8 + 1)) @/
    /@ ensures retval <= MAX_INT8 @/
    var mod = a & MAX_INT8;
    return mod;
}

fun wrap_int16(1 a)
{
    /@ requires a > 0 @/
    /@ ensures retval == (a % (MAX_INT16 + 1)) @/
    /@ ensures retval <= MAX_INT16 @/
    var mod = a & MAX_INT16;
    return mod;
}

fun wrap_int32(1 a)
{
    /@ requires a > 0 @/
    /@ ensures retval == (a % (MAX_INT32 + 1)) @/
    /@ ensures retval <= MAX_INT32 @/
    var mod = a & MAX_INT32;
    return mod;
}
